@page
@model ParkingManagement.FE.Pages.Customer.Booking.IndexModel

@section Styles {
    <link rel="stylesheet" href="/css/customer/bookings.css" asp-append-version="true" />
}

<div class="booking-page">
    <div class="booking-header">
        <div>
            <h1>Đơn đặt chỗ</h1>
            <p>Lịch sử đặt chỗ tại bãi gửi xe</p>
        </div>

        <a asp-page="/Customer/Booking/Create" class="btn-booking-primary">
            + Đặt chỗ mới
        </a>
    </div>

    <div class="booking-filter">
        <button class="active">Tất cả</button>
        <button>Sắp tới</button>
        <button>Đang gửi</button>
        <button>Đã hoàn thành</button>
        <button>Đã hủy</button>
    </div>

    <div class="booking-list">
        @foreach (var item in Model.Bookings)
        {
            <div class="booking-card">
                <div>
                    <h3>@item.Code</h3>
                    <span class="booking-status">@item.Status</span>
                    <p>Đặt lúc: @item.StartTime.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <div>
                    <strong>@item.PlateNumber</strong>
                    <p>@item.VehicleType</p>
                </div>

                <div>
                    <strong>@item.ParkingSlot</strong>
                    <p>Vị trí đỗ</p>
                </div>

                <div>
                    <p>@item.StartTime.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>→ @item.EndTime.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <div>
                    <strong>@item.TotalPrice.ToString("N0") đ</strong>
                    <p>Vé lượt</p>
                </div>

                <div class="booking-actions">
                    <button type="button" class="btn-detail">Xem chi tiết</button>

                    @if (item.Status != "Đã hủy" && item.Status != "Đã hoàn thành")
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@item.Id">
                            <button type="submit" class="btn-cancel">Hủy</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
