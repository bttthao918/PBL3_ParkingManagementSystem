@{
    Layout = "/Pages/Shared/_DashboardLayout.cshtml";
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
}

@section Styles {
    @RenderSection("Styles", required: false)
}

@section Sidebar {
    <a asp-page="/Customer/Dashboard"
           class="@(currentPath.Equals("/Customer/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-house"></i> Tổng quan
    </a>

    <p>QUẢN LÝ</p>

    <a asp-page="/Customer/Booking/Index"
           class="@(currentPath.Contains("/Customer/Booking/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-calendar-check"></i> Đơn đặt chỗ
    </a>

    <a asp-page="/Customer/MyTickets"
           class="@(currentPath.Contains("/Customer/MyTickets", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-ticket"></i> Vé xe
    </a>

    <a asp-page="/Customer/MonthlyPass"
           class="@(currentPath.Contains("/Customer/MonthlyPass", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-credit-card"></i> Vé tháng
    </a>

    <p>TÀI KHOẢN</p>

    <a asp-page="/Account/Profile"
           class="@(currentPath.Contains("/Account/Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-user-gear"></i> Thông tin tài khoản
    </a>

    <a asp-page="/Account/ChangePassword"
           class="@(currentPath.Contains("/Account/ChangePassword", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-lock"></i> Đổi mật khẩu
    </a>
}

@RenderBody()

@section Scripts {
    @RenderSection("Scripts", required: false)
}