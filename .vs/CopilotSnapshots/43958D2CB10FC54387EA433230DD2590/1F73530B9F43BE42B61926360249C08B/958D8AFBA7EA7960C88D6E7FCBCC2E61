@model ParkingManagement.FE.Pages.Shared.Statistics.RevenueStatisticsModel

@section Styles {
    <link rel="stylesheet" href="/css/shared/statistics.css" asp-append-version="true" />
}

<div class="dashboard-content statistics-page">

    <partial name="_StatisticsHeader.cshtml" model="Model.Header" />

    <div class="stat-kpi-grid">
        @foreach (var kpi in Model.Kpis)
        {
            <partial name="_StatisticsKpiCard.cshtml" model="kpi" />
        }
    </div>

    <div class="stat-main-grid">
        <div class="card stat-chart-card large">
            <div class="stat-card-title">
                <h3>Doanh thu theo ngày <i class="fa-regular fa-circle-question"></i></h3>
                <select><option>Doanh thu (đ)</option></select>
            </div>
            <canvas id="mainLineChart"></canvas>
        </div>

        <div class="card stat-chart-card">
            <h3>Cơ cấu doanh thu theo phương thức thanh toán</h3>

            <div class="stat-donut-layout">
                <canvas id="mainDonutChart"></canvas>

                <div class="stat-donut-legend">
                    <div><span class="dot blue"></span><strong>Tiền mặt</strong><p>85,250,000 đ</p><small>68.4%</small></div>
                    <div><span class="dot green"></span><strong>Chuyển khoản</strong><p>39,250,000 đ</p><small>31.6%</small></div>
                </div>
            </div>
        </div>
    </div>

    <div class="stat-bottom-grid">
        <div class="card stat-chart-card">
            <div class="stat-card-title">
                <h3>Doanh thu theo khu vực</h3>
                <select><option>Doanh thu (đ)</option></select>
            </div>
            <canvas id="mainBarChart"></canvas>
        </div>

        <div class="card stat-list-card">
            <h3>Top 5 nhân viên doanh thu cao nhất</h3>
            <div class="stat-rank-list">
                <div><b>1</b><span>Nguyễn Văn An</span><strong>5,450,000 đ</strong><em>+12.5%</em></div>
                <div><b>2</b><span>Trần Thị Bình</span><strong>4,820,000 đ</strong><em>+8.3%</em></div>
                <div><b>3</b><span>Lê Văn Cường</span><strong>4,250,000 đ</strong><em>+6.2%</em></div>
                <div><b>4</b><span>Phạm Thị Dung</span><strong>3,980,000 đ</strong><em>+5.7%</em></div>
                <div><b>5</b><span>Hoàng Văn Em</span><strong>3,650,000 đ</strong><em>+4.3%</em></div>
            </div>
            <button class="stat-view-btn">Xem tất cả nhân viên <i class="fa-solid fa-chevron-right"></i></button>
        </div>

        <div class="card stat-side-card">
            <h3>Doanh thu theo loại xe</h3>

            <div class="stat-progress-row">
                <div><span>Xe máy</span><strong>58,450,000 đ</strong></div>
                <div class="stat-progress"><span class="blue" style="width: 76%"></span></div>
            </div>

            <div class="stat-progress-row">
                <div><span>Ô tô nhỏ</span><strong>42,600,000 đ</strong></div>
                <div class="stat-progress"><span class="green" style="width: 58%"></span></div>
            </div>

            <div class="stat-progress-row">
                <div><span>Ô tô lớn</span><strong>23,450,000 đ</strong></div>
                <div class="stat-progress"><span class="purple" style="width: 38%"></span></div>
            </div>

            <button class="stat-download-btn">
                <i class="fa-solid fa-download"></i> Tải báo cáo
            </button>
        </div>
    </div>

    <div class="card stat-table-card">
        <div class="stat-card-title">
            <h3>Chi tiết doanh thu theo ngày</h3>
            <button class="stat-view-table-btn">Xem tất cả</button>
        </div>

        <partial name="_StatisticsTable.cshtml" model="Model.Table" />
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        window.statisticsConfig = {
            type: "revenue",
            line: {
                labels: ["01/05", "02/05", "03/05", "04/05", "05/05", "06/05", "07/05", "08/05", "09/05", "10/05"],
                current: [2.1, 2.0, 4.0, 2.7, 3.6, 6.1, 4.2, 4.1, 2.8, 4.1],
                previous: [1.0, 0.7, 3.3, 1.2, 2.9, 3.8, 2.7, 2.9, 1.1, 3.2]
            },
            donut: {
                labels: ["Tiền mặt", "Chuyển khoản"],
                data: [68.4, 31.6]
            },
            bar: {
                labels: ["Khu A", "Khu B", "Khu C"],
                data: [32.45, 52.8, 39.25]
            }
        };
    </script>

    <script src="/js/admin_statistics.js" asp-append-version="true"></script>
}