@page
@model ParkingManagement.FE.Pages.Admin.CustomerStatisticsModel
@{
    ViewData["Title"] = "Thống kê khách hàng";
    ViewData["UserName"] = "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

@section Styles {
    <link rel="stylesheet" href="/css/shared/statistics.css" asp-append-version="true" />
}

<div class="dashboard-content statistics-page">

    <partial name="/Pages/Shared/Statistics/_StatisticsHeader.cshtml" model="Model.Header" />

        <div class="stat-kpi-grid">
            @foreach (var kpi in Model.Kpis)
            {
                <partial name="/Pages/Shared/Statistics/_StatisticsKpiCard.cshtml" model="kpi" />
            }
        </div>

    <div class="stat-main-grid">
        <div class="card stat-chart-card large">
            <div class="stat-card-title">
                <h3>Khách hàng mới theo ngày</h3>
                <select><option>Theo ngày</option></select>
            </div>
            <canvas id="mainLineChart"></canvas>
        </div>

        <div class="card stat-chart-card">
            <h3>Cơ cấu khách hàng theo nhóm</h3>

            <div class="stat-donut-layout">
                <canvas id="mainDonutChart"></canvas>

                <div class="stat-donut-legend">
                    <div><span class="dot blue"></span><strong>Khách vãng lai</strong><p>1,450</p><small>59.2%</small></div>
                    <div><span class="dot green"></span><strong>Khách thân thiết</strong><p>680</p><small>27.8%</small></div>
                    <div><span class="dot orange"></span><strong>Khách VIP</strong><p>320</p><small>13.0%</small></div>
                </div>
            </div>
        </div>
    </div>

    <div class="stat-bottom-grid">
        <div class="card stat-chart-card">
            <div class="stat-card-title">
                <h3>Phân bố khách hàng theo khu vực</h3>
                <select><option>Số lượng khách</option></select>
            </div>
            <canvas id="mainBarChart"></canvas>
        </div>

        <div class="card stat-list-card">
            <h3>Top 5 khách hàng thân thiết</h3>
            <div class="stat-rank-list">
                <div><b>1</b><span>Nguyễn Văn An</span><strong>156 lượt</strong><em>+12.5%</em></div>
                <div><b>2</b><span>Trần Thị Bình</span><strong>128 lượt</strong><em>+9.7%</em></div>
                <div><b>3</b><span>Lê Văn Cường</span><strong>115 lượt</strong><em>+8.3%</em></div>
                <div><b>4</b><span>Phạm Thị Dung</span><strong>102 lượt</strong><em>+7.1%</em></div>
                <div><b>5</b><span>Hoàng Văn Em</span><strong>98 lượt</strong><em>+6.2%</em></div>
            </div>
            <button class="stat-view-btn">Xem tất cả <i class="fa-solid fa-chevron-right"></i></button>
        </div>

        <div class="card stat-side-card">
            <h3>Mức độ quay lại của khách hàng</h3>

            <div class="stat-progress-row">
                <div><span>1 - 5 lượt</span><strong>42.6%</strong></div>
                <div class="stat-progress"><span class="blue" style="width: 86%"></span></div>
            </div>

            <div class="stat-progress-row">
                <div><span>6 - 10 lượt</span><strong>28.9%</strong></div>
                <div class="stat-progress"><span class="green" style="width: 62%"></span></div>
            </div>

            <div class="stat-progress-row">
                <div><span>11 - 20 lượt</span><strong>18.7%</strong></div>
                <div class="stat-progress"><span class="purple" style="width: 42%"></span></div>
            </div>

            <div class="stat-progress-row">
                <div><span>Trên 20 lượt</span><strong>9.8%</strong></div>
                <div class="stat-progress"><span class="orange" style="width: 24%"></span></div>
            </div>
        </div>
    </div>

    <div class="card stat-table-card">
        <div class="stat-card-title">
            <h3>Chi tiết khách hàng mới</h3>
            <button class="stat-view-table-btn">Xem tất cả</button>
        </div>

        <partial name="/Pages/Shared/Statistics/_StatisticsTable.cshtml" model="Model.Table" />
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        window.statisticsConfig = {
            type: "customer",
            line: {
                labels: ["01/05", "03/05", "04/05", "05/05", "06/05", "07/05", "08/05", "09/05", "10/05"],
                current: [22, 24, 37, 28, 52, 41, 38, 28, 45],
                previous: [10, 10, 24, 14, 34, 20, 24, 14, 26]
            },
            donut: {
                labels: ["Khách vãng lai", "Khách thân thiết", "Khách VIP"],
                data: [59.2, 27.8, 13.0]
            },
            bar: {
                labels: ["Khu A", "Khu B", "Khu C", "Ngoài bãi"],
                data: [850, 780, 420, 400]
            }
        };
    </script>

    <script src="/js/statistics.js" asp-append-version="true"></script>
}