@{
    var role = ViewData["Role"]?.ToString() ?? "";
    var userName = ViewData["UserName"]?.ToString() ?? "User";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@pageTitle - Parking Management</title>

    <link rel="stylesheet" href="/css/dashboard_layout.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="dashboard-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="logo">P</div>
                <div>
                    <h3>PARKING</h3>
                    <span>MANAGEMENT SYSTEM</span>
                </div>
            </div>

            <nav class="menu">
                @RenderSection("Sidebar", required: true)
            </nav>

            <div class="sidebar-support">
                <i class="fa-solid fa-headset"></i>
                <div>
                    <strong>Hỗ trợ</strong>
                    <span>1900 1234</span>
                </div>
            </div>

        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="topbar-left">
                    <i class="fa-solid fa-bars"></i>
                    <h1>@pageTitle</h1>
                </div>

                <div class="topbar-right">

                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input placeholder="Tìm kiếm nhanh..." />
                    </div>

                    <div class="notification" onclick="toggleNotification()">
                        <i class="fa-regular fa-bell"></i>
                        <span class="notification-badge">3</span>
                    </div>

                    <div class="notification-box" id="notificationBox">
                        <h4>Thông báo</h4>

                        <div class="notification-item danger">
                            <strong>Vé tháng sắp hết hạn</strong>
                            <p>Còn lại 1 ngày</p>
                        </div>

                        <div class="notification-item">
                            <strong>Cập nhật hệ thống</strong>
                            <p>Dữ liệu đã được đồng bộ</p>
                        </div>
                    </div>

                    <div class="user-profile">
                        <div class="avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <strong>@userName</strong>
                            <span>@role</span>
                        </div>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>

                </div>

            </header>

            <!-- CONTENT RIÊNG CỦA TỪNG ROLE -->
            <section class="dashboard-content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script>
            function toggleNotification() {
                document.getElementById("notificationBox").classList.toggle("show");
            }
    </script>

</body>
</html>