@page
@model ParkingManagement.FE.Pages.Admin.DashboardModel
@{
    Layout = "/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Tổng quan Admin";
    ViewData["UserName"] = "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

@section Sidebar {
    <a asp-page="/Admin/Dashboard">
        <i class="fa-solid fa-house"></i> Tổng quan
    </a>


    <p>QUẢN LÝ</p>
    <a asp-page="/Admin/TicketManagement">
        <i class="fa-solid fa-ticket"></i> Quản lý vé
    </a>

    <a href="#"><i class="fa-solid fa-users"></i> Quản lý nhân viên</a>
    <a href="#"><i class="fa-solid fa-square-parking"></i> Quản lý chỗ đỗ</a>

    <p>THỐNG KÊ</p>
    <a href="#"><i class="fa-solid fa-chart-line"></i> Doanh thu</a>
    <a href="#"><i class="fa-solid fa-user-group"></i> Khách hàng</a>
    <a href="#"><i class="fa-solid fa-chart-column"></i> Tổng hợp</a>

    <p>TÀI KHOẢN</p>
    <a href="#"><i class="fa-solid fa-user-gear"></i> Thông tin tài khoản</a>
    <a href="#"><i class="fa-solid fa-lock"></i> Đổi mật khẩu</a>
}

<div class="kpi-grid">

    <div class="card kpi-card">
        <div class="kpi-icon blue"><i class="fa-solid fa-dollar-sign"></i></div>
        <div>
            <p>Tổng doanh thu</p>
            <h2>125,430,000 đ</h2>
            <span class="up">↑ 12.5%</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon green"><i class="fa-solid fa-ticket"></i></div>
        <div>
            <p>Tổng vé</p>
            <h2>2,345</h2>
            <span class="up">↑ 8.2%</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon purple"><i class="fa-solid fa-circle-check"></i></div>
        <div>
            <p>Vé đã xử lý</p>
            <h2>2,134</h2>
            <span class="up">↑ 9.1%</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon orange"><i class="fa-solid fa-square-parking"></i></div>
        <div>
            <p>Tổng chỗ đỗ</p>
            <h2>855 / 1,250</h2>
            <div style="height:8px;background:#e5ecf5;border-radius:999px;margin:8px 0;width:160px;">
                <div style="height:100%;width:68.4%;background:#0d8bff;border-radius:999px;"></div>
            </div>
            <span>68.4% đang sử dụng</span>
        </div>
    </div>

</div>

<div class="card quick-actions">
    <h3>Thao tác nhanh</h3>

    <div class="action-grid">
        <a href="#"><i class="fa-solid fa-user-plus"></i> Thêm nhân viên</a>
        <a href="#"><i class="fa-solid fa-tags"></i> Giá vé</a>
        <a href="#"><i class="fa-solid fa-ticket"></i> Tìm vé</a>
        <a href="#"><i class="fa-solid fa-chart-line"></i> Báo cáo doanh thu</a>
        <a href="#"><i class="fa-solid fa-square-parking"></i> Báo cáo chỗ đỗ</a>
    </div>
</div>

<div class="card chart-card">
    <h3>Doanh thu toàn hệ thống</h3>

    <svg viewBox="0 0 1000 260" preserveAspectRatio="none">
        <polyline
            points="0,210 80,180 160,190 240,145 320,160 400,120 480,100 560,130 640,90 720,60 800,85 880,115 1000,80"
            fill="none"
            stroke="#0d8bff"
            stroke-width="4" />
    </svg>
</div>

<div class="bottom-grid">

    <div class="card">
        <h3>Nhân viên hoạt động</h3>

        <table>
            <tr>
                <th>Nhân viên</th>
                <th>Ca</th>
                <th>Vé xử lý</th>
                <th>Trạng thái</th>
            </tr>
            <tr>
                <td>Nguyễn Văn An<br><small>NV001</small></td>
                <td>Ca sáng</td>
                <td>128</td>
                <td><span class="status-success">Đang làm</span></td>
            </tr>
            <tr>
                <td>Trần Thị Bình<br><small>NV002</small></td>
                <td>Ca chiều</td>
                <td>98</td>
                <td><span class="status-success">Đang làm</span></td>
            </tr>
        </table>
    </div>

    <div class="card">
        <h3>Vé mới nhất</h3>

        <table>
            <tr>
                <th>Mã vé</th>
                <th>Khách hàng</th>
                <th>Trạng thái</th>
            </tr>
            <tr>
                <td>VE0002345</td>
                <td>Nguyễn Văn Nam</td>
                <td><span class="status-success">Đã xử lý</span></td>
            </tr>
            <tr>
                <td>VE0002344</td>
                <td>Trần Thị Hoa</td>
                <td><span class="status-warning">Đang xử lý</span></td>
            </tr>
        </table>
    </div>

    <div class="card">
        <h3>Trạng thái chỗ đỗ</h3>

        <p>Đang trống: <strong>395</strong></p>
        <p>Đang sử dụng: <strong>855</strong></p>
        <p>Bảo trì: <strong>15</strong></p>
    </div>

</div>