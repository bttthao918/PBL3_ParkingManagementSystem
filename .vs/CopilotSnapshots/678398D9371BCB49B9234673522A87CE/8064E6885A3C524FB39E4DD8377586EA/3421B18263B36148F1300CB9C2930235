using Microsoft.AspNetCore.Mvc;
using ParkingManagement.BLL.DTOs;
using ParkingManagement.BLL.Services.Interfaces;

namespace ParkingManagement.Web.Controllers
{
    /// <summary>
    /// AuthController – Chịu trách nhiệm toàn bộ nghiệp vụ XÁC THỰC.
    ///
    /// Luồng 3 lớp: FE (fetch/axios) → Controller → Service → Repository → DB
    /// Giao tiếp: JSON cho mọi request/response
    ///
    /// POST /api/Auth/register          – Đăng ký tài khoản khách hàng (gửi OTP email)
    /// POST /api/Auth/verify-otp        – Xác thực OTP để kích hoạt tài khoản
    /// POST /api/Auth/login             – Đăng nhập (Customer / Employee / Manager)
    /// POST /api/Auth/logout            – Đăng xuất (xóa Session)
    /// GET  /api/Auth/register-employee – Xác thực token mời nhân viên
    /// POST /api/Auth/register-employee – Hoàn tất đăng ký nhân viên qua invite
    /// </summary>
    [ApiController]
    [Route("api/Auth")]
    [Produces("application/json")]
    public class AuthController(
        IAuthService authService,
        IEmployeeInviteService inviteService,
        IEmailService emailService) : ControllerBase
    {
        // ═══════════════════════════════════════════════════════
        // CUSTOMER – Đăng ký + Xác thực OTP
        // Layer: AuthController → IAuthService → Repo → DB
        // ═══════════════════════════════════════════════════════

        /// <summary>
        /// Đăng ký tài khoản mới.
        /// Gửi mã OTP qua email để xác thực.
        /// </summary>
        [HttpPost("register")]
        public async Task<IActionResult> Register([FromBody] RegisterDto dto)
        {
            try
            {
                var errors = new List<string>();
                if (string.IsNullOrWhiteSpace(dto.Email))      errors.Add("Email không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.FullName))   errors.Add("Họ tên không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.Password))   errors.Add("Mật khẩu không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.PhoneNumber)) errors.Add("Số điện thoại không được để trống.");
                if (!string.IsNullOrWhiteSpace(dto.Email) && !dto.Email.Contains('@'))
                    errors.Add("Email không đúng định dạng.");
                if (!string.IsNullOrWhiteSpace(dto.Password) && dto.Password.Length < 6)
                    errors.Add("Mật khẩu phải có ít nhất 6 ký tự.");

                if (errors.Count > 0)
                    return BadRequest(new { success = false, errors });

                var result = await authService.RegisterAsync(dto);
                if (!result.Success)
                    return BadRequest(new { success = false, message = result.Message });

                // Gửi OTP qua email sau khi đăng ký thành công
                await emailService.SendOtpEmailAsync(dto.Email, dto.FullName, result.Otp);

                return Ok(new
                {
                    success = true,
                    message = "Đăng ký thành công! Vui lòng kiểm tra email để lấy mã OTP.",
                    email   = dto.Email
                });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { success = false, message = $"Lỗi đăng ký: {ex.Message}" });
            }
        }

        /// <summary>
        /// Xác thực OTP để kích hoạt tài khoản.
        /// </summary>
        [HttpPost("verify-otp")]
        public async Task<IActionResult> VerifyOtp([FromBody] VerifyOtpDto dto)
        {
            try
            {
                var errors = new List<string>();
                if (string.IsNullOrWhiteSpace(dto.Email)) errors.Add("Email không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.Otp))   errors.Add("Mã OTP không được để trống.");
                if (errors.Count > 0)
                    return BadRequest(new { success = false, errors });

                var result = await authService.VerifyOtpAsync(dto);
                if (!result.Success)
                    return BadRequest(new { success = false, message = result.Message });

                return Ok(new { success = true, message = "Xác thực thành công! Tài khoản đã được kích hoạt." });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { success = false, message = $"Lỗi xác thực OTP: {ex.Message}" });
            }
        }

        // ═══════════════════════════════════════════════════════
        // ĐĂNG NHẬP (Customer / Employee / Manager)
        // Layer: AuthController → IAuthService → Repo → DB
        // ═══════════════════════════════════════════════════════

        /// <summary>
        /// Đăng nhập — trả về Token, Role, FullName.
        /// FE dùng Role để điều hướng Dashboard tương ứng.
        /// </summary>
        [HttpPost("login")]
        public async Task<IActionResult> Login([FromBody] LoginDto dto)
        {
            try
            {
                var errors = new List<string>();
                if (string.IsNullOrWhiteSpace(dto.Email))    errors.Add("Email không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.Password)) errors.Add("Mật khẩu không được để trống.");
                if (errors.Count > 0)
                    return BadRequest(new { success = false, errors });

                var result = await authService.LoginAsync(dto);
                if (!result.Success)
                    return Unauthorized(new { success = false, message = result.Message });

                return Ok(new
                {
                    success   = true,
                    message   = "Đăng nhập thành công!",
                    role      = result.Role,
                    fullName  = result.FullName,
                    relatedId = result.RelatedId,
                    token     = result.Token
                });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { success = false, message = $"Lỗi đăng nhập: {ex.Message}" });
            }
        }

        // ═══════════════════════════════════════════════════════
        // ĐĂNG XUẤT
        // ═══════════════════════════════════════════════════════

        /// <summary>Đăng xuất.</summary>
        [HttpPost("logout")]
        public IActionResult Logout()
        {
            try
            {
                return Ok(new { success = true, message = "Đăng xuất thành công." });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { success = false, message = $"Lỗi đăng xuất: {ex.Message}" });
            }
        }

        // ═══════════════════════════════════════════════════════
        // NHÂN VIÊN – Kích hoạt tài khoản qua link invite
        // Layer: AuthController → IEmployeeInviteService + IAuthService → Repo → DB
        // ═══════════════════════════════════════════════════════

        /// <summary>
        /// Bước 1: Nhân viên mở link invite → kiểm tra token hợp lệ.
        /// FE gọi để lấy thông tin email và mã nhân viên trước khi nhập mật khẩu.
        /// </summary>
        [HttpGet("register-employee")]
        public async Task<IActionResult> GetEmployeeInvite([FromQuery] string token)
        {
            try
            {
                var errors = new List<string>();
                if (string.IsNullOrWhiteSpace(token))
                    errors.Add("Token mời không được để trống.");
                if (errors.Count > 0)
                    return BadRequest(new { success = false, errors });

                var result = await inviteService.GetInviteByTokenAsync(token);
                if (!result.Success || result.Data == null)
                    return BadRequest(new { success = false, message = result.Message ?? "Token không hợp lệ hoặc đã hết hạn." });

                return Ok(new
                {
                    success      = true,
                    email        = result.Data.Email,
                    employeeCode = result.Data.EmployeeCode,
                    inviteToken  = token
                });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { success = false, message = $"Lỗi kiểm tra token: {ex.Message}" });
            }
        }

        /// <summary>
        /// Bước 2: Nhân viên nhập thông tin cá nhân + mật khẩu để kích hoạt tài khoản.
        /// </summary>
        [HttpPost("register-employee")]
        public async Task<IActionResult> RegisterEmployee([FromBody] EmployeeRegisterDto dto)
        {
            try
            {
                var errors = new List<string>();
                if (string.IsNullOrWhiteSpace(dto.InviteToken))   errors.Add("Token mời không hợp lệ.");
                if (string.IsNullOrWhiteSpace(dto.FullName))      errors.Add("Họ tên không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.PhoneNumber))   errors.Add("Số điện thoại không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.Password))      errors.Add("Mật khẩu không được để trống.");
                if (string.IsNullOrWhiteSpace(dto.ConfirmPassword)) errors.Add("Xác nhận mật khẩu không được để trống.");
                if (!string.IsNullOrWhiteSpace(dto.Password) && dto.Password.Length < 6)
                    errors.Add("Mật khẩu phải có ít nhất 6 ký tự.");
                if (!string.IsNullOrWhiteSpace(dto.Password) &&
                    !string.IsNullOrWhiteSpace(dto.ConfirmPassword) &&
                    dto.Password != dto.ConfirmPassword)
                    errors.Add("Mật khẩu xác nhận không khớp.");

                if (errors.Count > 0)
                    return BadRequest(new { success = false, errors });

                var result = await authService.RegisterEmployeeAsync(dto);
                if (!result.Success)
                    return BadRequest(new { success = false, message = result.Message });

                return Ok(new
                {
                    success    = true,
                    message    = "Kích hoạt tài khoản nhân viên thành công! Vui lòng đăng nhập.",
                    employeeId = result.EmployeeId
                });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new { success = false, message = $"Lỗi kích hoạt tài khoản: {ex.Message}" });
            }
        }

        // ═══════════════════════════════════════════════════════
        // KIỂM TRA PHIÊN ĐĂNG NHẬP
        // ═══════════════════════════════════════════════════════

        /// <summary>FE gọi để kiểm tra xem user đang đăng nhập chưa và role là gì.</summary>
        [HttpGet("me")]
        public IActionResult Me()
        {
            var role      = HttpContext.Session.GetString("Role");
            var relatedId = HttpContext.Session.GetString("RelatedId");
            var fullName  = HttpContext.Session.GetString("FullName");

            if (string.IsNullOrEmpty(role))
                return Unauthorized(new { success = false, message = "Chưa đăng nhập." });

            return Ok(new
            {
                success   = true,
                role,
                fullName,
                relatedId
            });
        }
    }
}
