@page
@model ParkingManagement.FE.Pages.Employee.MonthlyTicketManagementModel

@section Styles {
    <link rel="stylesheet" href="/css/employee/monthly_ticket.css" asp-append-version="true" />
}

<div class="monthly-page">
    @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
    {
        <div class="alert-banner @(Model.ActionSuccess ? "success" : "error")">
            <i class="fa-solid @(Model.ActionSuccess ? "fa-circle-check" : "fa-circle-xmark")"></i>
            <span>@Model.ActionMessage</span>
        </div>
    }

    <div class="page-header">
        <div>
            <h1>Quản lý vé tháng</h1>
            <p>Xem, gia hạn và hủy vé tháng cho khách hàng</p>
        </div>
        <button type="button" class="secondary-btn" onclick="document.getElementById('monthlyPricingPanel').classList.toggle('open')">
            <i class="fa-solid fa-tags"></i> Bảng giá
        </button>
    </div>

    <!-- Bảng giá vé tháng -->
    <div class="pricing-collapse" id="monthlyPricingPanel">
        <div class="pricing-section">
            <div class="pricing-section-header">
                <div>
                    <h3>Bảng giá vé tháng</h3>
                    <p>Gửi xe không giới hạn số lần trong thời hạn. Mỗi vé áp dụng cho 1 biển số.</p>
                </div>
                <button type="button" class="pricing-close-btn" onclick="document.getElementById('monthlyPricingPanel').classList.remove('open')">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="monthly-pricing-table" data-pricing-table>
                <div class="duration-tabs" role="tablist" aria-label="Thời hạn vé tháng">
                    <button type="button" class="duration-tab active" data-duration-tab="1">1 tháng</button>
                    <button type="button" class="duration-tab" data-duration-tab="3">3 tháng</button>
                    <button type="button" class="duration-tab" data-duration-tab="6">6 tháng</button>
                </div>

                @{
                    var employeeVehiclePlans = new[]
                    {
                        new { VehicleType = PricingDisplayDefaults.Motorcycle, Name = "Vé xe máy", SubTitle = "Xe máy, scooter", Icon = "fa-solid fa-motorcycle", IconClass = "blue", IsSelected = false },
                        new { VehicleType = PricingDisplayDefaults.SmallCar, Name = "Vé ô tô nhỏ", SubTitle = "Xe dưới 7 chỗ", Icon = "fa-solid fa-car", IconClass = "green", IsSelected = true },
                        new { VehicleType = PricingDisplayDefaults.LargeCar, Name = "Vé ô tô lớn", SubTitle = "Xe từ 7 chỗ trở lên", Icon = "fa-solid fa-van-shuttle", IconClass = "purple", IsSelected = false }
                    };
                }

                @foreach (var duration in new[] { 1, 3, 6 })
                {
                    <div class="pricing-card-grid @(duration == 1 ? "" : "hidden")" data-duration-panel="@duration">
                        @foreach (var plan in employeeVehiclePlans)
                        {
                            var packagePrice = Model.GetMonthlyPrice(plan.VehicleType, duration);
                            var oneMonthPrice = Model.GetMonthlyPrice(plan.VehicleType, 1);
                            var monthlyPrice = duration > 0 ? Math.Round(packagePrice / duration) : packagePrice;
                            var monthlySaving = Math.Max(0, oneMonthPrice - monthlyPrice);

                            <article class="pricing-plan-card @(plan.IsSelected ? "selected" : "")" onclick="selectPricingCard(this)">
                                <div class="popular-badge @(plan.IsSelected ? "" : "hidden")">Phổ biến</div>
                                <div class="pricing-plan-header">
                                    <div class="pricing-icon @plan.IconClass">
                                        <i class="@plan.Icon"></i>
                                    </div>
                                    <div>
                                        <h4>@plan.Name</h4>
                                        <p>@plan.SubTitle</p>
                                    </div>
                                </div>

                                <div class="pricing-price-row">
                                    <div class="pricing-main-price">@monthlyPrice.ToString("N0") đ</div>
                                    <div class="pricing-unit">/ tháng@(duration > 1 ? $" × {duration} tháng" : "")</div>
                                    @if (duration > 1 && monthlySaving > 0)
                                    {
                                        <div class="pricing-monthly-saving">Tiết kiệm @monthlySaving.ToString("N0") đ/tháng so với mua lẻ</div>
                                    }
                                    @if (duration > 1)
                                    {
                                        <div class="pricing-total">Tổng thanh toán: <strong>@packagePrice.ToString("N0") đ</strong></div>
                                    }
                                </div>

                                <hr />

                                <ul class="pricing-features">
                                    <li><i class="fa-solid fa-circle-check"></i> Gửi xe không giới hạn</li>
                                    <li><i class="fa-solid fa-circle-check"></i> Áp dụng theo biển số xe</li>
                                    <li><i class="fa-solid fa-circle-check"></i> Ra vào tự do</li>
                                </ul>
                            </article>
                        }
                    </div>

                    @if (duration > 1)
                    {
                        var durationSaving = employeeVehiclePlans
                            .Select(plan => Math.Max(0, (Model.GetMonthlyPrice(plan.VehicleType, 1) * duration) - Model.GetMonthlyPrice(plan.VehicleType, duration)))
                            .DefaultIfEmpty(0)
                            .Max();

                        <p class="savings-note hidden" data-duration-note="@duration">
                            @if (durationSaving > 0)
                            {
                                <text>Tiết kiệm đến <span>@durationSaving.ToString("N0") đ</span> khi mua gói @duration tháng</text>
                            }
                        </p>
                    }
                }
            </div>

        </div>
    </div>

    <!-- KPI Cards -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon blue"><i class="fa-solid fa-id-card"></i></div>
            <div>
                <span>Tổng vé tháng</span>
                <h3>@Model.TotalTickets</h3>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon green"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <span>Đang hoạt động</span>
                <h3>@Model.ActiveTickets</h3>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon orange"><i class="fa-solid fa-clock"></i></div>
            <div>
                <span>Sắp hết hạn</span>
                <h3>@Model.ExpiringSoonTickets</h3>
                <small>Trong 7 ngày tới</small>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon red"><i class="fa-solid fa-calendar-xmark"></i></div>
            <div>
                <span>Đã hết hạn</span>
                <h3>@Model.ExpiredTickets</h3>
            </div>
        </div>
    </div>

    <!-- Filter -->
    <div class="table-card">
        <form method="get" class="filter-form">
            <div class="filter-row">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input name="Search" value="@Model.Search"
                           placeholder="Tìm theo biển số, mã vé, tên khách hàng, SĐT..." />
                </div>

                <select name="StatusFilter">
                    <option value="">Trạng thái: Tất cả</option>
                    <option value="Hoạt động" selected="@(Model.StatusFilter == "Hoạt động")">Hoạt động</option>
                    <option value="Hết hạn" selected="@(Model.StatusFilter == "Hết hạn")">Hết hạn</option>
                    <option value="Đã hủy" selected="@(Model.StatusFilter == "Đã hủy")">Đã hủy</option>
                </select>

                <select name="VehicleTypeFilter">
                    <option value="">Loại xe: Tất cả</option>
                    <option value="Xe máy" selected="@(Model.VehicleTypeFilter == "Xe máy")">Xe máy</option>
                    <option value="Ô tô nhỏ" selected="@(Model.VehicleTypeFilter == "Ô tô nhỏ")">Ô tô nhỏ</option>
                    <option value="Ô tô lớn" selected="@(Model.VehicleTypeFilter == "Ô tô lớn")">Ô tô lớn</option>
                </select>

                <button type="submit" class="secondary-btn">
                    <i class="fa-solid fa-filter"></i> Lọc
                </button>

                <a asp-page="./MonthlyTicketManagement" class="clear-btn">
                    <i class="fa-solid fa-rotate-right"></i> Xóa lọc
                </a>
            </div>
        </form>

        <!-- Table -->
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã vé</th>
                        <th>Khách hàng</th>
                        <th>Biển số</th>
                        <th>Loại xe</th>
                        <th>Gói</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày hết hạn</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tickets.Any())
                    {
                        @foreach (var ticket in Model.Tickets)
                        {
                            var statusClass = ticket.Status switch
                            {
                                "Hoạt động" => "active",
                                "Hết hạn" => "expired",
                                "Đã hủy" => "cancelled",
                                _ => ""
                            };
                            var isExpiringSoon = ticket.Status == "Hoạt động" && ticket.DaysRemaining <= 7;

                            <tr>
                                <td>
                                    <strong>@ticket.MonthlyTicketId</strong>
                                </td>
                                <td>
                                    <div class="customer-cell">
                                        <strong>@ticket.CustomerName</strong>
                                        <span>@ticket.CustomerPhone</span>
                                    </div>
                                </td>
                                <td><strong>@ticket.VehiclePlate</strong></td>
                                <td>
                                    <span class="vehicle-badge">
                                        <i class="fa-solid @(ticket.VehicleType == "Xe máy" ? "fa-motorcycle" : "fa-car")"></i>
                                        @ticket.VehicleType
                                    </span>
                                </td>
                                <td>@ticket.PackageType</td>
                                <td>@ticket.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @ticket.EndDate.ToString("dd/MM/yyyy")
                                    @if (isExpiringSoon)
                                    {
                                        <span class="expiring-badge">@ticket.DaysRemaining ngày</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-badge @statusClass">@ticket.Status</span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-page="./MonthlyTicketManagement"
                                           asp-route-selectedId="@ticket.MonthlyTicketId"
                                           asp-route-search="@Model.Search"
                                           asp-route-statusFilter="@Model.StatusFilter"
                                           asp-route-vehicleTypeFilter="@Model.VehicleTypeFilter"
                                           asp-route-pageNumber="@Model.PageNumber"
                                           asp-route-pageSize="@Model.PageSize"
                                           class="icon-btn" title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>


                                        @if (ticket.Status == "Hoạt động")
                                        {
                                            <form method="post" asp-page-handler="Cancel" style="display:inline;">
                                                <input type="hidden" name="monthlyTicketId" value="@ticket.MonthlyTicketId" />
                                                <button type="submit" class="icon-btn cancel-btn" title="Hủy vé"
                                                        onclick="return confirmSubmit(this.form, 'Hủy vé tháng', 'Bạn có chắc muốn hủy vé tháng @ticket.MonthlyTicketId?', 'danger')">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="empty-state">
                                <i class="fa-solid fa-inbox"></i>
                                <p>Không có vé tháng nào</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-row">
                <span>Hiển thị @((Model.PageNumber - 1) * Model.PageSize + 1) - @Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems) trong @Model.TotalItems vé</span>
                <div class="pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-page="./MonthlyTicketManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vehicleTypeFilter="@Model.VehicleTypeFilter"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize">‹</a>
                    }
                    @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                    {
                        <a asp-page="./MonthlyTicketManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vehicleTypeFilter="@Model.VehicleTypeFilter"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           class="@(i == Model.PageNumber ? "active" : "")">@i</a>
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-page="./MonthlyTicketManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vehicleTypeFilter="@Model.VehicleTypeFilter"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize">›</a>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Detail Panel -->
    @if (Model.SelectedTicket != null)
    {
        <div class="detail-overlay" onclick="window.location.href='@Url.Page("./MonthlyTicketManagement", new { Model.Search, Model.StatusFilter, Model.VehicleTypeFilter, Model.PageNumber, Model.PageSize })'"></div>
        <aside class="detail-panel">
            <div class="panel-header">
                <div>
                    <span class="panel-label">CHI TIẾT VÉ THÁNG</span>
                    <h2>@Model.SelectedTicket.MonthlyTicketId</h2>
                </div>
                <a asp-page="./MonthlyTicketManagement"
                   asp-route-search="@Model.Search"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-vehicleTypeFilter="@Model.VehicleTypeFilter"
                   asp-route-pageNumber="@Model.PageNumber"
                   asp-route-pageSize="@Model.PageSize"
                   class="close-btn">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            </div>

            <div class="panel-status">
                @{
                    var detailStatusClass = Model.SelectedTicket.Status switch
                    {
                        "Hoạt động" => "active",
                        "Hết hạn" => "expired",
                        "Đã hủy" => "cancelled",
                        _ => ""
                    };
                }
                <span class="status-badge @detailStatusClass">@Model.SelectedTicket.Status</span>
                @if (Model.SelectedTicket.Status == "Hoạt động" && Model.SelectedTicket.DaysRemaining <= 7)
                {
                    <span class="expiring-badge">Còn @Model.SelectedTicket.DaysRemaining ngày</span>
                }
            </div>

            <div class="detail-section">
                <h4><i class="fa-solid fa-user"></i> Khách hàng</h4>
                <div class="info-row">
                    <span>Họ tên</span>
                    <strong>@(Model.SelectedTicket.CustomerName ?? "N/A")</strong>
                </div>
                <div class="info-row">
                    <span>Số điện thoại</span>
                    <strong>@(Model.SelectedTicket.CustomerPhone ?? "N/A")</strong>
                </div>
            </div>

            <div class="detail-section">
                <h4><i class="fa-solid fa-car"></i> Thông tin xe</h4>
                <div class="info-row">
                    <span>Biển số</span>
                    <strong>@Model.SelectedTicket.VehiclePlate</strong>
                </div>
                <div class="info-row">
                    <span>Loại xe</span>
                    <strong>@Model.SelectedTicket.VehicleType</strong>
                </div>
            </div>

            <div class="detail-section">
                <h4><i class="fa-solid fa-calendar"></i> Thời hạn</h4>
                <div class="info-row">
                    <span>Gói</span>
                    <strong>@Model.SelectedTicket.PackageType</strong>
                </div>
                <div class="info-row">
                    <span>Ngày bắt đầu</span>
                    <strong>@Model.SelectedTicket.StartDate.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="info-row">
                    <span>Ngày hết hạn</span>
                    <strong>@Model.SelectedTicket.EndDate.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="info-row">
                    <span>Còn lại</span>
                    <strong>@Model.SelectedTicket.DaysRemaining ngày</strong>
                </div>
            </div>

            <div class="detail-section">
                <h4><i class="fa-solid fa-money-bill"></i> Thanh toán</h4>
                <div class="info-row">
                    <span>Tổng phí</span>
                    <strong>@Model.SelectedTicket.TotalFee.ToString("N0") đ</strong>
                </div>
                @if (Model.SelectedTicket.Payments.Any())
                {
                    <div class="payment-history">
                        @foreach (var payment in Model.SelectedTicket.Payments)
                        {
                            <div class="payment-item">
                                <span>@payment.PaymentTime.ToString("dd/MM/yyyy HH:mm")</span>
                                <span>@payment.Amount.ToString("N0") đ</span>
                                <span class="payment-method">@payment.Method</span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (Model.SelectedTicket.Status == "Hoạt động")
            {
                <div class="panel-actions">
                        <form method="post" asp-page-handler="Cancel" style="display:inline;">
                            <input type="hidden" name="monthlyTicketId" value="@Model.SelectedTicket.MonthlyTicketId" />
                            <button type="submit" class="danger-btn"
                                    onclick="return confirmSubmit(this.form, 'Hủy vé tháng', 'Bạn có chắc muốn hủy vé tháng này? Hành động không thể hoàn tác.', 'danger')">
                                <i class="fa-solid fa-ban"></i> Hủy vé
                            </button>
                        </form>
                </div>
            }
        </aside>
    }
</div>


@section Scripts {
    <script>
        document.querySelectorAll("[data-pricing-table]").forEach(function (table) {
            table.querySelectorAll("[data-duration-tab]").forEach(function (tab) {
                tab.addEventListener("click", function () {
                    const duration = tab.dataset.durationTab;
                    table.querySelectorAll("[data-duration-tab]").forEach(function (item) {
                        item.classList.toggle("active", item === tab);
                    });
                    table.querySelectorAll("[data-duration-panel]").forEach(function (panel) {
                        panel.classList.toggle("hidden", panel.dataset.durationPanel !== duration);
                    });
                    table.querySelectorAll("[data-duration-note]").forEach(function (note) {
                        note.classList.toggle("hidden", note.dataset.durationNote !== duration);
                    });
                });
            });
        });

        function selectPricingCard(card) {
            const panel = card.closest("[data-duration-panel]");
            if (!panel) return;
            panel.querySelectorAll(".pricing-plan-card").forEach(function (item) {
                item.classList.toggle("selected", item === card);
            });
        }

        // Bảng giá
        var pricing = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Pricing,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function getPrice(vehicleType, months) {
            var item = pricing.find(p => p.vehicleType === vehicleType && p.months === months);
            return item ? item.price : 0;
        }

        function formatCurrency(amount) {
            return amount.toLocaleString('vi-VN') + ' đ';
        }

        // Close modal on overlay click
        document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) {
                    overlay.classList.remove('open');
                }
            });
        });
    </script>
}
