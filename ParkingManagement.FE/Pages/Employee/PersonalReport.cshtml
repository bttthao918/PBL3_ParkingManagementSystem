@page
@model ParkingManagement.FE.Pages.Employee.PersonalReportModel

@section Styles {
    <link rel="stylesheet" href="/css/employee/personal_report.css" asp-append-version="true" />
}

<div class="report-page">
    <div class="report-header">
        <div>
            <h1>Báo cáo cá nhân</h1>
            <p>Tổng hợp kết quả làm việc của bạn theo ngày, tuần, tháng</p>
        </div>
    </div>

    <div class="report-filter">
        <div class="date-range">
            <i class="fa-regular fa-calendar"></i>
            <span>@Model.FromDate - @Model.ToDate</span>
        </div>

        <a href="?period=today" class="filter-btn @(Model.Period == "today" ? "active" : "")">Hôm nay</a>
        <a href="?period=7days" class="filter-btn @(Model.Period == "7days" ? "active" : "")">7 ngày</a>
        <a href="?period=month" class="filter-btn @(Model.Period == "month" && !Model.HasSelectedMonthFilter ? "active" : "")">Tháng này</a>
        <form method="get" class="month-filter @(Model.HasSelectedMonthFilter ? "active" : "")">
            <input type="hidden" name="period" value="month" />
            <partial name="/Pages/Shared/_MonthPicker.cshtml" model="Model.SelectedMonth" />
        </form>
    </div>

    <div class="report-layout">
        <section class="report-main">
            <div class="kpi-grid">
                <a asp-page="/Employee/TicketManagement" class="kpi-card clickable">
                    <div class="kpi-icon blue"><i class="fa-solid fa-ticket"></i></div>
                    <div>
                        <span>Tổng vé xử lý</span>
                        <h3>@Model.TotalTickets.ToString("N0")</h3>
                        <small>Theo thanh toán đã ghi nhận</small>
                    </div>
                </a>

                <a asp-page="/Employee/RevenueStatistics" asp-route-period="@Model.Period" asp-route-month="@Model.DetailMonth" class="kpi-card clickable">
                    <div class="kpi-icon green"><i class="fa-solid fa-money-bill-wave"></i></div>
                    <div>
                        <span>Doanh thu</span>
                        <h3>@Model.TotalRevenue.ToString("N0") đ</h3>
                        <small>Doanh thu bạn đã thu</small>
                    </div>
                </a>

                <a asp-page="/Employee/PersonalReport" class="kpi-card clickable">
                    <div class="kpi-icon purple"><i class="fa-solid fa-clock"></i></div>
                    <div>
                        <span>Tổng giờ làm</span>
                        <h3>@Model.TotalWorkingHours</h3>
                        <small>Từ lịch sử chấm công</small>
                    </div>
                </a>

                <a asp-page="/Employee/PersonalReport" class="kpi-card clickable">
                    <div class="kpi-icon orange"><i class="fa-solid fa-calendar-check"></i></div>
                    <div>
                        <span>Tổng ca làm</span>
                        <h3>@Model.TotalShifts ca</h3>
                        <small>Ca đã bắt đầu trong kỳ</small>
                    </div>
                </a>
            </div>

            <div class="chart-grid">
                <div class="report-card chart-card">
                    <div class="card-title">
                        <h3>Doanh thu theo ngày</h3>
                        <a asp-page="/Employee/RevenueStatistics" asp-route-period="@Model.Period" asp-route-month="@Model.DetailMonth">Xem chi tiết</a>
                    </div>

                    <div class="chart-box">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>

                <div class="report-card chart-card">
                    <div class="card-title">
                        <h3>Số vé xử lý theo ngày</h3>
                        <a asp-page="/Employee/TicketManagement">Xem chi tiết</a>
                    </div>

                    <div class="chart-box">
                        <canvas id="ticketChart"></canvas>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<script>
    window.personalReportData = {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
        revenues: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChartData)),
        tickets: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketChartData))
    };
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/personal_report.js" asp-append-version="true"></script>
}
