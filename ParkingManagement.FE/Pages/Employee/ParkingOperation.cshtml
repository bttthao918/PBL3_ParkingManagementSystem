@page
@model ParkingManagement.FE.Pages.Employee.ParkingOperationModel

@section Styles {
    <link rel="stylesheet" href="/css/employee/parking_operation.css" asp-append-version="true" />
}

<div class="operation-page">
    @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
    {
        <div class="alert-banner @(Model.ActionSuccess ? "success" : "error")">
            <i class="fa-solid @(Model.ActionSuccess ? "fa-circle-check" : "fa-circle-xmark")"></i>
            <span>@Model.ActionMessage</span>
        </div>
    }

    <div class="operation-header card">
        <div>
            <h2>Quản lý ra vào</h2>
            <p>Kiểm tra biển số, xử lý xe vào/ra và theo dõi lưu lượng trong bãi.</p>
        </div>
        <div class="operation-header-actions">
            <div class="stat-pill"><i class="fa-solid fa-clock"></i>Ca: <strong>@Model.ShiftLabel</strong></div>
            <div class="stat-pill"><i class="fa-solid fa-car"></i><strong>@Model.ActiveCount</strong> xe trong bãi</div>
        </div>
    </div>

    <div class="metric-row">
        <div class="metric">
            <div class="metric-icon blue"><i class="fa-solid fa-right-to-bracket"></i></div>
            <div>
                <div class="metric-label">Check-in hôm nay</div>
                <div class="metric-value">@Model.CheckInToday</div>
                <div class="metric-sub">Lượt xe vào bãi</div>
            </div>
        </div>
        <div class="metric">
            <div class="metric-icon green"><i class="fa-solid fa-right-from-bracket"></i></div>
            <div>
                <div class="metric-label">Check-out hôm nay</div>
                <div class="metric-value">@Model.CheckOutToday</div>
                <div class="metric-sub">@Model.ActiveCount xe chưa ra</div>
            </div>
        </div>
        <div class="metric">
            <div class="metric-icon purple"><i class="fa-solid fa-calendar-check"></i></div>
            <div>
                <div class="metric-label">Vé tháng active</div>
                <div class="metric-value">@Model.MonthlyTicketActive</div>
                <div class="metric-sub">@Model.MonthlyTicketExpiringSoon hết hạn tuần này</div>
            </div>
        </div>
        <div class="metric">
            <div class="metric-icon orange"><i class="fa-solid fa-square-parking"></i></div>
            <div>
                <div class="metric-label">Chỗ còn trống</div>
                <div class="metric-value">@Model.AvailableSlots</div>
                <div class="metric-sub">/ @Model.TotalSlots chỗ tổng</div>
            </div>
        </div>
    </div>

    <div class="operation-mode-card">
        <div class="operation-card-header">
            <div class="scan-title"><i class="fa-solid fa-qrcode"></i>Kiểm tra biển số</div>
            <div class="mode-tabs">
                <a asp-page="./ParkingOperation" asp-route-tab="checkin"
                   class="mode-tab @(Model.Tab == "checkin" ? "active checkin" : "")">
                    <i class="fa-solid fa-right-to-bracket"></i>Check-in
                </a>
                <a asp-page="./ParkingOperation" asp-route-tab="checkout"
                   class="mode-tab @(Model.Tab == "checkout" ? "active checkout" : "")">
                    <i class="fa-solid fa-right-from-bracket"></i>Check-out
                </a>
            </div>
        </div>

        @if (Model.Tab == "checkin")
        {
            <div class="operation-card">
                <form method="post" asp-page-handler="ValidateCheckIn" class="input-form">
                    <div class="input-row">
                        <div class="form-group flex-2">
                            <label>Biển số xe <span class="required">*</span></label>
                            <div class="input-with-icon plate-input">
                                <i class="fa-solid fa-car-side"></i>
                                <input type="text" name="vehiclePlate" value="@Model.VehiclePlate" placeholder="VD: 43A-123.45" required autofocus />
                            </div>
                        </div>
                        <div class="form-group flex-1">
                            <label>Loại xe</label>
                            <select name="vehicleType">
                                <option value="Xe máy" selected="@(Model.VehicleType == "Xe máy")">Xe máy</option>
                                <option value="Ô tô nhỏ" selected="@(Model.VehicleType == "Ô tô nhỏ")">Ô tô nhỏ</option>
                                <option value="Ô tô lớn" selected="@(Model.VehicleType == "Ô tô lớn")">Ô tô lớn</option>
                            </select>
                        </div>
                        <div class="form-group btn-group">
                            <button type="submit" class="btn-check in">
                                <i class="fa-solid fa-magnifying-glass"></i> Kiểm tra
                            </button>
                        </div>
                    </div>
                </form>

                @if (Model.CheckInValidation != null)
                {
                    var v = Model.CheckInValidation;
                    <div class="result-area">
                        <div class="result-label">Kết quả</div>
                        <div class="result-card">
                            <div class="result-icon"><i class="fa-solid @(Model.VehicleType == "Xe máy" ? "fa-motorcycle" : "fa-car")"></i></div>
                            <div class="result-info">
                                <div class="result-plate">@Model.VehiclePlate</div>
                                <div class="result-detail">
                                    @(string.IsNullOrWhiteSpace(v.CustomerName) ? "Khách vãng lai" : v.CustomerName)
                                    @if (v.HasMonthlyTicket && v.MonthlyTicketExpiryDate.HasValue)
                                    {
                                        <text> · Vé tháng còn @Math.Max(0, (v.MonthlyTicketExpiryDate.Value.Date - DateTime.Today).Days) ngày</text>
                                    }
                                    else if (v.HasReservation)
                                    {
                                        <text> · Có đặt chỗ</text>
                                    }
                                    else
                                    {
                                        <text> · Vé lượt</text>
                                    }
                                </div>
                            </div>
                            <div class="result-badge @(v.HasMonthlyTicket ? "monthly" : "")">@(v.HasMonthlyTicket ? "Vé tháng" : "Vé lượt")</div>
                        </div>
                    </div>

                    @if (!v.AvailableSlots.Any())
                    {
                        <div class="alert-banner error inline-alert">
                            <i class="fa-solid fa-circle-xmark"></i>
                            <span>@(v.Message ?? "Không còn chỗ trống cho loại xe này.")</span>
                        </div>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ConfirmCheckIn">
                            <input type="hidden" name="vehiclePlate" value="@Model.VehiclePlate" />
                            <input type="hidden" name="vehicleType" value="@Model.VehicleType" />
                            <input type="hidden" name="customerId" value="@v.CustomerId" />

                            <div class="slot-section">
                                <h4>
                                    <i class="fa-solid fa-square-parking"></i>
                                    @(v.HasReservation ? "Chỗ đỗ đã đặt" : "Chọn chỗ đỗ")
                                    <span class="slot-count">@(v.HasReservation ? v.PreferredSlotId : $"{v.AvailableSlots.Count} chỗ trống")</span>
                                </h4>

                                <div class="legend">
                                    <span><i class="dot green"></i>Trống</span>
                                    <span><i class="dot orange"></i>Đang dùng</span>
                                    <span><i class="dot blue"></i>Đã đặt</span>
                                    <span><i class="dot gray"></i>Bảo trì</span>
                                </div>

                                <div class="parking-map">
                                    @if (Model.AllSlotsForMap != null && Model.AllSlotsForMap.Any())
                                    {
                                        @foreach (var slot in Model.AllSlotsForMap)
                                        {
                                            var isPref = slot.SlotId == v.PreferredSlotId;
                                            var isSelectable = v.HasReservation ? isPref : IsSlotSelectable(slot.Status);
                                            var statusClass = GetSlotStatusClass(slot.Status);

                                            <label class="slot-option @(isSelectable ? "" : "disabled-slot")">
                                                @if (isSelectable)
                                                {
                                                    <input type="radio" name="slotId" value="@slot.SlotId" @(isPref ? "checked" : "") required />
                                                }
                                                else
                                                {
                                                    <input type="radio" disabled />
                                                }
                                                <div class="slot @statusClass @(isPref ? "preferred" : "")">
                                                    <strong>@slot.SlotId</strong>
                                                    <span>@(slot.Location ?? "-")</span>
                                                    @if (isPref) { <i class="fa-solid fa-star preferred-star"></i> }
                                                </div>
                                            </label>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var slot in v.AvailableSlots)
                                        {
                                            var isPref = slot.SlotId == v.PreferredSlotId;
                                            <label class="slot-option">
                                                <input type="radio" name="slotId" value="@slot.SlotId" @(isPref ? "checked" : "") required />
                                                <div class="slot empty @(isPref ? "preferred" : "")">
                                                    <strong>@slot.SlotId</strong>
                                                    <span>@slot.Location</span>
                                                    @if (isPref) { <i class="fa-solid fa-star preferred-star"></i> }
                                                </div>
                                            </label>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="confirm-bar">
                                <button type="submit" class="confirm-btn green"
                                        onclick="return confirmSubmit(this.form, 'Check-in', 'Xác nhận gửi xe vào bãi?', 'success')">
                                    <i class="fa-solid fa-check-circle"></i> Xác nhận vào
                                </button>
                            </div>
                        </form>
                    }
                }
            </div>
        }

        @if (Model.Tab == "checkout")
        {
            <div class="operation-card">
                <form method="post" asp-page-handler="ValidateCheckOut" class="input-form">
                    <div class="input-row checkout-row">
                        <div class="form-group flex-2">
                            <label>Biển số xe hoặc mã vé</label>
                            <div class="input-with-icon plate-input">
                                <i class="fa-solid fa-search"></i>
                                <input type="text" name="vehiclePlateOrTicketId" value="@Model.VehiclePlateOrTicketId" placeholder="VD: 43A-123.45 hoặc TKT0001" required />
                            </div>
                        </div>
                        <div class="form-group btn-group">
                            <button type="submit" class="btn-check out">
                                <i class="fa-solid fa-magnifying-glass"></i> Tra cứu
                            </button>
                        </div>
                    </div>
                </form>

                @if (Model.CheckOutValidation != null)
                {
                    var co = Model.CheckOutValidation;
                    @if (!co.Success)
                    {
                        <div class="alert-banner error inline-alert">
                            <i class="fa-solid fa-circle-xmark"></i> <span>@co.Message</span>
                        </div>
                    }
                    else
                    {
                        var hasQrPay = !co.IsFreeTicket && !string.IsNullOrWhiteSpace(co.BankTransferQrUrl);
                        <div class="checkout-detail">
                            <div class="checkout-grid">
                                <div class="co-card">
                                    <div class="co-card-header"><i class="fa-solid fa-car"></i> Thông tin</div>
                                    <div class="co-row"><span>Mã vé</span><strong>@co.TicketId</strong></div>
                                    <div class="co-row"><span>Biển số</span><strong>@co.VehiclePlate</strong></div>
                                    <div class="co-row"><span>Loại xe</span><strong>@co.VehicleType</strong></div>
                                    @if (!string.IsNullOrEmpty(co.CustomerName))
                                    {
                                        <div class="co-row"><span>Khách hàng</span><strong>@co.CustomerName</strong></div>
                                    }
                                </div>
                                <div class="co-card">
                                    <div class="co-card-header"><i class="fa-solid fa-clock"></i> Thời gian</div>
                                    <div class="co-row"><span>Giờ vào</span><strong>@co.CheckInTime?.ToString("HH:mm · dd/MM")</strong></div>
                                    <div class="co-row"><span>Giờ ra</span><strong>@co.CurrentTime?.ToString("HH:mm · dd/MM")</strong></div>
                                    <div class="co-row highlight"><span>Thời gian gửi</span><strong>@FormatDuration(co.DurationMinutes)</strong></div>
                                </div>
                                <div class="co-card fee">
                                    <div class="co-card-header"><i class="fa-solid fa-receipt"></i> Phí</div>
                                    @if (co.IsFreeTicket)
                                    {
                                        <div class="fee-big free">
                                            <span>Miễn phí</span>
                                            <strong>0 đ</strong>
                                            <small>Vé tháng còn hạn</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fee-big">
                                            <span>Tổng phí</span>
                                            <strong>@co.CalculatedFee.ToString("N0") đ</strong>
                                            <small>@co.TicketType</small>
                                        </div>
                                    }
                                </div>
                            </div>

                            <form method="post" asp-page-handler="ConfirmCheckOut">
                                <input type="hidden" name="ticketId" value="@co.TicketId" />
                                <input type="hidden" name="fee" value="@co.CalculatedFee" />
                                @if (hasQrPay)
                                {
                                    <div class="qr-pay-panel" data-qr-pay-panel>
                                        <div class="qr-pay-card">
                                            <div class="qr-image-wrap">
                                                <img src="@co.BankTransferQrUrl" alt="QR Pay BIDV" />
                                            </div>
                                            <div class="qr-pay-info">
                                                <h4><i class="fa-solid fa-qrcode"></i> QR Pay BIDV</h4>
                                                <div class="co-row"><span>Ngân hàng</span><strong>@co.BankName</strong></div>
                                                <div class="co-row"><span>Số tài khoản</span><strong>@co.BankAccount</strong></div>
                                                <div class="co-row"><span>Chủ tài khoản</span><strong>@co.BankAccountHolder</strong></div>
                                                <div class="co-row"><span>Nội dung</span><strong>@co.BankTransferContent</strong></div>
                                                <div class="co-row highlight"><span>Số tiền</span><strong>@co.CalculatedFee.ToString("N0") đ</strong></div>
                                                <label class="qr-confirm-check">
                                                    <input type="checkbox" name="paymentReceivedConfirmed" value="true" />
                                                    <span>Đã kiểm tra tài khoản BIDV và xác nhận đã nhận tiền</span>
                                                </label>
                                                <input class="qr-ref-input" type="text" name="bankTransferRef" placeholder="Mã giao dịch / ghi chú xác nhận (nếu có)" />
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="confirm-bar">
                                    <div class="form-group" style="min-width:200px;">
                                        <label>Thanh toán</label>
                                        <select name="paymentMethod" data-payment-method onchange="toggleQrPayPanel(this)">
                                            <option value="QR Pay" selected="@(hasQrPay ? "selected" : null)">QR Pay BIDV</option>
                                            <option value="Cash" selected="@(!hasQrPay ? "selected" : null)">Tiền mặt</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="confirm-btn orange"
                                            onclick="return confirmCheckoutSubmit(this.form, '@(co.CalculatedFee.ToString("N0"))đ')">
                                        <i class="fa-solid fa-check-circle"></i> Xác nhận Check-out
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                }

                @if (Model.ActiveTickets.Any())
                {
                    <div class="active-list">
                        <h4><i class="fa-solid fa-car-side"></i> Xe đang trong bãi <span class="count-badge">@Model.ActiveCount</span></h4>
                        <div class="active-table-wrap">
                            <table class="active-table lean-active-table">
                                <thead>
                                    <tr>
                                        <th>Mã vé</th>
                                        <th>Biển số</th>
                                        <th>Chỗ đỗ</th>
                                        <th>Giờ vào</th>
                                        <th>Thời gian</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.ActiveTickets)
                                    {
                                        var dur = (int)(DateTime.Now - t.CheckInTime).TotalMinutes;
                                        <tr>
                                            <td><strong>@t.TicketId</strong></td>
                                            <td><strong>@t.VehiclePlate</strong></td>
                                            <td>@(t.SlotId ?? "-")</td>
                                            <td>@t.CheckInTime.ToString("HH:mm")</td>
                                            <td><span class="duration-text">@FormatDuration(dur)</span></td>
                                            <td>
                                                <form method="post" asp-page-handler="ValidateCheckOut" style="display:inline;">
                                                    <input type="hidden" name="vehiclePlateOrTicketId" value="@t.TicketId" />
                                                    <button type="submit" class="checkout-row-btn">
                                                        <i class="fa-solid fa-right-from-bracket"></i> Check-out
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.RecentTickets.Any())
        {
            <div class="recent-list">
                <div class="result-label">Gần đây</div>
                @foreach (var ticket in Model.RecentTickets.Take(6))
                {
                    var isOut = ticket.CheckOutTime.HasValue || ticket.Status == "Đã ra";
                    var actionTime = isOut ? ticket.CheckOutTime ?? ticket.CheckInTime : ticket.CheckInTime;
                    <div class="recent-row">
                        <div class="recent-dot @(isOut ? "out" : "in")"></div>
                        <div class="recent-plate">@ticket.VehiclePlate</div>
                        <div class="recent-type">@ticket.VehicleType · @(string.IsNullOrWhiteSpace(ticket.CustomerName) ? "Vé lượt" : ticket.CustomerName)</div>
                        <div class="recent-time">@actionTime.ToString("HH:mm")</div>
                        <div class="recent-action @(isOut ? "out" : "in")">@(isOut ? "Ra" : "Vào")</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleQrPayPanel(select) {
            const form = select.closest('form');
            const panel = form?.querySelector('[data-qr-pay-panel]');
            if (!panel) return;

            const isQrPay = select.value === 'QR Pay';
            panel.hidden = !isQrPay;

            if (!isQrPay) {
                const checkbox = panel.querySelector('input[name="paymentReceivedConfirmed"]');
                if (checkbox) checkbox.checked = false;
            }
        }

        function confirmCheckoutSubmit(form, feeText) {
            const method = form.querySelector('[data-payment-method]')?.value;
            if (method === 'QR Pay') {
                const confirmed = form.querySelector('input[name="paymentReceivedConfirmed"]')?.checked;
                if (!confirmed) {
                    const checkbox = form.querySelector('input[name="paymentReceivedConfirmed"]');
                    showNotice(
                        'Chưa xác nhận thanh toán',
                        'Vui lòng kiểm tra tài khoản BIDV và xác nhận đã nhận tiền trước khi check-out.',
                        'warning',
                        () => checkbox?.focus()
                    );
                    return false;
                }
            }

            return confirmSubmit(form, 'Check-out', `Xác nhận check-out và thu phí ${feeText}?`, 'warning');
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-payment-method]').forEach(toggleQrPayPanel);
        });
    </script>
}

@functions {
    string FormatDuration(int minutes)
    {
        if (minutes < 60) return $"{minutes} phút";
        var h = minutes / 60;
        var m = minutes % 60;
        if (h < 24) return m > 0 ? $"{h}h {m}p" : $"{h} giờ";
        var d = h / 24;
        var rh = h % 24;
        return rh > 0 ? $"{d}d {rh}h" : $"{d} ngày";
    }

    string GetSlotStatusClass(string status)
    {
        var s = (status ?? "").ToLower();
        if (s.Contains("trống") || s.Contains("empty") || s.Contains("available")) return "empty";
        if (s.Contains("đang") || s.Contains("dùng") || s.Contains("using") || s.Contains("occupied")) return "using";
        if (s.Contains("đã đặt") || s.Contains("reserved") || s.Contains("booked")) return "reserved";
        if (s.Contains("bảo trì") || s.Contains("maintenance")) return "maintenance";
        return "error";
    }

    bool IsSlotSelectable(string status)
    {
        var s = (status ?? "").ToLower();
        return s.Contains("trống") || s.Contains("empty") || s.Contains("available");
    }
}
