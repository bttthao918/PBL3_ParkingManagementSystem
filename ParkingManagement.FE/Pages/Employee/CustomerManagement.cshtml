@page
@model ParkingManagement.FE.Pages.Employee.CustomerManagementModel

@{
    // ViewData is set in code-behind (CustomerManagement.cshtml.cs)
}
@section Styles{
    <link rel="stylesheet" href="/css/employee/customer_manage.css" asp-append-version="true" />
}

<div class="customer-page">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="background:#fff3cd;border:1px solid #ffc107;padding:10px;margin-bottom:15px;border-radius:5px;">
            <strong>⚠️ Debug:</strong> @Model.ErrorMessage
        </div>
    }

    <div class="customer-toolbar">
        <div>
            <h1>Quản lý khách hàng</h1>
            <p>Quản lý thông tin, lịch sử gửi xe và khách hàng VIP</p>
        </div>

    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon blue"><i class="fa-solid fa-users"></i></div>
            <div>
                <span>Tổng khách hàng</span>
                <h3>@Model.TotalCustomers</h3>
                <small>↑ 12.5% tháng này</small>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon purple"><i class="fa-solid fa-car"></i></div>
            <div>
                <span>Đang gửi xe</span>
                <h3>@Model.ActiveCustomers</h3>
                <small>↑ 8.2% tháng này</small>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon gold"><i class="fa-solid fa-crown"></i></div>
            <div>
                <span>Khách VIP</span>
                <h3>@Model.VipCustomers</h3>
                <small>↑ 5.7% tháng này</small>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon green"><i class="fa-solid fa-user-plus"></i></div>
            <div>
                <span>Khách mới</span>
                <h3>@Model.NewCustomers</h3>
                <small>↑ 15.3% tháng này</small>
            </div>
        </div>
    </div>

    <div class="customer-layout">

        <div class="customer-table-card">

            <form method="get" class="customer-filter-form">

                <div class="filter-top">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input asp-for="Search"
                               placeholder="Tìm theo tên, SĐT, mã khách hàng..." />
                    </div>

                    <button type="submit" class="secondary-btn filter-btn">
                        <i class="fa-solid fa-filter"></i>
                        Bộ lọc
                    </button>
                </div>

                <div class="filter-bottom">
                    <select asp-for="StatusFilter">
                        <option value="">Trạng thái: Tất cả</option>
                        <option value="Parking">Đang gửi xe</option>
                        <option value="Left">Đã rời bãi</option>
                        <option value="Debt">Nợ phí</option>
                    </select>

                    <select asp-for="VipFilter">
                        <option value="">Hạng khách hàng: Tất cả</option>
                        <option value="member">Thành viên</option>
                        <option value="silver">Bạc</option>
                        <option value="gold">Vàng</option>
                        <option value="diamond">Kim Cương</option>
                    </select>

                    <input asp-for="RegisterDate" type="date" class="date-input" />

                    <a asp-page="./CustomerManagement" class="clear-filter">
                        <i class="fa-solid fa-rotate-right"></i>
                        Xóa lọc
                    </a>
                </div>

            </form>

            <div class="table-wrapper">
                <table class="customer-table">
                    <thead>
                        <tr>
                            <th class="checkbox-col">
                                <input type="checkbox" />
                            </th>
                            <th>Khách hàng</th>
                            <th>SĐT</th>
                            <th>Hạng khách hàng</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Customers)
                        {
                            <tr class="@(Model.SelectedCustomer?.Id == item.Id ? "selected" : "")">
                                <td>
                                    <input type="checkbox" />
                                </td>

                                <td>
                                    <div class="customer-info">
                                        <div class="avatar">
                                            @(string.IsNullOrWhiteSpace(item.FullName) ? "?" : item.FullName.Substring(0, 1))
                                        </div>

                                        <div>
                                            <strong>@item.FullName</strong>
                                            <span>@item.CustomerCode</span>
                                        </div>
                                    </div>
                                </td>

                                <td>@item.Phone</td>

                                <td>
                                    <span class="vip-badge @item.VipClass">
                                        <i class="fa-solid @item.VipIcon"></i>
                                        @item.VipLevel
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge @item.StatusClass">
                                        <i class="fa-solid fa-circle"></i>
                                        @item.StatusText
                                    </span>
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a asp-page="./CustomerManagement"
                                           asp-route-selectedId="@item.Id"
                                           class="icon-btn"
                                           title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <div class="action-dropdown">
                                            <button type="button" class="icon-btn" title="Thao tác khác">
                                                <i class="fa-solid fa-ellipsis-vertical"></i>
                                            </button>

                                            <div class="dropdown-menu">
                                                <a asp-page="./CustomerManagement"
                                                   asp-route-selectedId="@item.Id">
                                                    <i class="fa-solid fa-eye"></i>
                                                    Xem chi tiết
                                                </a>

                                                <a asp-page="./CustomerManagement" asp-route-selectedId="@item.Id">
                                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                                    Lịch sử gửi xe
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination-row">
                <span>Hiển thị @Model.FirstItemIndex - @Model.LastItemIndex trong @Model.TotalCustomers khách hàng</span>

                <div class="pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-page="./CustomerManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vipFilter="@Model.VipFilter"
                           asp-route-registerDate="@(Model.RegisterDate?.ToString("yyyy-MM-dd"))"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize">‹</a>
                    }
                    else
                    {
                        <span class="disabled">‹</span>
                    }

                    @foreach (var pageIndex in Model.VisiblePages)
                    {
                        <a asp-page="./CustomerManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vipFilter="@Model.VipFilter"
                           asp-route-registerDate="@(Model.RegisterDate?.ToString("yyyy-MM-dd"))"
                           asp-route-pageNumber="@pageIndex"
                           asp-route-pageSize="@Model.PageSize"
                           class="@(pageIndex == Model.PageNumber ? "active" : "")">@pageIndex</a>
                    }

                    @if (Model.HasNextPage)
                    {
                        <a asp-page="./CustomerManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vipFilter="@Model.VipFilter"
                           asp-route-registerDate="@(Model.RegisterDate?.ToString("yyyy-MM-dd"))"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize">›</a>
                    }
                    else
                    {
                        <span class="disabled">›</span>
                    }
                </div>

                <form method="get" class="page-size-form">
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                    <input type="hidden" name="VipFilter" value="@Model.VipFilter" />
                    <input type="hidden" name="RegisterDate" value="@(Model.RegisterDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="PageNumber" value="1" />
                    <select asp-for="PageSize" onchange="this.form.submit()">
                        <option value="5">5 / trang</option>
                        <option value="10">10 / trang</option>
                        <option value="20">20 / trang</option>
                    </select>
                </form>
            </div>
        </div>

        @if (Model.SelectedCustomer != null)
        {
            <aside class="customer-detail-panel">

                <div class="panel-header">
                    <h3>Chi tiết khách hàng</h3>

                    <a asp-page="./CustomerManagement" class="close-panel">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                </div>

                <div class="detail-profile">
                    <div class="avatar large">
                        @(string.IsNullOrWhiteSpace(Model.SelectedCustomer.FullName) ? "?" : Model.SelectedCustomer.FullName.Substring(0, 1))
                    </div>

                    <div>
                        <h2>
                            @Model.SelectedCustomer.FullName

                            <span class="vip-badge @Model.SelectedCustomer.VipClass">
                                <i class="fa-solid @Model.SelectedCustomer.VipIcon"></i>
                                @Model.SelectedCustomer.VipLevel
                            </span>
                        </h2>

                        <span class="status-badge parking">
                            <i class="fa-solid fa-circle"></i>
                            Đang gửi xe
                        </span>
                    </div>
                </div>

                <div class="quick-actions">
                    <a asp-page="./TicketManagement" asp-route-search="@Model.SelectedCustomer.Phone" class="quick-btn">
                        <i class="fa-solid fa-ticket"></i>
                        <span>Vé xe</span>
                    </a>

                    <a asp-page="./CustomerManagement" asp-route-selectedId="@Model.SelectedCustomer.Id" class="quick-btn">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Lịch sử</span>
                    </a>
                </div>

                <div class="detail-card">
                    <div class="detail-card-title">
                        <h4>Thông tin cơ bản</h4>
                    </div>

                    <div class="info-row">
                        <span>Mã khách hàng</span>
                        <strong>@Model.SelectedCustomer.CustomerCode</strong>
                    </div>

                    <div class="info-row">
                        <span>Số điện thoại</span>
                        <strong>@Model.SelectedCustomer.Phone</strong>
                    </div>

                    <div class="info-row">
                        <span>Email</span>
                        <strong>@Model.SelectedCustomer.Email</strong>
                    </div>

                    <div class="info-row">
                        <span>Giới tính</span>
                        <strong>@(Model.SelectedCustomer.Gender ?? "Chưa cập nhật")</strong>
                    </div>

                    <div class="info-row">
                        <span>Ngày đăng ký</span>
                        <strong>@Model.SelectedCustomer.RegisterDate</strong>
                    </div>
                </div>

                <div class="detail-card vip-detail-card @Model.SelectedCustomer.VipClass">
                    <div class="detail-card-title">
                        <h4 class="vip-detail-heading">
                            <span>Hạng khách hàng</span>
                            <strong class="vip-level-chip @Model.SelectedCustomer.VipClass">
                                <i class="fa-solid @Model.SelectedCustomer.VipIcon"></i>
                                @Model.SelectedCustomer.VipLevel
                            </strong>
                        </h4>

                        <a asp-page="./CustomerManagement" asp-route-selectedId="@Model.SelectedCustomer.Id">Xem quyền lợi</a>
                    </div>

                    <div class="vip-summary">
                        <div>
                            <span>Tổng chi tiêu</span>
                            <strong>@Model.SelectedCustomer.TotalSpent.ToString("N0") đ</strong>
                        </div>

                        <div>
                            <span>Số lượt gửi</span>
                            <strong>@Model.SelectedCustomer.TotalTickets lượt</strong>
                        </div>

                        <div>
                            <span>Giảm phí</span>
                            <strong class="discount">@Model.SelectedCustomer.DiscountPercent%</strong>
                        </div>
                    </div>

                    <div class="progress-title">
                        @if (Model.SelectedCustomer.IsMaxVipLevel)
                        {
                            <span>Đã đạt hạng cao nhất</span>
                            <span>Đang hưởng ưu đãi cao nhất</span>
                        }
                        else
                        {
                            <span>Tiến độ lên @Model.SelectedCustomer.NextVipLevel</span>
                            <span>Còn @Model.SelectedCustomer.AmountToNextLevel.ToString("N0") đ</span>
                        }
                    </div>

                    <div class="progress-bar">
                        <div style="width:@Model.SelectedCustomer.VipProgress%">
                            @Model.SelectedCustomer.VipProgress%
                        </div>
                    </div>
                </div>

            </aside>
        }

    </div>
</div>
