@page
@model ParkingManagement.FE.Pages.Employee.DashboardModel
@{
    // ViewData is set in code-behind (Dashboard.cshtml.cs)
}

<div class="dashboard-title-card">
    <div>
        <h2>Tổng quan nhân viên</h2>
        <p>Theo dõi ca làm việc, vé đã xử lý và hiệu suất cá nhân trong tháng.</p>
    </div>
</div>

<div class="kpi-grid">
    <div class="card kpi-card">
        <div class="kpi-icon blue"><i class="fa-solid fa-ticket"></i></div>
        <div>
            <p>Tổng vé đã xử lý</p>
            <h2>@Model.Stats.TicketsProcessedThisMonth</h2>
            <span class="up">Hôm nay: @Model.Stats.TicketsProcessedToday vé</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon green"><i class="fa-solid fa-dollar-sign"></i></div>
        <div>
            <p>Doanh thu cá nhân</p>
            <h2>@Model.Stats.RevenueThisMonth.ToString("N0") đ</h2>
            <span class="up">Tuần này: @Model.Stats.RevenueThisWeek.ToString("N0") đ</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon purple"><i class="fa-solid fa-clock"></i></div>
        <div>
            <p>Tổng giờ làm việc</p>
            <h2>@(Model.Stats.WorkMinutesThisMonth / 60) giờ</h2>
            <span>@Model.Stats.WorkDaysThisMonth ca làm việc</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon green"><i class="fa-solid fa-bullseye"></i></div>
        <div>
            <p>Trung bình mỗi ngày</p>
            <h2>@Model.Stats.AverageTicketsPerDay.ToString("0.0") vé</h2>
            <span>TB/vé: @Model.Stats.AverageRevenuePerTicket.ToString("N0") đ</span>
        </div>
    </div>
</div>

<div class="card shift-card">
    @if (!string.IsNullOrWhiteSpace(Model.ShiftMessage))
    {
        <div class="shift-alert @(Model.ShiftSuccess ? "success" : "error")">
            <i class="fa-solid @(Model.ShiftSuccess ? "fa-circle-check" : "fa-circle-xmark")"></i>
            @Model.ShiftMessage
        </div>
    }

    <div class="shift-header">
        <h3><i class="fa-solid fa-clock"></i> Ca làm việc</h3>
        @if (Model.TodayShift?.HasShift == true)
        {
            <span class="shift-summary">Ca hôm nay: <strong>@Model.TodayShift.Shift?.ShiftType (@Model.TodayShift.Shift?.StartTime - @Model.TodayShift.Shift?.EndTime)</strong></span>
        }
        else if (Model.MonthlySummary != null)
        {
            <span class="shift-summary">Tháng @Model.MonthlySummary.Month: <strong>@Model.MonthlySummary.TotalDays ngày</strong> · <strong>@Model.MonthlySummary.TotalHours giờ</strong></span>
        }
    </div>

    <div class="shift-body">
        @if (Model.WorkStatus?.IsWorking == true)
        {
            var dur = Model.WorkStatus.DurationMinutes;
            var h = dur / 60;
            var m = dur % 60;
            <div class="shift-status working">
                <div class="shift-indicator pulse"></div>
                <div>
                    <strong>Đang trong ca</strong>
                    <span>Bắt đầu lúc @Model.WorkStatus.StartTime?.ToString("HH:mm") · Đã làm @(h > 0 ? $"{h}h {m}p" : $"{m} phút")</span>
                </div>
            </div>
            <form method="post" asp-page-handler="EndShift">
                <button type="submit" class="shift-btn end"
                        onclick="return confirmSubmit(this.form, 'Kết thúc ca', 'Xác nhận kết thúc ca làm việc?', 'warning')">
                    <i class="fa-solid fa-stop"></i> Kết thúc ca
                </button>
            </form>
        }
        else
        {
            <div class="shift-status idle">
                <div class="shift-indicator"></div>
                <div>
                    <strong>Chưa bắt đầu ca</strong>
                    <span>Bấm nút bên dưới để bắt đầu ca làm việc</span>
                </div>
            </div>
            <form method="post" asp-page-handler="StartShift">
                <input type="hidden" name="scheduleId" value="@Model.TodayShift?.Shift?.ScheduleId" />
                @if (Model.CanStartShift)
                {
                <button type="submit" class="shift-btn start"
                        onclick="return confirmSubmit(this.form, 'Bắt đầu ca', 'Xác nhận bắt đầu ca làm việc?', 'success')">
                    <i class="fa-solid fa-play"></i> Bắt đầu ca
                </button>
                }
                else
                {
                    <button type="button" class="shift-btn start" disabled>
                        <i class="fa-solid fa-play"></i> B&#7855;t &#273;&#7847;u ca
                    </button>
                }
            </form>
        }
    </div>
</div>

<div class="card quick-actions">
    <h3>Thao tác nhanh</h3>

    <div class="action-grid">
        <a asp-page="./TicketManagement"><i class="fa-solid fa-plus"></i> Tạo vé mới</a>
        <a asp-page="./TicketManagement"><i class="fa-solid fa-right-to-bracket"></i> Check-in</a>
        <a asp-page="./TicketManagement"><i class="fa-solid fa-right-from-bracket"></i> Check-out</a>
        <a asp-page="./TicketManagement"><i class="fa-solid fa-magnifying-glass"></i> Tìm vé</a>
        <a asp-page="./ParkingSlotManagement"><i class="fa-solid fa-square-parking"></i> Cập nhật chỗ đỗ</a>
    </div>
</div>

<div class="card chart-card">
    <h3>Doanh thu 7 ngày gần đây</h3>

    <svg viewBox="0 0 1000 260" preserveAspectRatio="none">
        <polyline points="@Model.RevenueChartPoints"
                  fill="none"
                  stroke="#0d8bff"
                  stroke-width="4" />
    </svg>
</div>

<div class="card tabs">
    <div class="tab-header">
        <button class="active" onclick="showEmployeeTab(0)">Vé mới nhất</button>
        <button onclick="showEmployeeTab(1)">Ca làm việc</button>
    </div>

    <div class="tab-content active employee-tab">
        <table>
            <tr>
                <th>Mã vé</th>
                <th>Khách hàng</th>
                <th>Loại xe</th>
                <th>Thời gian</th>
                <th>Trạng thái</th>
            </tr>
            @if (Model.RecentTickets.Count == 0)
            {
                <tr>
                    <td colspan="5" style="text-align: center; color: #64748b; padding: 20px;">
                        Chưa có vé mới.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var ticket in Model.RecentTickets)
                {
                    <tr>
                        <td>@ticket.TicketId</td>
                        <td>@(ticket.CustomerName ?? ticket.VehiclePlate)</td>
                        <td>@ticket.VehicleType</td>
                        <td>@ticket.CheckInTime.ToString("dd/MM HH:mm")</td>
                        <td>
                            @if (ticket.Status.Contains("Đang", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-warning">@ticket.Status</span>
                            }
                            else
                            {
                                <span class="status-success">@ticket.Status</span>
                            }
                        </td>
                    </tr>
                }
            }
        </table>
    </div>

    <div class="tab-content employee-tab">
        <table>
            <tr>
                <th>Ngày</th>
                <th>Ca làm</th>
                <th>Giờ vào</th>
                <th>Giờ ra</th>
                <th>Trạng thái</th>
            </tr>
            @if (Model.MyWeekShifts.Count == 0)
            {
                <tr>
                    <td colspan="5" style="text-align: center; color: #64748b; padding: 20px;">
                        Chưa có lịch phân ca trong tuần này.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var shift in Model.MyWeekShifts)
                {
                    <tr>
                        <td>@shift.WorkDate.ToString("dd/MM/yyyy")</td>
                        <td>@shift.ShiftType</td>
                        <td>@shift.StartTime</td>
                        <td>@shift.EndTime</td>
                        <td>
                            @if (shift.Status.Contains("Đang", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-warning">@shift.Status</span>
                            }
                            else if (shift.Status.Contains("Hoàn", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-success">@shift.Status</span>
                            }
                            else
                            {
                                <span style="color: #64748b;">@shift.Status</span>
                            }
                        </td>
                    </tr>
                }
            }
        </table>
    </div>
</div>

<script>
    function showEmployeeTab(index) {
        const tabs = document.querySelectorAll(".employee-tab");
        const buttons = document.querySelectorAll(".tab-header button");

        tabs.forEach(x => x.classList.remove("active"));
        buttons.forEach(x => x.classList.remove("active"));

        tabs[index].classList.add("active");
        buttons[index].classList.add("active");
    }
</script>
