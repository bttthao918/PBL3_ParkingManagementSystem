@page
@model ParkingManagement.FE.Pages.Employee.DashboardModel
@{
    ViewData["Title"] = "Tổng quan Nhân viên";
    ViewData["UserName"] = "Nguyễn Văn An";
    ViewData["Role"] = "Nhân viên";
}

<div class="kpi-grid">

    <div class="card kpi-card">
        <div class="kpi-icon blue"><i class="fa-solid fa-ticket"></i></div>
        <div>
            <p>Tổng vé đã xử lý</p>
            <h2>128</h2>
            <span class="up">↑ 15.2%</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon green"><i class="fa-solid fa-dollar-sign"></i></div>
        <div>
            <p>Doanh thu cá nhân</p>
            <h2>8,450,000 đ</h2>
            <span class="up">↑ 12.4%</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon purple"><i class="fa-solid fa-clock"></i></div>
        <div>
            <p>Tổng giờ làm việc</p>
            <h2>96 giờ</h2>
            <span>12 ca làm việc</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon green"><i class="fa-solid fa-bullseye"></i></div>
        <div>
            <p>Tỷ lệ hoàn thành</p>
            <h2>92%</h2>
            <span class="badge-success">Đạt mục tiêu</span>
        </div>
    </div>

</div>

<div class="card quick-actions">
    <h3>Thao tác nhanh</h3>

    <div class="action-grid">
        <a href="#"><i class="fa-solid fa-plus"></i> Tạo vé mới</a>
        <a href="#"><i class="fa-solid fa-right-to-bracket"></i> Check-in</a>
        <a href="#"><i class="fa-solid fa-right-from-bracket"></i> Check-out</a>
        <a href="#"><i class="fa-solid fa-magnifying-glass"></i> Tìm vé</a>
        <a href="#"><i class="fa-solid fa-square-parking"></i> Cập nhật chỗ đỗ</a>
    </div>
</div>

<div class="card chart-card">
    <h3>Doanh thu theo ngày</h3>

    <svg viewBox="0 0 1000 260" preserveAspectRatio="none">
        <polyline points="0,210 90,170 180,190 270,130 360,150 450,110 540,95 630,120 720,100 810,125 900,105 1000,90"
                  fill="none"
                  stroke="#0d8bff"
                  stroke-width="4" />
    </svg>
</div>

<div class="card tabs">

    <div class="tab-header">
        <button class="active" onclick="showEmployeeTab(0)">Vé mới nhất</button>
        <button onclick="showEmployeeTab(1)">Ca làm việc</button>
    </div>

    <div class="tab-content active employee-tab">
        <table>
            <tr>
                <th>Mã vé</th>
                <th>Khách hàng</th>
                <th>Loại xe</th>
                <th>Thời gian</th>
                <th>Trạng thái</th>
            </tr>
            <tr>
                <td>VE001</td>
                <td>Nguyễn Văn Nam</td>
                <td>Xe máy</td>
                <td>10:00</td>
                <td><span class="status-success">Đã xử lý</span></td>
            </tr>
            <tr>
                <td>VE002</td>
                <td>Trần Thị Hoa</td>
                <td>Ô tô</td>
                <td>10:30</td>
                <td><span class="status-warning">Đang gửi</span></td>
            </tr>
        </table>
    </div>

    <div class="tab-content employee-tab">
        <table>
            <tr>
                <th>Ngày</th>
                <th>Ca làm</th>
                <th>Giờ vào</th>
                <th>Giờ ra</th>
                <th>Tổng giờ</th>
            </tr>
            <tr>
                <td>31/06/2024</td>
                <td>Ca sáng</td>
                <td>07:00</td>
                <td>15:00</td>
                <td>8 giờ</td>
            </tr>
            <tr>
                <td>30/06/2024</td>
                <td>Ca chiều</td>
                <td>15:00</td>
                <td>23:00</td>
                <td>8 giờ</td>
            </tr>
        </table>
    </div>

</div>

<script>
    function showEmployeeTab(index) {
        const tabs = document.querySelectorAll(".employee-tab");
        const buttons = document.querySelectorAll(".tab-header button");

        tabs.forEach(x => x.classList.remove("active"));
        buttons.forEach(x => x.classList.remove("active"));

        tabs[index].classList.add("active");
        buttons[index].classList.add("active");
    }
</script>