@page
@model ParkingManagement.FE.Pages.Employee.TicketManagementModel

@{
    // ViewData is set in code-behind (TicketManagement.cshtml.cs)
}

@section Styles {
    <link rel="stylesheet" href="/css/employee/ticket_manage.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
}

<div class="ticket-page">
    @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
    {
        <div class="card" style="margin-bottom:12px; border-left:4px solid @(Model.ActionSuccess ? "#2e7d32" : "#c62828");">
            <p style="margin:0; color:@(Model.ActionSuccess ? "#2e7d32" : "#c62828");">@Model.ActionMessage</p>
        </div>
    }

    <div class="ticket-toolbar">
        <div>
            <h1>Quản lý vé</h1>
            <p>Xem vé, tìm kiếm, check-in, check-out và tính tiền gửi xe</p>
        </div>
        <button type="button" class="secondary-btn" onclick="document.getElementById('pricingPanel').classList.toggle('open')">
            <i class="fa-solid fa-tags"></i> Xem bảng giá
        </button>
    </div>

    <!-- Bảng giá gửi xe -->
    <div class="pricing-collapse" id="pricingPanel">
        <div class="pricing-section">
            <div class="pricing-section-header">
                <div>
                    <h3>Bảng giá vé</h3>
                    <p>Áp dụng cho các loại xe trong hệ thống bãi giữ xe.</p>
                </div>
                <button type="button" class="pricing-close-btn" onclick="document.getElementById('pricingPanel').classList.remove('open')">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="pricing-cards-row">
                <div class="pricing-vehicle-card">
                    <div class="pricing-vehicle-header">
                        <div class="pricing-vehicle-icon motorcycle"><i class="fa-solid fa-motorcycle"></i></div>
                        <div>
                            <span class="pricing-vehicle-name">Xe máy</span>
                            <div class="pricing-vehicle-price">3,000 đ <small>/ giờ</small></div>
                        </div>
                    </div>
                    <div class="pricing-vehicle-details">
                        <div class="pricing-detail-row">
                            <span>Theo giờ</span>
                            <strong>3,000 đ</strong>
                        </div>
                        <div class="pricing-detail-row">
                            <span>Tối đa / ngày</span>
                            <strong>30,000 đ/ngày</strong>
                        </div>
                        <div class="pricing-detail-row">
                            <span>Tối thiểu</span>
                            <strong>15 phút</strong>
                        </div>
                    </div>
                </div>

                <div class="pricing-vehicle-card">
                    <div class="pricing-vehicle-header">
                        <div class="pricing-vehicle-icon car"><i class="fa-solid fa-car"></i></div>
                        <div>
                            <span class="pricing-vehicle-name">Ô tô nhỏ</span>
                            <div class="pricing-vehicle-price">5,000 đ <small>/ giờ</small></div>
                        </div>
                    </div>
                    <div class="pricing-vehicle-details">
                        <div class="pricing-detail-row">
                            <span>Theo giờ</span>
                            <strong>5,000 đ</strong>
                        </div>
                        <div class="pricing-detail-row">
                            <span>Tối đa / ngày</span>
                            <strong>50,000 đ/ngày</strong>
                        </div>
                        <div class="pricing-detail-row">
                            <span>Tối thiểu</span>
                            <strong>15 phút</strong>
                        </div>
                    </div>
                </div>

                <div class="pricing-vehicle-card">
                    <div class="pricing-vehicle-header">
                        <div class="pricing-vehicle-icon truck"><i class="fa-solid fa-truck"></i></div>
                        <div>
                            <span class="pricing-vehicle-name">Ô tô lớn</span>
                            <div class="pricing-vehicle-price">8,000 đ <small>/ giờ</small></div>
                        </div>
                    </div>
                    <div class="pricing-vehicle-details">
                        <div class="pricing-detail-row">
                            <span>Theo giờ</span>
                            <strong>8,000 đ</strong>
                        </div>
                        <div class="pricing-detail-row">
                            <span>Tối đa / ngày</span>
                            <strong>80,000 đ/ngày</strong>
                        </div>
                        <div class="pricing-detail-row">
                            <span>Tối thiểu</span>
                            <strong>15 phút</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon blue"><i class="fa-solid fa-ticket"></i></div>
            <div>
                <span>Tất cả vé</span>
                <h3>@Model.TotalTickets</h3>
                <small>↑ 12.5% so với hôm qua</small>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon green"><i class="fa-solid fa-car"></i></div>
            <div>
                <span>Đang gửi xe</span>
                <h3>@Model.ActiveTickets</h3>
                <small>↑ 8.2% so với hôm qua</small>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon purple"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <span>Đã thanh toán</span>
                <h3>@Model.PaidTickets</h3>
                <small>↑ 15.3% so với hôm qua</small>
            </div>
        </div>
    </div>

    <div class="ticket-layout @(Model.SelectedTicket != null ? "has-detail" : "full-width")">

        <section class="ticket-table-card">

            <form method="get" class="ticket-filter-form">
                <div class="filter-top">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input asp-for="Search"
                               placeholder="Tìm vé theo mã vé, biển số, khách hàng, số điện thoại..." />
                    </div>

                    <button type="submit" class="secondary-btn">
                        <i class="fa-solid fa-filter"></i>
                        Bộ lọc
                    </button>
                </div>

                <div class="filter-bottom">
                    <select asp-for="StatusFilter">
                        <option value="">Trạng thái: Tất cả</option>
                        <option value="Đang trong bãi">Đang gửi</option>
                        <option value="Đã ra">Đã thanh toán / Đã ra</option>
                    </select>

                    <select asp-for="VehicleFilter">
                        <option value="">Loại xe: Tất cả</option>
                        <option value="Ô tô nhỏ">Ô tô nhỏ</option>
                        <option value="Ô tô lớn">Ô tô lớn</option>
                        <option value="Xe máy">Xe máy</option>
                    </select>

                    <select asp-for="AreaFilter">
                        <option value="">Khu vực: Tất cả</option>
                        <option value="A">Khu A</option>
                        <option value="B">Khu B</option>
                        <option value="C">Khu C</option>
                    </select>

                    <input name="CreatedDate" type="text" class="flatpickr-date" placeholder="dd/mm/yyyy"
                           value="@(Model.CreatedDate?.ToString("dd/MM/yyyy"))"
                           data-iso-value="@(Model.CreatedDate?.ToString("yyyy-MM-dd"))" />

                    <a asp-page="./TicketManagement" class="clear-filter">
                        <i class="fa-solid fa-rotate-right"></i>
                        Xóa lọc
                    </a>
                </div>
            </form>

            <div class="table-wrapper">
                <table class="ticket-table">
                    <thead>
                        <tr>
                            <th><input type="checkbox" /></th>
                            <th>Mã vé</th>
                            <th>Khách hàng</th>
                            <th>Biển số</th>
                            <th>Loại xe</th>
                            <th>Khu vực</th>
                            <th>Check-in</th>
                            <th>Trạng thái</th>
                            <th>Tiền phải trả</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Tickets)
                        {
                            <tr class="@(Model.SelectedTicket?.Id == item.Id ? "selected" : "")">
                                <td><input type="checkbox" /></td>

                                <td>
                                    <strong>@item.TicketCode</strong>
                                    <span>@item.CreatedAt</span>
                                </td>

                                <td>
                                    <div class="customer-info">
                                        <div class="avatar">
                                            @item.AvatarLetter
                                        </div>
                                        <div>
                                            <strong>@item.CustomerName</strong>
                                            <span>@item.Phone</span>
                                        </div>
                                    </div>
                                </td>

                                <td>@item.PlateNumber</td>

                                <td>
                                    <span class="vehicle-type">
                                        <i class="fa-solid @(item.VehicleType == "Xe máy" ? "fa-motorcycle" : "fa-car")"></i>
                                        @item.VehicleType
                                    </span>
                                </td>

                                <td>
                                    <span class="area-dot @item.AreaClass"></span>
                                    @item.Area
                                </td>

                                <td>
                                    <strong>@item.CheckInTime</strong>
                                    <span>@item.CheckInDate</span>
                                </td>

                                <td>
                                    <span class="status-badge @item.StatusClass">
                                        <i class="fa-solid fa-circle"></i>
                                        @item.StatusText
                                    </span>
                                </td>

                                <td>
                                    @if (item.TotalPrice.HasValue)
                                    {
                                        <strong>@item.TotalPrice.Value.ToString("N0") đ</strong>
                                    }
                                    else
                                    {
                                        <span>Chưa tính</span>
                                    }
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a asp-page="./TicketManagement"
                                               asp-route-selectedId="@item.Id"
                                               asp-route-search="@Model.Search"
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-vehicleFilter="@Model.VehicleFilter"
                                               asp-route-areaFilter="@Model.AreaFilter"
                                               asp-route-createdDate="@(Model.CreatedDate?.ToString("yyyy-MM-dd"))"
                                               asp-route-pageNumber="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               class="icon-btn"
                                               title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <div class="action-dropdown">
                                            <button type="button" class="icon-btn">
                                                <i class="fa-solid fa-ellipsis-vertical"></i>
                                            </button>

                                            <div class="dropdown-menu">
                                                <a asp-page="./TicketManagement"
                                                   asp-route-selectedId="@item.Id"
                                                   asp-route-search="@Model.Search"
                                                   asp-route-statusFilter="@Model.StatusFilter"
                                                   asp-route-vehicleFilter="@Model.VehicleFilter"
                                                   asp-route-areaFilter="@Model.AreaFilter"
                                                   asp-route-createdDate="@(Model.CreatedDate?.ToString("yyyy-MM-dd"))"
                                                   asp-route-pageNumber="@Model.PageNumber"
                                                   asp-route-pageSize="@Model.PageSize">
                                                    <i class="fa-solid fa-eye"></i>
                                                    Xem chi tiết
                                                </a>

                                                @if (item.CanCheckOut)
                                                {
                                                    <form method="post" asp-page-handler="CheckOut">
                                                        <input type="hidden" name="ticketId" value="@item.TicketCode" />
                                                        <input type="hidden" name="fee" value="@(item.TotalPrice ?? 0)" />
                                                        <input type="hidden" name="selectedId" value="@item.Id" />
                                                        <button type="submit" style="all:unset; cursor:pointer; display:block; width:100%;">
                                                            <i class="fa-solid fa-right-from-bracket"></i>
                                                            Check-out
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination-row">
                <span>Hiển thị @Model.FirstItemIndex - @Model.LastItemIndex trong @Model.FilteredTickets vé</span>

                <div class="pagination">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-page="./TicketManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vehicleFilter="@Model.VehicleFilter"
                           asp-route-areaFilter="@Model.AreaFilter"
                           asp-route-createdDate="@(Model.CreatedDate?.ToString("yyyy-MM-dd"))"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize">‹</a>
                    }
                    else
                    {
                        <span class="disabled">‹</span>
                    }

                    @foreach (var pageIndex in Model.VisiblePages)
                    {
                        <a asp-page="./TicketManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vehicleFilter="@Model.VehicleFilter"
                           asp-route-areaFilter="@Model.AreaFilter"
                           asp-route-createdDate="@(Model.CreatedDate?.ToString("yyyy-MM-dd"))"
                           asp-route-pageNumber="@pageIndex"
                           asp-route-pageSize="@Model.PageSize"
                           class="@(pageIndex == Model.PageNumber ? "active" : "")">@pageIndex</a>
                    }

                    @if (Model.HasNextPage)
                    {
                        <a asp-page="./TicketManagement"
                           asp-route-search="@Model.Search"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-vehicleFilter="@Model.VehicleFilter"
                           asp-route-areaFilter="@Model.AreaFilter"
                           asp-route-createdDate="@(Model.CreatedDate?.ToString("yyyy-MM-dd"))"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize">›</a>
                    }
                    else
                    {
                        <span class="disabled">›</span>
                    }
                </div>

                <form method="get" class="page-size-form">
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                    <input type="hidden" name="VehicleFilter" value="@Model.VehicleFilter" />
                    <input type="hidden" name="AreaFilter" value="@Model.AreaFilter" />
                    <input type="hidden" name="CreatedDate" value="@(Model.CreatedDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="PageNumber" value="1" />
                    <select asp-for="PageSize" onchange="this.form.submit()">
                        <option value="10">10 / trang</option>
                        <option value="20">20 / trang</option>
                        <option value="50">50 / trang</option>
                    </select>
                </form>
            </div>

        </section>

        @if (Model.SelectedTicket != null)
        {
            <aside class="ticket-detail-panel">

                <div class="ticket-panel-head">
                    <div>
                        <span class="panel-label">CHI TIẾT VÉ</span>
                        <h2>@Model.SelectedTicket.TicketCode</h2>
                    </div>

                    <a asp-page="./TicketManagement" class="close-panel">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                </div>

                <div class="ticket-status-row">
                    <span class="status-badge @Model.SelectedTicket.StatusClass">
                        <i class="fa-solid fa-circle"></i>
                        @Model.SelectedTicket.StatusText
                    </span>

                    <span class="ticket-created">
                        @Model.SelectedTicket.CreatedAt
                    </span>
                </div>

                <div class="ticket-meta">
                    <p>
                        <i class="fa-regular fa-user"></i>
                        Nhân viên: <strong>@Model.SelectedTicket.EmployeeName</strong>
                    </p>
                </div>

                <div class="detail-card">
                    <div class="detail-card-title">
                        <h4>Thông tin khách hàng</h4>
                    </div>

                    <div class="customer-detail-row">
                        <div class="avatar large">
                            @Model.SelectedTicket.AvatarLetter
                        </div>

                        <div>
                            <strong>@Model.SelectedTicket.CustomerName</strong>
                            <span>@Model.SelectedTicket.Phone</span>
                        </div>

                        <a href="tel:@Model.SelectedTicket.Phone" class="icon-btn">
                            <i class="fa-solid fa-phone"></i>
                        </a>
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-card-title">
                        <h4>Thông tin xe</h4>

                        <button class="small-icon-btn" type="button">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                    </div>

                    <div class="info-row">
                        <span>Biển số</span>
                        <strong>@Model.SelectedTicket.PlateNumber</strong>
                    </div>

                    <div class="info-row">
                        <span>Loại xe</span>
                        <strong>@Model.SelectedTicket.VehicleType</strong>
                    </div>

                    <div class="info-row">
                        <span>Màu xe</span>
                        <strong>@Model.SelectedTicket.VehicleColor</strong>
                    </div>

                    <div class="info-row">
                        <span>Nhãn hiệu</span>
                        <strong>@Model.SelectedTicket.Brand</strong>
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-card-title">
                        <h4>Thông tin gửi xe</h4>
                    </div>

                    <div class="info-row">
                        <span>Khu vực</span>
                        <strong>@Model.SelectedTicket.Area</strong>
                    </div>

                    <div class="info-row">
                        <span>Vị trí</span>
                        <strong>@Model.SelectedTicket.Position</strong>
                    </div>

                    <div class="info-row">
                        <span>Check-in</span>
                        <strong>@Model.SelectedTicket.CheckInFull</strong>
                    </div>

                    <div class="info-row">
                        <span>Thời gian gửi</span>
                        <strong>@Model.SelectedTicket.DurationText</strong>
                    </div>
                </div>

                <div class="detail-card payment-card">
                    <div class="detail-card-title">
                        <h4>Thông tin thanh toán</h4>
                        <a asp-page="/Admin/TicketManagement">Xem bảng giá</a>
                    </div>

                    @if (Model.SelectedTicket.TotalPrice.HasValue)
                    {
                        <div class="info-row">
                            <span>Thời gian gửi</span>
                            <strong>@Model.SelectedTicket.DurationText</strong>
                        </div>

                        <div class="info-row">
                            <span>Phí dịch vụ</span>
                            <strong>@Model.SelectedTicket.ServiceFee.ToString("N0") đ</strong>
                        </div>

                        <div class="total-row">
                            <span>Tổng tiền</span>
                            <strong>@Model.SelectedTicket.PaymentTotal.ToString("N0") đ</strong>
                        </div>
                    }
                    else
                    {
                        <div class="info-row">
                            <span>Trạng thái phí</span>
                            <strong>Chưa tính</strong>
                        </div>

                        <div class="info-row">
                            <span>Thời gian gửi</span>
                            <strong>@Model.SelectedTicket.DurationText</strong>
                        </div>
                    }
                </div>

            </aside>
        }

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var dateInput = document.querySelector('.flatpickr-date');
            if (dateInput) {
                flatpickr(dateInput, {
                    locale: 'vn',
                    dateFormat: 'd/m/Y',
                    allowInput: true,
                    onClose: function (selectedDates, dateStr, instance) {
                        // Khi chọn ngày, convert sang yyyy-MM-dd để server parse đúng
                        if (selectedDates.length > 0) {
                            var d = selectedDates[0];
                            var isoDate = d.getFullYear() + '-' +
                                String(d.getMonth() + 1).padStart(2, '0') + '-' +
                                String(d.getDate()).padStart(2, '0');
                            dateInput.setAttribute('data-iso-value', isoDate);
                        } else {
                            dateInput.setAttribute('data-iso-value', '');
                        }
                    }
                });

                // Trước khi submit form, đổi value sang ISO format để server parse đúng
                var form = dateInput.closest('form');
                if (form) {
                    form.addEventListener('submit', function () {
                        var isoVal = dateInput.getAttribute('data-iso-value');
                        if (!isoVal && dateInput.value) {
                            // Parse dd/MM/yyyy thành yyyy-MM-dd
                            var parts = dateInput.value.split('/');
                            if (parts.length === 3) {
                                isoVal = parts[2] + '-' + parts[1] + '-' + parts[0];
                            }
                        }
                        if (isoVal) {
                            dateInput.value = isoVal;
                        }
                    });
                }
            }
        });
    </script>
}
