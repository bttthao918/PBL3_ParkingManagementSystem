@page
@model ParkingManagement.FE.Pages.Account.ProfileModel
@{
    // Xác định Layout theo Role của tài khoản
    var role = Model.Account.RoleName?.ToLower() ?? "admin";
    switch (role)
    {
        case "employee":
        case "nhân viên":
            Layout = "/Pages/Shared/_EmployeeLayout.cshtml";
            Model.Account.RoleName = "Nhân viên";
            break;
        case "customer":
        case "khách hàng":
            Layout = "/Pages/Shared/_CustomerLayout.cshtml"; // Bạn cần đảm bảo đã tạo _CustomerLayout.cshtml tương ứng
            Model.Account.RoleName = "Khách hàng";
            break;
        default:
            Layout = "/Pages/Shared/_AdminLayout.cshtml";
            Model.Account.RoleName = "Quản trị viên";
            break;
    }
}

@section Styles {
    <link rel="stylesheet" href="/css/shared/account_profile.css" asp-append-version="true" />
}

<div class="account-page">
    <div class="page-heading">
        <h1>Thông tin tài khoản</h1>
        <p>Xem và cập nhật thông tin cá nhân của bạn.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert-danger">@Model.ErrorMessage</div>
    }

    <div class="account-grid">
        <!-- LEFT: PROFILE VIEW -->
        <section class="profile-card">
            <div class="card-title-row">
                <div class="title-icon blue">
                    <i class="fa-solid fa-id-card"></i>
                </div>
                <div>
                    <h2>Thông tin tài khoản</h2>
                    <p>Thông tin hiện tại của bạn</p>
                </div>
            </div>

            <div class="profile-avatar-wrap">
                <div class="profile-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <button class="avatar-camera" type="button">
                    <i class="fa-solid fa-camera"></i>
                </button>
            </div>

            <div class="info-list">
                <div class="info-row">
                    <span><i class="fa-regular fa-user"></i> Họ và tên</span>
                    <strong>@Model.Account.FullName</strong>
                </div>

                <div class="info-row">
                    <span><i class="fa-regular fa-envelope"></i> Email</span>
                    <strong>@Model.Account.Email</strong>
                </div>

                <div class="info-row">
                    <span><i class="fa-solid fa-mobile-screen"></i> Số điện thoại</span>
                    <strong>@Model.Account.PhoneNumberDisplay</strong>
                </div>

                <div class="info-row">
                    <span><i class="fa-regular fa-briefcase"></i> Vai trò</span>
                    <strong class="role-badge">@Model.Account.RoleName</strong>
                </div>

                <div class="info-row">
                    <span><i class="fa-regular fa-circle-user"></i> Giới tính</span>
                    <strong>@Model.Account.GenderDisplay</strong>
                </div>

                <div class="info-row">
                    <span><i class="fa-regular fa-calendar"></i> Ngày tạo tài khoản</span>
                    <strong>@Model.Account.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>
        </section>

        <!-- RIGHT: EDIT FORM -->
        <section class="edit-card">
            <div class="edit-header">
                <div class="card-title-row">
                    <div class="title-icon green">
                        <i class="fa-solid fa-pen"></i>
                    </div>
                    <div>
                        <h2>Chỉnh sửa thông tin</h2>
                        <p>Cập nhật thông tin cá nhân của bạn</p>
                    </div>
                </div>

                <span class="secure-badge">
                    <i class="fa-solid fa-shield-halved"></i>
                    Thông tin được bảo mật
                </span>
            </div>

            <form method="post" class="edit-form">
                <div class="form-group">
                    <label asp-for="Input.FullName">Họ và tên <b>*</b></label>
                    <input asp-for="Input.FullName" />
                    <span asp-validation-for="Input.FullName"></span>
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <div class="readonly-input">
                        <span>@Model.Account.Email</span>
                        <i class="fa-solid fa-lock"></i>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.PhoneNumber">Số điện thoại <b>*</b></label>
                    <input asp-for="Input.PhoneNumber" />
                    <span asp-validation-for="Input.PhoneNumber"></span>
                </div>

                <div class="form-group">
                    <label>Vai trò</label>
                    <div class="readonly-input">
                        @Model.Account.RoleName
                        <i class="fa-solid fa-lock"></i>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Gender">Giới tính <b>*</b></label>
                    <select asp-for="Input.Gender">
                        <option value="">Chọn giới tính</option>
                        <option value="Male">Nam</option>
                        <option value="Female">Nữ</option>
                        <option value="Other">Khác</option>
                    </select>
                    <span asp-validation-for="Input.Gender"></span>
                </div>

                <div class="form-actions">
                    <button type="reset" class="btn-secondary">Hủy</button>
                    <button type="submit" class="btn-primary"
                            onclick="return confirmSubmit(this.form, 'Cập nhật thông tin', 'Bạn có chắc muốn lưu thay đổi thông tin cá nhân?', 'info')">
                        <i class="fa-regular fa-floppy-disk"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
