@page
@model ParkingManagement.FE.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    
    // Xác định Layout theo Role của tài khoản
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower() ?? "admin";
    switch (role)
    {
        case "employee":
        case "nhân viên":
            Layout = "/Pages/Shared/_EmployeeLayout.cshtml";
            ViewData["Role"] = "Nhân viên";
            break;
        case "customer":
        case "khách hàng":
            Layout = "/Pages/Shared/_CustomerLayout.cshtml";
            ViewData["Role"] = "Khách hàng";
            break;
        default:
            Layout = "/Pages/Shared/_AdminLayout.cshtml";
            ViewData["Role"] = "Quản trị viên";
            break;
    }
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Người dùng";
}

@section Styles {
    <link rel="stylesheet" href="/css/shared/change_password.css" asp-append-version="true" />
}

<div class="password-page">
    <div class="page-heading">
        <h1>Đổi mật khẩu</h1>
        <p>Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-error">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert-success">@Model.SuccessMessage</div>
    }

    <div class="password-grid">
        <!-- LEFT -->
        <section class="security-card">
            <div class="security-header">
                <div class="security-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>
                    <h2>Bảo mật tài khoản</h2>
                    <p>
                        Để đảm bảo an toàn cho tài khoản, vui lòng đặt mật khẩu mạnh
                        và không chia sẻ mật khẩu với người khác.
                    </p>
                </div>
            </div>

            <div class="security-list">
                <div class="security-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <div>
                        <h3>Giữ mật khẩu bí mật</h3>
                        <p>Không chia sẻ mật khẩu với bất kỳ ai, kể cả nhân viên hỗ trợ.</p>
                    </div>
                </div>

                <div class="security-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-key"></i>
                    </div>
                    <div>
                        <h3>Sử dụng mật khẩu mạnh</h3>
                        <p>Mật khẩu nên có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                    </div>
                </div>

                <div class="security-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-rotate"></i>
                    </div>
                    <div>
                        <h3>Thay đổi định kỳ</h3>
                        <p>Nên thay đổi mật khẩu định kỳ để tăng cường bảo mật cho tài khoản.</p>
                    </div>
                </div>

                <div class="security-item">
                    <div class="item-icon">
                        <i class="fa-solid fa-desktop"></i>
                    </div>
                    <div>
                        <h3>Đăng xuất khi không sử dụng</h3>
                        <p>Đăng xuất khỏi tài khoản khi sử dụng thiết bị công cộng hoặc không phải của bạn.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- RIGHT -->
        <section class="password-card">
            <div class="form-header">
                <div class="form-icon">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <div>
                    <h2>Đổi mật khẩu</h2>
                    <p>Nhập thông tin bên dưới để cập nhật mật khẩu mới.</p>
                </div>
            </div>

            <form method="post" class="password-form">
                <div class="form-group">
                    <label asp-for="Input.CurrentPassword">
                        Mật khẩu hiện tại <b>*</b>
                    </label>

                    <div class="password-input">
                        <input asp-for="Input.CurrentPassword" type="password" id="currentPassword"
                               placeholder="Nhập mật khẩu hiện tại" />
                        <button type="button" onclick="togglePassword('currentPassword', this)">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.CurrentPassword"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.NewPassword">
                        Mật khẩu mới <b>*</b>
                    </label>

                    <div class="password-input">
                        <input asp-for="Input.NewPassword" type="password" id="newPassword"
                               placeholder="Nhập mật khẩu mới"
                               oninput="checkPasswordStrength(this.value)" />
                        <button type="button" onclick="togglePassword('newPassword', this)">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>

                    <div class="strength-row">
                        <span>Độ mạnh mật khẩu:</span>
                        <strong id="strengthText">Yếu</strong>
                    </div>

                    <div class="strength-bar">
                        <div id="strengthFill"></div>
                    </div>

                    <small>
                        Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                    </small>

                    <span asp-validation-for="Input.NewPassword"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">
                        Xác nhận mật khẩu mới <b>*</b>
                    </label>

                    <div class="password-input">
                        <input asp-for="Input.ConfirmPassword" type="password" id="confirmPassword"
                               placeholder="Nhập lại mật khẩu mới" />
                        <button type="button" onclick="togglePassword('confirmPassword', this)">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"></span>
                </div>

                <div class="form-actions">
                    <button type="reset" class="btn-secondary">Hủy</button>

                    <button type="submit" class="btn-primary">
                        <i class="fa-solid fa-lock"></i>
                        Cập nhật mật khẩu
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

        function checkPasswordStrength(password) {
            const text = document.getElementById("strengthText");
            const fill = document.getElementById("strengthFill");

            let score = 0;

            if (password.length >= 8) score++;
            if (/[A-Z]/.test(password)) score++;
            if (/[a-z]/.test(password)) score++;
            if (/[0-9]/.test(password)) score++;
            if (/[^A-Za-z0-9]/.test(password)) score++;

            fill.className = "";

            if (score <= 2) {
                text.innerText = "Yếu";
                text.className = "weak";
                fill.classList.add("weak");
            } else if (score <= 4) {
                text.innerText = "Trung bình";
                text.className = "medium";
                fill.classList.add("medium");
            } else {
                text.innerText = "Mạnh";
                text.className = "strong";
                fill.classList.add("strong");
            }
        }
    </script>
}
