@page
@model ParkingManagement.FE.Pages.Auth.VerifyOtpModel
@{
    Layout = null;
    var errorMessage = Model.ErrorMessage;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xác thực OTP - Parking Management System</title>
    <link rel="stylesheet" href="/css/shared/authenticate.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        .otp-card {
            background: #fff;
            border-radius: 24px;
            padding: 48px 44px;
            width: min(440px, 100%);
            box-shadow: 0 20px 60px rgba(0,0,0,0.12);
            text-align: center;
        }

        .otp-icon {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, #4e73df, #224abe);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 1.8rem;
            color: #fff;
            box-shadow: 0 8px 24px rgba(78,115,223,0.35);
        }

        .otp-card h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 8px;
        }

        .otp-card .subtitle {
            font-size: 0.9rem;
            color: #6b7280;
            margin-bottom: 6px;
        }

        .email-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 20px;
            margin-bottom: 28px;
            border: 1px solid #bfdbfe;
            word-break: break-all;
        }

        .otp-inputs {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 28px 0;
        }

        .otp-inputs input[type="text"] {
            width: 50px;
            height: 58px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 1.5rem;
            font-weight: 700;
            text-align: center;
            color: #1a1a2e;
            transition: border-color .2s, box-shadow .2s;
            outline: none;
            background: #f9fafb;
        }

        .otp-inputs input[type="text"]:focus {
            border-color: #4e73df;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(78,115,223,0.15);
        }

        .otp-inputs input[type="text"].filled {
            border-color: #4e73df;
            background: #eff6ff;
        }

        /* Hidden actual input */
        #otpHidden { display: none; }

        .btn-verify {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #4e73df, #224abe);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity .2s, transform .1s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-verify:hover { opacity: .9; }
        .btn-verify:active { transform: scale(.99); }
        .btn-verify:disabled { opacity: .6; cursor: not-allowed; }

        .resend-row {
            margin-top: 20px;
            font-size: 0.875rem;
            color: #6b7280;
        }

        .resend-row button {
            background: none;
            border: none;
            color: #4e73df;
            font-weight: 600;
            cursor: pointer;
            padding: 0;
            font-size: inherit;
        }

        .resend-row button:disabled {
            color: #9ca3af;
            cursor: not-allowed;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 16px;
            font-size: 0.875rem;
            color: #6b7280;
            text-decoration: none;
            transition: color .2s;
        }

        .back-link:hover { color: #4e73df; }

        .field-error {
            display: block;
            color: #ef4444;
            font-size: 0.8rem;
            margin-top: 4px;
        }

        .countdown {
            font-weight: 600;
            color: #ef4444;
        }

        /* OTP page wrapper dùng lại auth-page */
        .auth-page { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    </style>
</head>
<body>
    <div class="auth-page">
        <div class="otp-card">

            <div class="otp-icon">
                <i class="fa-solid fa-envelope-open-text"></i>
            </div>

            <h2>Xác thực OTP</h2>
            <p class="subtitle">Mã xác thực đã được gửi đến</p>
            <div class="email-badge">
                <i class="fa-regular fa-envelope"></i>
                @Model.Email
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error" style="text-align:left">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @errorMessage
                </div>
            }

            <form method="post" id="otpForm">
                <input type="hidden" asp-for="Input.Email" value="@Model.Email" />
                <input type="hidden" asp-for="Input.Otp" id="otpHidden" />

                <!-- 6 ô nhập riêng lẻ -->
                <div class="otp-inputs" id="otpBoxes">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" class="otp-digit" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" class="otp-digit" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" class="otp-digit" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" class="otp-digit" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" class="otp-digit" />
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" class="otp-digit" />
                </div>

                <span asp-validation-for="Input.Otp" class="field-error"></span>

                <button type="submit" class="btn-verify" id="btnVerify" disabled>
                    <i class="fa-solid fa-shield-check"></i>
                    Xác thực
                </button>
            </form>

            <div class="resend-row">
                Không nhận được mã?
                <button id="btnResend" disabled onclick="resendOtp()">
                    Gửi lại (<span class="countdown" id="countdown">300</span>s)
                </button>
            </div>

            <a href="/Auth/Authenticate" class="back-link">
                <i class="fa-solid fa-arrow-left"></i> Quay lại đăng nhập
            </a>

        </div>
    </div>

    <script>
        // ── OTP box logic ──────────────────────────────
        const digits = document.querySelectorAll('.otp-digit');
        const hidden = document.getElementById('otpHidden');
        const btnVerify = document.getElementById('btnVerify');

        digits.forEach((input, i) => {
            input.addEventListener('input', (e) => {
                // Chỉ cho số
                input.value = input.value.replace(/\D/g, '').slice(-1);
                if (input.value) {
                    input.classList.add('filled');
                    if (i < 5) digits[i + 1].focus();
                } else {
                    input.classList.remove('filled');
                }
                syncOtp();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && i > 0) {
                    digits[i - 1].focus();
                    digits[i - 1].value = '';
                    digits[i - 1].classList.remove('filled');
                    syncOtp();
                }
            });

            input.addEventListener('paste', (e) => {
                const paste = e.clipboardData.getData('text').replace(/\D/g, '').slice(0, 6);
                paste.split('').forEach((ch, j) => {
                    if (digits[j]) {
                        digits[j].value = ch;
                        digits[j].classList.add('filled');
                    }
                });
                syncOtp();
                e.preventDefault();
            });
        });

        // Focus ô đầu tiên khi load
        digits[0].focus();

        function syncOtp() {
            const otp = [...digits].map(d => d.value).join('');
            hidden.value = otp;
            btnVerify.disabled = otp.length < 6;
        }

        // ── Countdown 5 phút ──────────────────────────────
        let timeLeft = 300;
        const countdownEl = document.getElementById('countdown');
        const btnResend = document.getElementById('btnResend');

        const timer = setInterval(() => {
            timeLeft--;
            countdownEl.textContent = timeLeft;
            if (timeLeft <= 0) {
                clearInterval(timer);
                btnResend.disabled = false;
                btnResend.innerHTML = 'Gửi lại OTP';
            }
        }, 1000);

        function resendOtp() {
            // Redirect về trang đăng ký với thông báo
            window.location.href = '/Auth/Authenticate?tab=register';
        }

        // ── Submit form ──────────────────────────────
        document.getElementById('otpForm').addEventListener('submit', function (e) {
            const otp = hidden.value;
            if (otp.length < 6) {
                e.preventDefault();
                return;
            }
            btnVerify.disabled = true;
            btnVerify.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xác thực...';
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
