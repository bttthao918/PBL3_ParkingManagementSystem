@page
@{
    ViewData["Title"] = "Test API Connection";
}
<h1>Test Backend Connection</h1>

<button onclick="testHealth()">Test Health API</button>
<button onclick="testLogin()">Test Login API</button>

<div id="result"></div>

<script>
    async function testHealth() {
        try {
            const response = await fetch('https://localhost:7265/api/health');
            const data = await response.json();
            document.getElementById('result').innerHTML =
                `<div style="color:green">✅ Health API OK: ${JSON.stringify(data)}</div>`;
        } catch (error) {
            document.getElementById('result').innerHTML =
                `<div style="color:red">❌ Error: ${error.message}</div>`;
        }
    }

    async function testLogin() {
        try {
            const response = await fetch('https://localhost:7265/api/auth/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    email: 'th04092006@gmail.com',
                    password: 'Huong@4906'
                })
            });
            const data = await response.json();
            document.getElementById('result').innerHTML =
                `<div style="color:green">✅ Login API OK: ${JSON.stringify(data)}</div>`;
        } catch (error) {
            document.getElementById('result').innerHTML =
                `<div style="color:red">❌ Error: ${error.message}</div>`;
        }
    }
</script>