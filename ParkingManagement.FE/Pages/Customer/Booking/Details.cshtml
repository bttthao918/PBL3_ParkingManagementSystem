@page "{id}"
@model ParkingManagement.FE.Pages.Customer.Booking.DetailsModel

@section Styles {
    <link rel="stylesheet" href="/css/customer/bookings.css" asp-append-version="true" />
}

<div class="booking-page">
    <div class="booking-header">
        <div>
            <h1>Chi tiết đặt chỗ</h1>
            <p>Xem thông tin chi tiết đặt chỗ của bạn</p>
        </div>

        <a asp-page="/Customer/Booking/Index" class="btn-back">
            ← Quay lại
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Reservation != null)
    {
        <div class="detail-card">
            <div class="detail-header">
                <h2>Mã đặt chỗ: @Model.Reservation.ReservationId</h2>
                <span class="status-badge @GetStatusClass(Model.Reservation.Status)">
                    @GetStatusText(Model.Reservation.Status)
                </span>
            </div>

            <div class="detail-grid">
                <div class="detail-section">
                    <h3><i class="fa-solid fa-car"></i> Thông tin xe</h3>
                    <div class="detail-row">
                        <span>Biển số xe:</span>
                        <strong>@Model.Reservation.VehiclePlate</strong>
                    </div>
                    <div class="detail-row">
                        <span>Loại xe:</span>
                        <strong>@Model.Reservation.VehicleType</strong>
                    </div>
                </div>

                <div class="detail-section">
                    <h3><i class="fa-solid fa-location-dot"></i> Vị trí đỗ</h3>
                    <div class="detail-row">
                        <span>Vị trí:</span>
                        <strong>@(Model.Reservation.SlotLocation ?? "Chưa phân bổ")</strong>
                    </div>
                </div>

                <div class="detail-section">
                    <h3><i class="fa-solid fa-clock"></i> Thời gian</h3>
                    <div class="detail-row">
                        <span>Thời gian dự kiến:</span>
                        <strong>@Model.Reservation.ExpectedTime.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="detail-row">
                        <span>Ngày tạo:</span>
                        <strong>@Model.Reservation.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                </div>
            </div>

            @if (Model.Reservation.Status.ToLower() == "pending" || Model.Reservation.Status.ToLower() == "confirmed")
            {
                <div class="detail-actions">
                    <a asp-page="/Customer/Booking/Cancel" asp-route-id="@Model.Reservation.ReservationId" 
                       class="btn-danger">
                        <i class="fa-solid fa-times"></i> Hủy đặt chỗ
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-search"></i>
            <p>Không tìm thấy thông tin đặt chỗ</p>
        </div>
    }
</div>

@functions {
    string GetStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "status-pending",
            "confirmed" => "status-confirmed",
            "completed" => "status-completed",
            "cancelled" => "status-cancelled",
            _ => "status-default"
        };
    }

    string GetStatusText(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "Chờ xác nhận",
            "confirmed" => "Đã xác nhận",
            "completed" => "Hoàn thành",
            "cancelled" => "Đã hủy",
            _ => status
        };
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
