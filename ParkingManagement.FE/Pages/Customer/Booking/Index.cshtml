@page
@model ParkingManagement.FE.Pages.Customer.Booking.IndexModel

@section Styles {
    <link rel="stylesheet" href="/css/customer/bookings.css" asp-append-version="true" />
}

<div class="booking-page">
    <div class="booking-header">
        <div>
            <h1>Đơn đặt chỗ</h1>
            <p>Lịch sử đặt chỗ tại bãi gửi xe</p>
        </div>

        <a asp-page="/Customer/Booking/Create" class="btn-booking-primary">
            + Đặt chỗ mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="booking-filter">
        <button class="active">Tất cả</button>
        <button>Chờ xác nhận</button>
        <button>Đã xác nhận</button>
        <button>Đã nhận</button>
        <button>Đã hủy</button>
    </div>

    <div class="booking-list">
        @if (Model.Reservations.Any())
        {
            @foreach (var item in Model.Reservations)
            {
                <div class="booking-card">
                    <div>
                        <h3>@item.ReservationId</h3>
                        <span class="booking-status @(item.Status == "Đã hủy" ? "cancelled" : "")">@item.Status</span>
                        <p>Tạo lúc: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>

                    <div>
                        <strong>@item.VehiclePlate</strong>
                        <p>@item.VehicleType</p>
                    </div>

                    <div>
                        <strong>@(item.SlotId ?? "Chưa xếp")</strong>
                        <p>@(item.SlotLocation ?? "Vị trí đỗ")</p>
                    </div>

                    <div>
                        <p>Dự kiến: @item.ExpectedTime.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>

                    <div class="booking-actions">
                        <a asp-page="./Details" asp-route-id="@item.ReservationId" class="btn-detail">Xem chi tiết</a>

                        @if (item.Status != "Đã hủy" && item.Status != "Đã nhận")
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-reservationId="@item.ReservationId" style="display:inline;">
                                <button type="submit" class="btn-cancel">Hủy</button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>Chưa có đặt chỗ nào.</p>
                <a asp-page="./Create" class="btn-booking-primary">Đặt chỗ ngay</a>
            </div>
        }
    </div>
</div>
