@page "{id}"
@model ParkingManagement.FE.Pages.Customer.Booking.CancelModel

@section Styles {
    <link rel="stylesheet" href="/css/customer/bookings.css" asp-append-version="true" />
}

<div class="booking-page">
    <div class="booking-header">
        <div>
            <h1>Hủy đặt chỗ</h1>
            <p>Xác nhận hủy đặt chỗ của bạn</p>
        </div>

        <a asp-page="/Customer/Booking/Index" class="btn-back">
            ← Quay lại
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Reservation != null)
    {
        <div class="cancel-card">
            <div class="cancel-warning">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <h2>Bạn có chắc chắn muốn hủy đặt chỗ này?</h2>
                <p>Hành động này không thể hoàn tác.</p>
            </div>

            <div class="cancel-details">
                <h3>Thông tin đặt chỗ</h3>
                <div class="detail-row">
                    <span>Mã đặt chỗ:</span>
                    <strong>@Model.Reservation.ReservationId</strong>
                </div>
                <div class="detail-row">
                    <span>Biển số xe:</span>
                    <strong>@Model.Reservation.VehiclePlate</strong>
                </div>
                <div class="detail-row">
                    <span>Loại xe:</span>
                    <strong>@Model.Reservation.VehicleType</strong>
                </div>
                <div class="detail-row">
                    <span>Vị trí:</span>
                    <strong>@(Model.Reservation.SlotLocation ?? "Chưa phân bổ")</strong>
                </div>
                <div class="detail-row">
                    <span>Thời gian dự kiến:</span>
                    <strong>@Model.Reservation.ExpectedTime.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>

            <form method="post" class="cancel-form">
                <input type="hidden" asp-for="ReservationId" />
                
                <div class="cancel-actions">
                    <a asp-page="/Customer/Booking/Index" class="btn-secondary">
                        Không, quay lại
                    </a>
                    <button type="submit" class="btn-danger">
                        <i class="fa-solid fa-times"></i> Xác nhận hủy
                    </button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-search"></i>
            <p>Không tìm thấy thông tin đặt chỗ</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
