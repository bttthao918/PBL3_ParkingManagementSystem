@page
@model ParkingManagement.FE.Pages.Customer.MonthlyTicketModel

@{
    ViewData["Title"] = "Quản lý vé tháng";
    ViewData["UserName"] = Model.UserName;
    ViewData["Role"] = "Khách hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/monthly_ticket.css" asp-append-version="true" />
}

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage) || !string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="toast-stack" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="app-toast toast-success" data-auto-dismiss="true">
                <div class="app-toast-icon">
                    <i class="fa-solid fa-check"></i>
                </div>
                <div>
                    <strong>Thành công</strong>
                    <span>@Model.SuccessMessage</span>
                </div>
                <button type="button" class="app-toast-close" aria-label="Đóng thông báo">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="app-toast toast-error">
                <div class="app-toast-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <strong>Cần kiểm tra</strong>
                    <span>@Model.ErrorMessage</span>
                </div>
                <button type="button" class="app-toast-close" aria-label="Đóng thông báo">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
    </div>
}

@if (Model.PendingPayment != null)
{
    <section class="payment-notification" id="paymentNotice" role="dialog" aria-modal="false" aria-labelledby="paymentTitle">
        <div class="payment-notification-header">
            <div>
                <div class="payment-eyebrow">
                    <i class="fa-solid fa-qrcode"></i>
                    Mã QR đã sẵn sàng
                </div>
                <h3 id="paymentTitle">Hoàn tất thanh toán vé tháng</h3>
            </div>
            <button type="button" class="payment-notice-close" aria-label="Đóng thông báo thanh toán">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <p class="payment-description">
            Quét mã bằng app ngân hàng hoặc mở payOS. Hệ thống sẽ tự kiểm tra và kích hoạt vé sau khi nhận tiền.
        </p>

        <div class="payment-visual">
            @if (!string.IsNullOrWhiteSpace(Model.PendingPayment.QrImageUrl))
            {
                <div class="payment-qr-box">
                    <img src="@Model.PendingPayment.QrImageUrl"
                         alt="QR thanh toán vé tháng"
                         data-payment-qr
                         data-checkout-url="@Model.PendingPayment.CheckoutUrl" />
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.PendingPayment.CheckoutUrl))
            {
                <iframe class="payment-frame @(string.IsNullOrWhiteSpace(Model.PendingPayment.QrImageUrl) ? "" : "hidden payment-frame-fallback")"
                        src="@Model.PendingPayment.CheckoutUrl"
                        title="payOS checkout"></iframe>
            }
        </div>

        <div class="payment-summary">
            <div>
                <span>Mã đơn</span>
                <strong>@Model.PendingPayment.OrderCode</strong>
            </div>
            <div>
                <span>Số tiền</span>
                <strong class="payment-amount">@Model.PendingPayment.Amount.ToString("N0") đ</strong>
            </div>
            <div>
                <span>Trạng thái</span>
                <strong class="payment-state">Chờ thanh toán</strong>
            </div>
        </div>

        <div class="payment-actions">
            @if (!string.IsNullOrWhiteSpace(Model.PendingPayment.CheckoutUrl))
            {
                <a class="primary-link-btn" href="@Model.PendingPayment.CheckoutUrl" target="_blank" rel="noopener">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    Mở payOS
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(Model.PendingPayment.MonthlyTicketId))
            {
                <form method="post"
                      asp-page-handler="ConfirmPayment"
                      class="payment-check-form"
                      data-auto-confirm="true">
                    <input type="hidden" name="monthlyTicketId" value="@Model.PendingPayment.MonthlyTicketId" />
                    <button type="submit" class="payment-check-btn">
                        <i class="fa-solid fa-arrows-rotate"></i>
                        Tôi đã thanh toán
                    </button>
                </form>

                <form method="post"
                      asp-page-handler="Cancel"
                      class="payment-cancel-form"
                      data-confirm-title="Hủy vé tháng"
                      data-confirm-message="Vé tháng đang chờ thanh toán sẽ được hủy. Bạn có chắc muốn hủy vé này?"
                      data-confirm-type="warning">
                    <input type="hidden" name="ticketId" value="@Model.PendingPayment.MonthlyTicketId" />
                    <button type="submit" class="payment-cancel-btn">
                        <i class="fa-solid fa-ban"></i>
                        Hủy vé
                    </button>
                </form>
            }
        </div>

        <div class="payment-progress">
            <i class="fa-solid fa-circle-notch"></i>
            <span id="paymentCheckStatus">Hệ thống đang tự kiểm tra trạng thái thanh toán.</span>
        </div>
    </section>
}

<div class="card banner-card">
    <h2>Quản lý vé tháng</h2>
    <p>Đăng ký vé tháng, theo dõi tự động gia hạn và tắt gia hạn khi không còn nhu cầu.</p>
</div>

<section class="card monthly-vip-card">
    <div class="monthly-vip-main">
        <div class="monthly-vip-icon">
            <i class="fa-solid fa-gem"></i>
        </div>
        <div>
            <span>Hạng khách hàng</span>
            <h3>@Model.VipLevel</h3>
            <p>Tổng tích lũy @Model.TotalSpent.ToString("N0") đ từ vé tháng và các thanh toán đã ghi nhận.</p>
        </div>
    </div>

    <div class="monthly-vip-stats">
        <div>
            <span>Ưu đãi vé tháng</span>
            <strong>@Model.DiscountPercent%</strong>
        </div>
        <div>
            <span>Tiến độ hạng</span>
            <strong>@Model.VipProgress%</strong>
        </div>
        <div>
            <span>Còn thiếu</span>
            <strong>@(Model.AmountToNextLevel.HasValue ? $"{Model.AmountToNextLevel.Value:N0} đ" : "Tối đa")</strong>
        </div>
    </div>
</section>

<div class="monthly-grid">
    <div class="card monthly-plan-section">
        <div class="monthly-pricing-table pricing-card-table" data-pricing-table>
            <div class="customer-pricing-heading">
                <div class="pricing-heading-copy">
                    <div class="pricing-heading-icon">
                        <i class="fa-solid fa-tags"></i>
                    </div>
                    <div>
                        <span>1. Bảng giá vé tháng</span>
                        <h3>Chọn gói vé phù hợp</h3>
                        <p>Giá lấy trực tiếp từ bảng giá quản trị, đã áp dụng ưu đãi theo hạng khách hàng.</p>
                    </div>
                </div>

                <div class="pricing-rank-pill">
                    <i class="fa-solid fa-gem"></i>
                    @Model.VipLevel - giảm @Model.DiscountPercent%
                </div>
            </div>

            <div class="duration-tabs" role="tablist" aria-label="Thời hạn vé tháng">
                <button type="button" class="duration-tab active" data-duration-tab="1">1 tháng</button>
                <button type="button" class="duration-tab" data-duration-tab="3">3 tháng</button>
                <button type="button" class="duration-tab" data-duration-tab="6">6 tháng</button>
            </div>

            @foreach (var duration in new[] { 1, 3, 6 })
            {
                <div class="pricing-card-grid @(duration == 1 ? "" : "hidden")" data-duration-panel="@duration">
                    @foreach (var plan in Model.Plans.Where(plan => plan.Months == duration))
                    {
                        var monthlyPrice = duration > 0 ? Math.Round(plan.Price / duration) : plan.Price;
                        var monthlySaving = Math.Max(0, plan.OneMonthPrice - monthlyPrice);

                        <article class="pricing-plan-card @plan.IconClass @(plan.IsSelected ? "selected" : "")" onclick="selectPricingCard(this)">
                            <div class="popular-badge @(plan.IsSelected ? "" : "hidden")">
                                <i class="fa-solid fa-star"></i>
                                Phổ biến
                            </div>

                            <div class="pricing-plan-header">
                                <div class="pricing-icon @plan.IconClass">
                                    <i class="@plan.Icon"></i>
                                </div>
                                <div>
                                    <h4>@plan.Name</h4>
                                    <p>@plan.SubTitle</p>
                                </div>
                            </div>

                            <div class="pricing-price-row">
                                @if (plan.VipDiscountAmount > 0)
                                {
                                    <div class="pricing-vip-discount">
                                        <i class="fa-solid fa-gem"></i>
                                        Ưu đãi @Model.VipLevel giảm @plan.VipDiscountAmount.ToString("N0") đ
                                    </div>
                                    <div class="pricing-original-price">@plan.OriginalPrice.ToString("N0") đ</div>
                                }

                                <div class="pricing-main-price">@monthlyPrice.ToString("N0") đ</div>
                                <div class="pricing-unit">/ tháng@(duration > 1 ? $" x {duration} tháng" : "")</div>

                                @if (duration > 1 && monthlySaving > 0)
                                {
                                    <div class="pricing-monthly-saving">Tiết kiệm @monthlySaving.ToString("N0") đ/tháng so với mua lẻ</div>
                                }

                                @if (duration > 1)
                                {
                                    <div class="pricing-total">Tổng thanh toán: <strong>@plan.Price.ToString("N0") đ</strong></div>
                                }
                            </div>

                            <hr />

                            <ul class="pricing-features">
                                <li><i class="fa-solid fa-circle-check"></i> Gửi xe không giới hạn</li>
                                <li><i class="fa-solid fa-circle-check"></i> Áp dụng theo biển số xe</li>
                                <li><i class="fa-solid fa-circle-check"></i> Ra vào tự do</li>
                            </ul>

                            <button type="button"
                                    class="pricing-register-btn @(plan.IsSelected ? "primary" : "outline")"
                                    onclick="event.stopPropagation(); openRegisterModal('@plan.VehicleType', '@plan.PackageType')">
                                <i class="fa-solid fa-qrcode"></i>
                                Đăng ký ngay
                            </button>
                        </article>
                    }
                </div>

                @if (duration > 1)
                {
                    var durationSaving = Model.Plans
                        .Where(plan => plan.Months == duration)
                        .Select(plan => Math.Max(0, (plan.OneMonthPrice * duration) - plan.Price))
                        .DefaultIfEmpty(0)
                        .Max();

                    <p class="savings-note hidden" data-duration-note="@duration">
                        @if (durationSaving > 0)
                        {
                            <text>Tiết kiệm đến <span>@durationSaving.ToString("N0") đ</span> khi mua gói @duration tháng</text>
                        }
                    </p>
                }
            }

            <div class="note-box pricing-data-note">
                <i class="fa-solid fa-circle-info"></i>
                Giá trên lấy trực tiếp từ bảng giá quản trị và đã bao gồm VAT
            </div>
        </div>

        <div class="monthly-pricing-table pricing-vehicle-summary" aria-hidden="true">
            <div class="pricing-overview-header">
                <div>
                    <span>1. Bảng giá vé tháng</span>
                    <h3>Chọn loại xe và thời hạn</h3>
                    <p>Giá lấy từ bảng giá quản trị, đã áp dụng ưu đãi theo hạng khách hàng.</p>
                </div>

                <strong>@Model.VipLevel - giảm @Model.DiscountPercent%</strong>
            </div>

            <div class="pricing-vehicle-grid">
                @foreach (var group in Model.Plans.GroupBy(plan => plan.VehicleType))
                {
                    var firstPlan = group.OrderBy(plan => plan.Months).First();
                    var oneMonthPlan = group.FirstOrDefault(plan => plan.Months == 1) ?? firstPlan;

                    <article class="pricing-vehicle-card @firstPlan.IconClass">
                        <div class="pricing-vehicle-header">
                            <div class="pricing-vehicle-icon @firstPlan.IconClass">
                                <i class="@firstPlan.Icon"></i>
                            </div>
                            <div>
                                <h4>@firstPlan.Name</h4>
                                <p>@firstPlan.SubTitle</p>
                            </div>
                        </div>

                        <div class="pricing-vehicle-price">
                            <span>Từ</span>
                            <strong>@oneMonthPlan.Price.ToString("N0") đ</strong>
                            <small>/ tháng</small>
                        </div>

                        <div class="pricing-package-list">
                            @foreach (var plan in group.OrderBy(plan => plan.Months))
                            {
                                var monthlyPrice = plan.Months > 0 ? Math.Round(plan.Price / plan.Months) : plan.Price;
                                var saving = Math.Max(0, (plan.OneMonthPrice * plan.Months) - plan.Price);

                                <div class="pricing-package-row">
                                    <div class="pricing-package-copy">
                                        <b>@plan.PackageType</b>
                                        <span>@monthlyPrice.ToString("N0") đ/tháng</span>
                                        @if (plan.VipDiscountAmount > 0)
                                        {
                                            <em>VIP giảm @plan.VipDiscountAmount.ToString("N0") đ</em>
                                        }
                                        else if (saving > 0)
                                        {
                                            <em>Tiết kiệm @saving.ToString("N0") đ</em>
                                        }
                                    </div>
                                    <div class="pricing-package-action">
                                        <strong>@plan.Price.ToString("N0") đ</strong>
                                        <button type="button" onclick="openRegisterModal('@plan.VehicleType', '@plan.PackageType')">
                                            Đăng ký
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>

            <div class="note-box pricing-data-note">
                <i class="fa-solid fa-circle-info"></i>
                Giá trên lấy trực tiếp từ bảng giá quản trị và đã bao gồm VAT
            </div>
        </div>
        <h3>1. Chọn gói vé phù hợp</h3>

        <div class="plan-grid">
            @foreach (var plan in Model.Plans)
            {
                <div class="plan-card @(plan.IsSelected ? "selected" : "")">
                    <div class="plan-header">
                        <div class="radio @(plan.IsSelected ? "checked" : "")"></div>

                        <div class="plan-icon @plan.IconClass">
                            <i class="@plan.Icon"></i>
                        </div>

                        <div>
                            <h4>@plan.Name</h4>

                            <h2>
                                @plan.Price.ToString("N0") đ
                                <span>/ tháng</span>
                            </h2>
                        </div>
                    </div>

                    <div class="plan-features">
                        <p><i class="fa-solid fa-check"></i> Giữ xe không giới hạn trong 1 tháng</p>
                        <p><i class="fa-solid fa-check"></i> Áp dụng theo biển số xe đăng ký</p>
                        <p><i class="fa-solid fa-check"></i> Ra vào tự do</p>
                    </div>

                    <button type="button"
                            class="outline-btn @(plan.IsSelected ? "selected" : "")"
                            onclick="openRegisterModal('@plan.VehicleType', '@plan.PackageType')">
                        Đăng ký ngay
                    </button>
                </div>
            }
        </div>

        <div class="note-box">
            <i class="fa-solid fa-circle-info"></i>
            Giá trên đã bao gồm VAT
        </div>
    </div>

    <div class="card">
        <h3>2. Vé tháng hiện tại</h3>

        @if (Model.CurrentTicket == null)
        {
            <div class="empty-ticket">
                Bạn chưa có vé tháng đang hoạt động.
            </div>
        }
        else
        {
            var currentPackageSubText = Model.GetPackageSubText(Model.CurrentTicket);
            <div class="current-ticket">
                <div class="ticket-status">
                    <i class="fa-solid fa-circle-check"></i>
                    @Model.GetStatusText(Model.CurrentTicket)
                </div>

                <div class="ticket-content">
                    <div class="ticket-header">
                        <div class="ticket-icon">
                            <i class="fa-solid fa-motorcycle"></i>
                        </div>

                        <div>
                            <h4>@Model.GetPackageDisplayText(Model.CurrentTicket)</h4>
                            <p>Mã vé: @Model.CurrentTicket.MonthlyTicketId</p>
                            @if (!string.IsNullOrWhiteSpace(currentPackageSubText))
                            {
                                <p class="package-note">@currentPackageSubText</p>
                            }
                        </div>
                    </div>

                    <div class="ticket-row">
                        <span>Biển số</span>
                        <strong>@Model.CurrentTicket.VehiclePlate</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Ngày bắt đầu</span>
                        <strong>@Model.CurrentTicket.StartDate.ToString("dd/MM/yyyy")</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Ngày hết hạn</span>
                        <strong>@Model.CurrentTicket.EndDate.ToString("dd/MM/yyyy")</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Còn lại</span>
                        <strong class="green-text">@Model.CurrentTicket.DaysRemaining ngày</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Giá trị</span>
                        <strong>@Model.CurrentTicket.TotalFee.ToString("N0") đ</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Tự động gia hạn</span>
                        <strong class="@(Model.CurrentTicket.AutoRenew ? "green-text" : "")">@Model.GetAutoRenewText(Model.CurrentTicket)</strong>
                    </div>

                    @if (Model.CurrentTicket.AutoRenew)
                    {
                        <form method="post"
                              asp-page-handler="Cancel"
                              data-confirm-title="Hủy tự động gia hạn"
                              data-confirm-message="Vé vẫn dùng được đến @Model.CurrentTicket.EndDate.ToString("dd/MM/yyyy"). Bạn có chắc muốn tắt tự động gia hạn cho vé @Model.CurrentTicket.MonthlyTicketId?"
                              data-confirm-type="warning">
                            <input type="hidden" name="ticketId" value="@Model.CurrentTicket.MonthlyTicketId" />

                            <button type="submit" class="danger-btn">
                                <i class="fa-solid fa-bell-slash"></i>
                                Hủy tự động gia hạn
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <h3>3. Lịch sử vé tháng</h3>

    <table class="ticket-table">
        <thead>
            <tr>
                <th>Mã vé</th>
                <th>Biển số</th>
                <th>Gói vé</th>
                <th>Thời gian</th>
                <th>Hiệu lực</th>
                <th>Giá trị</th>
                <th>Tự gia hạn</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.TicketHistories.Any())
            {
                @foreach (var ticket in Model.TicketHistories)
                {
                    var isActive = Model.IsActive(ticket);
                    var isPending = Model.IsPending(ticket);
                    var packageSubText = Model.GetPackageSubText(ticket);
                    <tr>
                        <td>@ticket.MonthlyTicketId</td>
                        <td>@ticket.VehiclePlate</td>
                        <td class="package-cell">
                            <strong>@Model.GetPackageDisplayText(ticket)</strong>
                            @if (!string.IsNullOrWhiteSpace(packageSubText))
                            {
                                <small>@packageSubText</small>
                            }
                        </td>
                        <td>
                            @ticket.StartDate.ToString("dd/MM/yyyy")
                            -
                            @ticket.EndDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @(isActive ? $"{ticket.DaysRemaining} ngày" : "-")
                        </td>

                        <td>@ticket.TotalFee.ToString("N0") đ</td>

                        <td>@Model.GetAutoRenewText(ticket)</td>

                        <td>
                            <span class="status-badge @(isActive ? "active" : isPending ? "pending" : "expired")">
                                @Model.GetStatusText(ticket)
                            </span>
                        </td>

                        <td class="action-column">
                            @if (isPending)
                            {
                                <form method="post" asp-page-handler="ShowPayment">
                                    <input type="hidden" name="ticketId" value="@ticket.MonthlyTicketId" />

                                    <button type="submit" class="icon-btn blue" title="In lại mã QR">
                                        <i class="fa-solid fa-qrcode"></i>
                                    </button>
                                </form>

                                <form method="post"
                                      asp-page-handler="Cancel"
                                      data-confirm-title="Hủy vé tháng"
                                      data-confirm-message="Vé @ticket.MonthlyTicketId đang chờ thanh toán sẽ được hủy. Bạn có chắc muốn hủy vé này?"
                                      data-confirm-type="warning">
                                    <input type="hidden" name="ticketId" value="@ticket.MonthlyTicketId" />

                                    <button type="submit" class="icon-btn red" title="Hủy vé">
                                        <i class="fa-solid fa-ban"></i>
                                    </button>
                                </form>
                            }

                            else if (isActive)
                            {
                                @if (ticket.AutoRenew)
                                {
                                    <form method="post"
                                          asp-page-handler="Cancel"
                                          data-confirm-title="Hủy tự động gia hạn"
                                          data-confirm-message="Vé vẫn dùng được đến @ticket.EndDate.ToString("dd/MM/yyyy"). Bạn có chắc muốn tắt tự động gia hạn cho vé @ticket.MonthlyTicketId?"
                                          data-confirm-type="warning">
                                        <input type="hidden" name="ticketId" value="@ticket.MonthlyTicketId" />

                                        <button type="submit" class="icon-btn red" title="Hủy tự động gia hạn">
                                            <i class="fa-solid fa-bell-slash"></i>
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Reorder">
                                    <input type="hidden" name="vehiclePlate" value="@ticket.VehiclePlate" />
                                    <input type="hidden" name="vehicleType" value="@ticket.VehicleType" />
                                    <input type="hidden" name="packageType" value="@ticket.PackageType" />

                                    <button type="submit" class="icon-btn blue" title="Đặt lại vé">
                                        <i class="fa-solid fa-rotate-right"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9">Chưa có lịch sử vé tháng.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="note-box">
        <i class="fa-solid fa-circle-info"></i>
        Nếu có thắc mắc, vui lòng liên hệ hotline 1900 1234 hoặc email support@parking.vn để được hỗ trợ.
    </div>
</div>

<div id="registerModal" class="modal-overlay hidden">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Đăng ký vé tháng</h3>
            <button type="button" class="modal-close" onclick="closeRegisterModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="post" asp-page-handler="Register" class="register-form" id="registerForm">
            <input asp-for="RegisterInput.VehicleType" type="hidden" id="registerVehicleType" />
            <input asp-for="RegisterInput.PackageType" type="hidden" id="registerPackageType" />

            <label>
                <span>Biển số xe</span>
                <input asp-for="RegisterInput.VehiclePlate" id="registerPlateInput" placeholder="43A-123.45" />
                <span asp-validation-for="RegisterInput.VehiclePlate" class="field-validation"></span>
            </label>

            <label>
                <span>Thanh toán</span>
                <select asp-for="RegisterInput.PaymentMethod">
                    <option value="Chuyển khoản">VietQR / MB Bank</option>
                </select>
                <span asp-validation-for="RegisterInput.PaymentMethod" class="field-validation"></span>
            </label>

            <button type="submit" class="primary-btn" id="registerSubmitBtn">
                <i class="fa-solid fa-qrcode"></i>
                Thanh toán & Đăng ký
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        document.querySelectorAll("[data-pricing-table]").forEach(function (table) {
            table.querySelectorAll("[data-duration-tab]").forEach(function (tab) {
                tab.addEventListener("click", function () {
                    const duration = tab.dataset.durationTab;
                    table.querySelectorAll("[data-duration-tab]").forEach(function (item) {
                        item.classList.toggle("active", item === tab);
                    });
                    table.querySelectorAll("[data-duration-panel]").forEach(function (panel) {
                        panel.classList.toggle("hidden", panel.dataset.durationPanel !== duration);
                    });
                    table.querySelectorAll("[data-duration-note]").forEach(function (note) {
                        note.classList.toggle("hidden", note.dataset.durationNote !== duration);
                    });
                });
            });
        });

        function selectPricingCard(card) {
            const panel = card.closest("[data-duration-panel]");
            if (!panel) return;
            panel.querySelectorAll(".pricing-plan-card").forEach(function (item) {
                const selected = item === card;
                item.classList.toggle("selected", selected);
                const button = item.querySelector(".pricing-register-btn");
                if (button) {
                    button.classList.toggle("primary", selected);
                    button.classList.toggle("outline", !selected);
                }
            });
        }

        // Bank config for QR generation (VietQR)
        const BANK_CONFIG = {
            bankId: "970436",          // Vietcombank BIN
            accountNo: "1234567890",
            accountName: "BAI XE THONG MINH",
            bankName: "Vietcombank",
            template: "compact2"
        };

        let paymentAutoCheckTimer;
        let paymentAutoCheckInterval;


        function dismissToast(toast) {
            if (!toast) {
                return;
            }

            const stack = toast.closest(".toast-stack");
            toast.classList.add("is-hidden");
            window.setTimeout(() => {
                toast.remove();
                if (stack && !stack.querySelector(".app-toast")) {
                    stack.remove();
                }
            }, 220);
        }

        function closePaymentNotice() {
            const notice = document.getElementById("paymentNotice");
            if (!notice) {
                return;
            }

            notice.classList.add("is-hidden");
            window.clearTimeout(paymentAutoCheckTimer);
            window.clearInterval(paymentAutoCheckInterval);
            window.setTimeout(() => notice.remove(), 240);
        }

        function openRegisterModal(vehicleType, packageType) {
            document.getElementById("registerVehicleType").value = vehicleType;
            document.getElementById("registerPackageType").value = packageType;
            document.getElementById("registerModal").classList.remove("hidden");
        }

        function closeRegisterModal() {
            document.getElementById("registerModal").classList.add("hidden");
        }

        document.addEventListener("click", (event) => {
            const toastCloseButton = event.target.closest(".app-toast-close");
            if (toastCloseButton) {
                dismissToast(toastCloseButton.closest(".app-toast"));
                return;
            }

            if (event.target.closest(".payment-notice-close")) {
                closePaymentNotice();
            }
        });

        document.querySelectorAll(".app-toast[data-auto-dismiss='true']").forEach((toast) => {
            window.setTimeout(() => dismissToast(toast), 5200);
        });

        const paymentNotice = document.getElementById("paymentNotice");
        if (paymentNotice) {
            window.setTimeout(() => paymentNotice.classList.add("is-soft"), 7000);
        }

        document.querySelectorAll("[data-payment-qr]").forEach((image) => {
            image.addEventListener("error", () => {
                const qrBox = image.closest(".payment-qr-box");
                const fallbackFrame = document.querySelector(".payment-frame-fallback");
                qrBox?.classList.add("hidden");
                fallbackFrame?.classList.remove("hidden", "payment-frame-fallback");
            }, { once: true });
        });

        const payOsConfirmForm = document.querySelector("[data-auto-confirm='true']");
        if (payOsConfirmForm) {
            const statusElement = document.querySelector(".payment-progress span");
            const statusIcon = document.querySelector(".payment-progress i");
            const submitButton = payOsConfirmForm.querySelector(".payment-check-btn");
            const submitButtonDefaultHtml = submitButton?.innerHTML;
            let isCheckingPayment = false;

            async function confirmPayOsPayment(showPendingText) {
                if (isCheckingPayment) {
                    if (showPendingText && statusElement) {
                        statusElement.textContent = "Đang kiểm tra trạng thái thanh toán...";
                    }
                    return;
                }

                isCheckingPayment = true;
                if (submitButton && showPendingText) {
                    submitButton.disabled = true;
                    submitButton.classList.add("is-loading");
                    submitButton.innerHTML = '<i class="fa-solid fa-arrows-rotate"></i> Đang kiểm tra';
                }
                statusIcon?.classList.remove("fa-circle-info", "fa-triangle-exclamation");
                statusIcon?.classList.add("fa-circle-notch");
                if (showPendingText && statusElement) {
                    statusElement.textContent = "Đang kiểm tra trạng thái thanh toán...";
                }

                const controller = new AbortController();
                const timeoutId = window.setTimeout(() => controller.abort(), 9000);

                try {
                    const response = await fetch(payOsConfirmForm.action, {
                        method: "POST",
                        body: new FormData(payOsConfirmForm),
                        signal: controller.signal,
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });
                    const result = await response.json().catch(() => ({
                        success: false,
                        message: "Chưa kiểm tra được trạng thái thanh toán. Vui lòng thử lại."
                    }));

                    if (result.success) {
                        if (statusElement) {
                            statusElement.textContent = result.message || "Thanh toán đã được xác nhận.";
                        }
                        paymentNotice?.classList.remove("is-soft");
                        paymentNotice?.classList.add("is-success");
                        window.setTimeout(() => window.location.reload(), 900);
                        return;
                    }

                    if (showPendingText && statusElement) {
                        statusElement.textContent = result.message || "Chưa ghi nhận thanh toán. Vui lòng thanh toán rồi kiểm tra lại.";
                        statusIcon?.classList.remove("fa-circle-notch");
                        statusIcon?.classList.add("fa-circle-info");
                    }
                } catch (error) {
                    if (showPendingText && statusElement) {
                        statusElement.textContent = error?.name === "AbortError"
                            ? "Kiểm tra hơi lâu. Vui lòng thử lại sau vài giây."
                            : "Chưa kiểm tra được trạng thái thanh toán. Vui lòng thử lại.";
                        statusIcon?.classList.remove("fa-circle-notch");
                        statusIcon?.classList.add("fa-triangle-exclamation");
                    }
                } finally {
                    window.clearTimeout(timeoutId);
                    isCheckingPayment = false;
                    if (submitButton && showPendingText) {
                        submitButton.disabled = false;
                        submitButton.classList.remove("is-loading");
                        if (submitButtonDefaultHtml) {
                            submitButton.innerHTML = submitButtonDefaultHtml;
                        }
                    }
                }
            }

            payOsConfirmForm.addEventListener("submit", (event) => {
                event.preventDefault();
                confirmPayOsPayment(true);
            });

            paymentAutoCheckTimer = window.setTimeout(() => confirmPayOsPayment(false), 4000);
            paymentAutoCheckInterval = window.setInterval(() => confirmPayOsPayment(false), 8000);
        }
    </script>
}
