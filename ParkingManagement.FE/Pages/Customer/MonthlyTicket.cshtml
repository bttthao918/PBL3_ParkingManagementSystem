@page
@model ParkingManagement.FE.Pages.Customer.MonthlyTicketModel

@{
    ViewData["Title"] = "Quản lý vé tháng";
    ViewData["UserName"] = Model.UserName;
    ViewData["Role"] = "Khách hàng";
}

<link rel="stylesheet" href="/css/customer/monthly_ticket.css" />

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="card success-card">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="card error-card">
        @Model.ErrorMessage
    </div>
}

<div class="card banner-card">
    <h2>Quản lý vé tháng</h2>
    <p>Đăng ký, gia hạn hoặc hủy vé tháng một cách dễ dàng và nhanh chóng.</p>
</div>

<div class="monthly-grid">
    <div class="card monthly-plan-section">
        <div class="monthly-pricing-table" data-pricing-table>
            <h3>1. Chọn gói vé phù hợp</h3>

            <div class="duration-tabs" role="tablist" aria-label="Thời hạn vé tháng">
                <button type="button" class="duration-tab active" data-duration-tab="1">1 tháng</button>
                <button type="button" class="duration-tab" data-duration-tab="3">3 tháng</button>
                <button type="button" class="duration-tab" data-duration-tab="6">6 tháng</button>
            </div>

            @foreach (var duration in new[] { 1, 3, 6 })
            {
                <div class="pricing-card-grid @(duration == 1 ? "" : "hidden")" data-duration-panel="@duration">
                    @foreach (var plan in Model.Plans.Where(plan => plan.Months == duration))
                    {
                        var monthlyPrice = duration > 0 ? Math.Round(plan.Price / duration) : plan.Price;
                        var monthlySaving = Math.Max(0, plan.OneMonthPrice - monthlyPrice);

                        <article class="pricing-plan-card @(plan.IsSelected ? "selected" : "")" onclick="selectPricingCard(this)">
                            <div class="popular-badge @(plan.IsSelected ? "" : "hidden")">Phổ biến</div>
                            <div class="pricing-plan-header">
                                <div class="pricing-icon @plan.IconClass">
                                    <i class="@plan.Icon"></i>
                                </div>
                                <div>
                                    <h4>@plan.Name</h4>
                                    <p>@plan.SubTitle</p>
                                </div>
                            </div>

                            <div class="pricing-price-row">
                                <div class="pricing-main-price">@monthlyPrice.ToString("N0") đ</div>
                                <div class="pricing-unit">/ tháng@(duration > 1 ? $" × {duration} tháng" : "")</div>
                                @if (duration > 1 && monthlySaving > 0)
                                {
                                    <div class="pricing-monthly-saving">Tiết kiệm @monthlySaving.ToString("N0") đ/tháng so với mua lẻ</div>
                                }
                                @if (duration > 1)
                                {
                                    <div class="pricing-total">Tổng thanh toán: <strong>@plan.Price.ToString("N0") đ</strong></div>
                                }
                            </div>

                            <hr />

                            <ul class="pricing-features">
                                <li><i class="fa-solid fa-circle-check"></i> Gửi xe không giới hạn</li>
                                <li><i class="fa-solid fa-circle-check"></i> Áp dụng theo biển số xe</li>
                                <li><i class="fa-solid fa-circle-check"></i> Ra vào tự do</li>
                            </ul>

                            <button type="button"
                                    class="pricing-register-btn @(plan.IsSelected ? "primary" : "outline")"
                                    onclick="event.stopPropagation(); openRegisterModal('@plan.VehicleType', '@plan.PackageType')">
                                Đăng ký ngay
                            </button>
                        </article>
                    }
                </div>

                @if (duration > 1)
                {
                    var durationSaving = Model.Plans
                        .Where(plan => plan.Months == duration)
                        .Select(plan => Math.Max(0, (plan.OneMonthPrice * duration) - plan.Price))
                        .DefaultIfEmpty(0)
                        .Max();

                    <p class="savings-note hidden" data-duration-note="@duration">
                        @if (durationSaving > 0)
                        {
                            <text>Tiết kiệm đến <span>@durationSaving.ToString("N0") đ</span> khi mua gói @duration tháng</text>
                        }
                    </p>
                }
            }

            <div class="note-box pricing-data-note">
                <i class="fa-solid fa-circle-info"></i>
                Giá trên lấy trực tiếp từ bảng giá quản trị và đã bao gồm VAT
            </div>
        </div>
        <h3>1. Chọn gói vé phù hợp</h3>

        <div class="plan-grid">
            @foreach (var plan in Model.Plans)
            {
                <div class="plan-card @(plan.IsSelected ? "selected" : "")">
                    <div class="plan-header">
                        <div class="radio @(plan.IsSelected ? "checked" : "")"></div>

                        <div class="plan-icon @plan.IconClass">
                            <i class="@plan.Icon"></i>
                        </div>

                        <div>
                            <h4>@plan.Name</h4>

                            <h2>
                                @plan.Price.ToString("N0") đ
                                <span>/ tháng</span>
                            </h2>
                        </div>
                    </div>

                    <div class="plan-features">
                        <p><i class="fa-solid fa-check"></i> Giữ xe không giới hạn trong 1 tháng</p>
                        <p><i class="fa-solid fa-check"></i> Áp dụng theo biển số xe đăng ký</p>
                        <p><i class="fa-solid fa-check"></i> Ra vào tự do</p>
                    </div>

                    <button type="button"
                            class="outline-btn @(plan.IsSelected ? "selected" : "")"
                            onclick="openRegisterModal('@plan.VehicleType', '@plan.PackageType')">
                        Đăng ký ngay
                    </button>
                </div>
            }
        </div>

        <div class="note-box">
            <i class="fa-solid fa-circle-info"></i>
            Giá trên đã bao gồm VAT
        </div>
    </div>

    <div class="card">
        <h3>2. Vé tháng hiện tại</h3>

        @if (Model.CurrentTicket == null)
        {
            <div class="empty-ticket">
                Bạn chưa có vé tháng đang hoạt động.
            </div>
        }
        else
        {
            <div class="current-ticket">
                <div class="ticket-status">
                    <i class="fa-solid fa-circle-check"></i>
                    @Model.GetStatusText(Model.CurrentTicket)
                </div>

                <div class="ticket-content">
                    <div class="ticket-header">
                        <div class="ticket-icon">
                            <i class="fa-solid fa-motorcycle"></i>
                        </div>

                        <div>
                            <h4>@Model.CurrentTicket.PackageType</h4>
                            <p>Mã vé: @Model.CurrentTicket.MonthlyTicketId</p>
                        </div>
                    </div>

                    <div class="ticket-row">
                        <span>Biển số</span>
                        <strong>@Model.CurrentTicket.VehiclePlate</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Ngày bắt đầu</span>
                        <strong>@Model.CurrentTicket.StartDate.ToString("dd/MM/yyyy")</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Ngày hết hạn</span>
                        <strong>@Model.CurrentTicket.EndDate.ToString("dd/MM/yyyy")</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Còn lại</span>
                        <strong class="green-text">@Model.CurrentTicket.DaysRemaining ngày</strong>
                    </div>

                    <div class="ticket-row">
                        <span>Giá trị</span>
                        <strong>@Model.CurrentTicket.TotalFee.ToString("N0") đ</strong>
                    </div>

                    <form method="post" asp-page-handler="Renew">
                        <input type="hidden" name="ticketId" value="@Model.CurrentTicket.MonthlyTicketId" />
                        <input type="hidden" name="packageType" value="1 tháng" />
                        <input type="hidden" name="paymentMethod" value="Chuyển khoản" />

                        <button type="submit" class="primary-btn">
                            <i class="fa-solid fa-rotate"></i>
                            Gia hạn vé
                        </button>
                    </form>

                    <form method="post" asp-page-handler="Cancel">
                        <input type="hidden" name="ticketId" value="@Model.CurrentTicket.MonthlyTicketId" />

                        <button type="submit" class="danger-btn">
                            <i class="fa-solid fa-circle-xmark"></i>
                            Hủy vé
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <h3>3. Lịch sử vé tháng</h3>

    <table class="ticket-table">
        <thead>
            <tr>
                <th>Mã vé</th>
                <th>Biển số</th>
                <th>Gói vé</th>
                <th>Thời gian</th>
                <th>Hiệu lực</th>
                <th>Giá trị</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.TicketHistories.Any())
            {
                @foreach (var ticket in Model.TicketHistories)
                {
                    var isActive = Model.IsActive(ticket);
                    <tr>
                        <td>@ticket.MonthlyTicketId</td>
                        <td>@ticket.VehiclePlate</td>
                        <td>@ticket.PackageType</td>
                        <td>
                            @ticket.StartDate.ToString("dd/MM/yyyy")
                            -
                            @ticket.EndDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @(isActive ? $"{ticket.DaysRemaining} ngày" : "-")
                        </td>

                        <td>@ticket.TotalFee.ToString("N0") đ</td>

                        <td>
                            <span class="status-badge @(isActive ? "active" : "expired")">
                                @Model.GetStatusText(ticket)
                            </span>
                        </td>

                        <td class="action-column">
                            <form method="post" asp-page-handler="Renew">
                                <input type="hidden" name="ticketId" value="@ticket.MonthlyTicketId" />
                                <input type="hidden" name="packageType" value="1 tháng" />
                                <input type="hidden" name="paymentMethod" value="Chuyển khoản" />

                                <button type="submit" class="icon-btn blue" title="Gia hạn 1 tháng">
                                    <i class="fa-solid fa-rotate"></i>
                                </button>
                            </form>

                            @if (isActive)
                            {
                                <form method="post" asp-page-handler="Cancel">
                                    <input type="hidden" name="ticketId" value="@ticket.MonthlyTicketId" />

                                    <button type="submit" class="icon-btn red" title="Hủy vé">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">Chưa có lịch sử vé tháng.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="note-box">
        <i class="fa-solid fa-circle-info"></i>
        Nếu có thắc mắc, vui lòng liên hệ hotline 1900 1234 hoặc email support@parking.vn để được hỗ trợ.
    </div>
</div>

<div id="registerModal" class="modal-overlay hidden">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Đăng ký vé tháng</h3>
            <button type="button" class="modal-close" onclick="closeRegisterModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="post" asp-page-handler="Register" class="register-form" id="registerForm">
            <input asp-for="RegisterInput.VehicleType" type="hidden" id="registerVehicleType" />
            <input asp-for="RegisterInput.PackageType" type="hidden" id="registerPackageType" />

            <label>
                <span>Biển số xe</span>
                <input asp-for="RegisterInput.VehiclePlate" id="registerPlateInput" placeholder="43A-123.45" />
                <span asp-validation-for="RegisterInput.VehiclePlate" class="field-validation"></span>
            </label>

            <label>
                <span>Phương thức thanh toán</span>
                <select asp-for="RegisterInput.PaymentMethod" id="paymentMethodSelect">
                    <option value="Chuyển khoản">Chuyển khoản ngân hàng (QR)</option>
                    <option value="Ví điện tử">Ví điện tử (MoMo / ZaloPay)</option>
                </select>
                <span asp-validation-for="RegisterInput.PaymentMethod" class="field-validation"></span>
            </label>

            <p id="registerError" class="form-error-msg hidden"></p>

            <button type="button" class="primary-btn" id="registerSubmitBtn" onclick="handleRegisterSubmit()">
                <i class="fa-solid fa-qrcode"></i>
                Thanh toán & Đăng ký
            </button>
        </form>
    </div>
</div>

<!-- QR Payment Modal -->
<div id="qrPaymentModal" class="modal-overlay hidden">
    <div class="modal-card qr-modal-card">
        <div class="modal-header">
            <h3><i class="fa-solid fa-qrcode"></i> Thanh toán chuyển khoản</h3>
            <button type="button" class="modal-close" onclick="closeQrModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="qr-payment-content">
            <div class="qr-info-header">
                <p>Quét mã QR bằng app ngân hàng để thanh toán</p>
            </div>

            <div class="qr-code-wrapper">
                <img id="qrCodeImage" src="" alt="QR Code thanh toán" />
            </div>

            <div class="qr-details">
                <div class="qr-detail-row">
                    <span>Ngân hàng</span>
                    <strong id="qrBankName">Vietcombank</strong>
                </div>
                <div class="qr-detail-row">
                    <span>Số tài khoản</span>
                    <strong id="qrAccountNo">1234567890</strong>
                </div>
                <div class="qr-detail-row">
                    <span>Chủ tài khoản</span>
                    <strong id="qrAccountName">BAI XE THONG MINH</strong>
                </div>
                <div class="qr-detail-row">
                    <span>Số tiền</span>
                    <strong id="qrAmount" class="qr-amount">0 đ</strong>
                </div>
                <div class="qr-detail-row">
                    <span>Nội dung CK</span>
                    <strong id="qrContent">-</strong>
                </div>
            </div>

            <div class="qr-actions">
                <button type="button" class="secondary-btn" onclick="closeQrModal()">
                    Hủy bỏ
                </button>
                <button type="button" class="primary-btn" id="confirmPaidBtn" onclick="confirmQrPayment()">
                    <i class="fa-solid fa-check-circle"></i>
                    Đã thanh toán
                </button>
            </div>

            <p class="qr-note">
                <i class="fa-solid fa-circle-info"></i>
                Sau khi chuyển khoản thành công, nhấn "Đã thanh toán" để hoàn tất đăng ký.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll("[data-pricing-table]").forEach(function (table) {
            table.querySelectorAll("[data-duration-tab]").forEach(function (tab) {
                tab.addEventListener("click", function () {
                    const duration = tab.dataset.durationTab;
                    table.querySelectorAll("[data-duration-tab]").forEach(function (item) {
                        item.classList.toggle("active", item === tab);
                    });
                    table.querySelectorAll("[data-duration-panel]").forEach(function (panel) {
                        panel.classList.toggle("hidden", panel.dataset.durationPanel !== duration);
                    });
                    table.querySelectorAll("[data-duration-note]").forEach(function (note) {
                        note.classList.toggle("hidden", note.dataset.durationNote !== duration);
                    });
                });
            });
        });

        function selectPricingCard(card) {
            const panel = card.closest("[data-duration-panel]");
            if (!panel) return;
            panel.querySelectorAll(".pricing-plan-card").forEach(function (item) {
                const selected = item === card;
                item.classList.toggle("selected", selected);
                const button = item.querySelector(".pricing-register-btn");
                if (button) {
                    button.classList.toggle("primary", selected);
                    button.classList.toggle("outline", !selected);
                }
            });
        }

        // Bank config for QR generation (VietQR)
        const BANK_CONFIG = {
            bankId: "970436",          // Vietcombank BIN
            accountNo: "1234567890",
            accountName: "BAI XE THONG MINH",
            bankName: "Vietcombank",
            template: "compact2"
        };

        // Plan prices
        const PLAN_PRICES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Plans
                .GroupBy(plan => plan.VehicleType)
                .ToDictionary(
                    group => group.Key,
                    group => group.ToDictionary(plan => plan.PackageType, plan => plan.Price))));

        let currentAmount = 0;

        function openRegisterModal(vehicleType, packageType) {
            document.getElementById("registerVehicleType").value = vehicleType;
            document.getElementById("registerPackageType").value = packageType;
            document.getElementById("registerModal").classList.remove("hidden");
            hideError();
            currentAmount = PLAN_PRICES[vehicleType]?.[packageType] || 0;
        }

        function closeRegisterModal() {
            document.getElementById("registerModal").classList.add("hidden");
        }

        function handleRegisterSubmit() {
            hideError();
            const plate = document.getElementById("registerPlateInput").value.trim();
            if (!plate) {
                showError("Vui lòng nhập biển số xe.");
                return;
            }

            // Show QR payment (both Chuyển khoản and Ví điện tử use same QR)
            showQrPayment(plate);
        }

        function showQrPayment(plate) {
            const vehicleType = document.getElementById("registerVehicleType").value;
            const packageType = document.getElementById("registerPackageType").value;
            const method = document.getElementById("paymentMethodSelect").value;
            const amount = currentAmount;
            const content = "VT " + plate.replace(/[^a-zA-Z0-9]/g, "") + " " + packageType.replace(" ", "");

            // Generate VietQR image URL
            const qrUrl = `https://img.vietqr.io/image/${BANK_CONFIG.bankId}-${BANK_CONFIG.accountNo}-${BANK_CONFIG.template}.png?amount=${amount}&addInfo=${encodeURIComponent(content)}&accountName=${encodeURIComponent(BANK_CONFIG.accountName)}`;

            document.getElementById("qrCodeImage").src = qrUrl;
            document.getElementById("qrBankName").textContent = BANK_CONFIG.bankName;
            document.getElementById("qrAccountNo").textContent = BANK_CONFIG.accountNo;
            document.getElementById("qrAccountName").textContent = BANK_CONFIG.accountName;
            document.getElementById("qrAmount").textContent = amount.toLocaleString("vi-VN") + " đ";
            document.getElementById("qrContent").textContent = content;

            // Close register modal, open QR modal
            closeRegisterModal();
            document.getElementById("qrPaymentModal").classList.remove("hidden");
        }

        function closeQrModal() {
            document.getElementById("qrPaymentModal").classList.add("hidden");
        }

        function confirmQrPayment() {
            // Show loading state
            const btn = document.getElementById("confirmPaidBtn");
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';

            // Submit the register form
            closeQrModal();
            document.getElementById("registerForm").submit();
        }

        function showError(msg) {
            const el = document.getElementById("registerError");
            if (el) {
                el.textContent = msg;
                el.classList.remove("hidden");
            }
        }

        function hideError() {
            const el = document.getElementById("registerError");
            if (el) el.classList.add("hidden");
        }
    </script>
}
