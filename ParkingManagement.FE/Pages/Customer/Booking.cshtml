@page
@model ParkingManagement.FE.Pages.Customer.BookingModel
@{
    ViewData["Title"] = "Quản lý đặt chỗ";
    ViewData["UserName"] = Model.UserName;
    ViewData["Role"] = "Khách hàng";
}

<link rel="stylesheet" href="~/css/customer/booking.css" asp-append-version="true" />

<div class="booking-page">

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i> @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-circle-exclamation"></i> @Model.ErrorMessage
        </div>
    }

    <div class="booking-welcome-card">
        <div>
            <h2>Xin chào, @Model.UserName</h2>
            <p>Quản lý và theo dõi các đơn đặt chỗ tại bãi đỗ xe.</p>
        </div>

        <button type="button" id="openBookingWizardBtn" class="main-create-btn">
            <i class="fa-solid fa-plus"></i>
            Đặt chỗ mới
        </button>
    </div>

    <div class="summary-grid">
        <div class="summary-card blue">
            <div class="summary-icon"><i class="fa-solid fa-calendar-days"></i></div>
            <div>
                <p>Tổng đơn</p>
                <h3>@Model.TotalBooking</h3>
                <span>Tất cả đặt chỗ</span>
            </div>
        </div>

        <div class="summary-card gold">
            <div class="summary-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div>
                <p>Đang chờ</p>
                <h3>@Model.WaitingBooking</h3>
                <span>Cần theo dõi</span>
            </div>
        </div>

        <div class="summary-card green">
            <div class="summary-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <p>Đã nhận</p>
                <h3>@Model.ReceivedBooking</h3>
                <span>Đã check-in</span>
            </div>
        </div>

        <div class="summary-card orange">
            <div class="summary-icon"><i class="fa-solid fa-clock"></i></div>
            <div>
                <p>Hết hạn</p>
                <h3>@Model.ExpiredBooking</h3>
                <span>Quá giờ hẹn</span>
            </div>
        </div>

        <div class="summary-card red">
            <div class="summary-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <div>
                <p>Đã hủy</p>
                <h3>@Model.CancelledBooking</h3>
                <span>Khách hủy</span>
            </div>
        </div>
    </div>

    <div id="bookingContent" class="booking-content no-detail">

        <div class="card booking-list-card">
            <h3>Danh sách đơn đặt chỗ</h3>

            <div class="filter-bar">
                <input type="text" value="01/05/2026 - 31/05/2026" readonly />

                <select id="bookingStatusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="waiting">Đang chờ</option>
                    <option value="received">Đã nhận</option>
                    <option value="expired">Hết hạn</option>
                    <option value="cancelled">Đã hủy</option>
                </select>

                <select id="bookingVehicleFilter">
                    <option value="">Tất cả loại xe</option>
                    <option value="Xe máy">Xe máy</option>
                    <option value="Ô tô nhỏ">Ô tô nhỏ</option>
                    <option value="Ô tô lớn">Ô tô lớn</option>
                </select>

                <div class="search-box">
                    <input type="search" id="bookingSearchFilter" autocomplete="off" placeholder="Nhập thông tin đơn đặt chỗ cần tìm..." />
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
            </div>

            <div class="table-wrap">
                <table class="booking-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Vị trí</th>
                            <th>Biển số xe</th>
                            <th>Loại xe</th>
                            <th>Thời gian đặt</th>
                            <th>Thời gian giữ</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Bookings)
                        {
                            <tr class="booking-row"
                                data-id="@item.Id"
                                data-reservation-id="@item.ReservationId"
                                data-code="@item.Code"
                                data-parking="@item.ParkingName"
                                data-position="@item.Position"
                                data-plate="@item.VehiclePlate"
                                data-vehicle="@item.VehicleType"
                                data-vehicle-class="@item.VehicleClass"
                                data-icon="@item.Icon"
                                data-booking-time="@item.BookingTime"
                                data-time-range="@item.TimeRange"
                                data-price="@item.TotalPrice.ToString("N0") đ"
                                data-status="@item.Status"
                                data-status-class="@item.StatusClass"
                                data-customer="@item.CustomerName"
                                data-phone="@item.Phone"
                                data-can-cancel="@item.CanCancel.ToString().ToLower()">

                                <td class="code">@item.Code</td>
                                <td>@item.Position</td>
                                <td>@item.VehiclePlate</td>
                                <td>
                                    <span class="vehicle-pill @item.VehicleClass">
                                        <i class="@item.Icon"></i>
                                        @item.VehicleType
                                    </span>
                                </td>
                                <td>@item.BookingTime</td>
                                <td>@item.TimeRange</td>
                                <td>
                                    <span class="status-badge @item.StatusClass">
                                        <i class="fa-solid fa-circle"></i>
                                        @item.Status
                                    </span>
                                </td>
                            </tr>
                        }
                        <tr id="bookingNoResults" class="hidden">
                            <td colspan="7" style="text-align:center; padding: 2rem; color: #64748b;">
                                Không có đơn đặt chỗ phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <aside id="bookingDetailPanel" class="card detail-panel hidden">
            <div class="detail-top">
                <div>
                    <p>Chi tiết đơn đặt chỗ</p>
                    <h3 id="detailCode"></h3>
                </div>

                <button type="button" id="closeDetailBtn" class="close-btn">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <span id="detailStatus" class="status-badge"></span>

            <div class="detail-lines">
                <div><span>Bãi giữ xe</span><strong id="detailParking"></strong></div>
                <div><span>Vị trí</span><strong id="detailPosition" class="blue-text"></strong></div>
                <div><span>Biển số xe</span><strong id="detailPlate"></strong></div>
                <div><span>Loại xe</span><strong id="detailVehicle"></strong></div>
                <div><span>Thời gian đặt</span><strong id="detailBookingTime"></strong></div>
                <div><span>Thời gian giữ</span><strong id="detailTimeRange"></strong></div>
                <div><span>Tổng phí dự kiến</span><strong id="detailPrice" class="price-text"></strong></div>
                <div><span>Khách hàng</span><strong id="detailCustomer"></strong></div>
                <div><span>SĐT</span><strong id="detailPhone"></strong></div>
            </div>

            <div class="detail-actions">
                <button type="button" id="cancelBookingBtn" class="danger-outline-btn"
                        data-reservation-id="">
                    <i class="fa-solid fa-trash"></i>
                    Hủy đơn đặt chỗ
                </button>

                <form method="post" asp-page-handler="Cancel" id="cancelBookingForm" class="hidden">
                    <input type="hidden" name="reservationId" id="cancelReservationId" value="" />
                </form>

                <button type="button" id="bottomCloseDetailBtn" class="secondary-btn">
                    Đóng
                </button>
            </div>
        </aside>
    </div>

    <div id="bookingWizardModal" class="booking-modal wizard-section hidden">
        <div class="booking-modal-backdrop"></div>

        <div class="booking-modal-content">
            <div class="wizard-title">
                <h3>Đặt chỗ mới</h3>
                <button type="button" id="closeWizardBtn" class="close-btn">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="wizard-steps">
                <div class="wizard-step active" data-step-indicator="1">
                    <span>1</span>
                    <p>Thông tin</p>
                </div>

                <div class="wizard-line"></div>

                <div class="wizard-step" data-step-indicator="2">
                    <span>2</span>
                    <p>Chỗ đỗ</p>
                </div>

                <div class="wizard-line"></div>

                <div class="wizard-step" data-step-indicator="3">
                    <span>3</span>
                    <p>Xác nhận</p>
                </div>
            </div>

            <div class="wizard-grid">

            <div class="wizard-panel active" data-step="1">
                <div class="step-title">
                    <span>1</span>
                    <h4>Thông tin xe & thời gian</h4>
                </div>

                <label>Chọn xe đã lưu</label>
                <select id="savedVehicleSelect" data-storage-key="@Model.SavedVehicleStorageKey">
                    @if (Model.SavedVehicles.Any())
                    {
                        @foreach (var v in Model.SavedVehicles)
                        {
                            <option value="@v.Value">@v.Text</option>
                        }
                    }
                    else
                    {
                        <option value="">-- Nhập thông tin xe mới --</option>
                    }
                </select>

                <button type="button" id="showNewVehicleFormBtn" class="link-btn">
                    <i class="fa-solid fa-plus"></i>
                    Nhập xe mới
                </button>

                <div id="newVehicleForm" class="new-vehicle-form hidden">
                    <div class="new-vehicle-grid">
                        <label>
                            <span>Biển số xe</span>
                            <input type="text" id="newVehiclePlate" placeholder="VD: 43C1-123.45" />
                        </label>

                        <label>
                            <span>Loại xe</span>
                            <select id="newVehicleType">
                                <option>Xe máy</option>
                                <option>Ô tô nhỏ</option>
                                <option>Ô tô lớn</option>
                            </select>
                        </label>
                    </div>

                    <div class="new-vehicle-actions">
                        <button type="button" id="saveNewVehicleBtn" class="primary-btn compact-btn">
                            Lưu
                        </button>
                        <button type="button" id="cancelNewVehicleBtn" class="secondary-btn compact-btn">
                            Hủy
                        </button>
                    </div>

                    <p id="newVehicleError" class="form-error hidden"></p>
                </div>

                <label>Thời gian dự kiến đến</label>
                <input type="datetime-local" id="expectedTimeInput" class="form-input" />

                <label>Khách hàng</label>
                <div class="customer-card">
                    <strong id="previewCustomer">@Model.UserName</strong>
                </div>

                <p id="step1Error" class="form-error hidden"></p>

                <button type="button" class="primary-btn next-step" data-next="2" id="step1NextBtn">
                    Tiếp tục
                </button>
            </div>

            <div class="wizard-panel" data-step="2">
                <div class="step-title">
                    <span>2</span>
                    <h4>Chọn chỗ đỗ</h4>
                </div>

                <div class="legend">
                    <span><i class="dot green"></i>Trống</span>
                    <span><i class="dot orange"></i>Đang dùng</span>
                    <span><i class="dot blue"></i>Đã đặt</span>
                    <span><i class="dot gray"></i>Bảo trì</span>
                </div>

                <div class="zone-summary">
                    <strong id="zoneTitle">Chỗ đỗ khả dụng</strong>
                    <span id="zoneCapacity">Đang tải...</span>
                </div>

                <div id="parkingMap" class="parking-map">
                    <p class="no-slots-msg" id="slotsLoading">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        Đang tải chỗ đỗ...
                    </p>
                </div>

                <p class="selected-slot">
                    Chỗ đã chọn:
                    <strong id="selectedSlotText">Chưa chọn</strong>
                </p>

                <p id="step2Error" class="form-error hidden"></p>

                <div class="wizard-actions">
                    <button type="button" class="secondary-btn prev-step" data-prev="1">
                        Quay lại bước 1
                    </button>

                    <button type="button" id="randomSlotBtn" class="secondary-btn">
                        <i class="fa-solid fa-shuffle"></i>
                        Chọn ngẫu nhiên
                    </button>

                    <button type="button" class="primary-btn" id="step2NextBtn">
                        Tiếp tục
                    </button>
                </div>
            </div>

            <div class="wizard-panel" data-step="3">
                <div class="step-title">
                    <span>3</span>
                    <h4>Xác nhận đặt chỗ</h4>
                </div>

                <form method="post" asp-page-handler="Create" id="createBookingForm">
                    <input type="hidden" name="vehiclePlate" id="formVehiclePlate" value="" />
                    <input type="hidden" name="vehicleType" id="formVehicleType" value="" />
                    <input type="hidden" name="slotId" id="formSlotId" value="" />
                    <input type="hidden" name="expectedTime" id="formExpectedTime" value="" />

                    <div class="confirm-box">
                        <div class="confirm-main">
                            <div><span>Khách hàng</span><strong id="confirmCustomer">@Model.UserName</strong></div>
                            <div><span>Biển số xe</span><strong id="confirmPlate">-</strong></div>
                            <div><span>Loại xe</span><strong id="confirmVehicle">-</strong></div>
                            <div><span>Thời gian dự kiến</span><strong id="confirmTime">-</strong></div>
                        </div>

                        <div class="confirm-slot">
                            <span>Chỗ đỗ</span>
                            <strong id="confirmSlot">-</strong>
                        </div>
                    </div>

                    <div class="wizard-actions">
                        <button type="button" class="secondary-btn prev-step" data-prev="2">Quay lại</button>
                        <button type="submit" id="confirmBookingBtn" class="primary-btn">
                            <i class="fa-solid fa-check"></i>
                            Xác nhận đặt chỗ
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

    <!-- Confirm Dialog -->
    <div id="confirmDialog" class="confirm-dialog-overlay hidden">
        <div class="confirm-dialog">
            <div class="confirm-dialog-icon" id="confirmDialogIcon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 id="confirmDialogTitle">Xác nhận</h3>
            <p id="confirmDialogMessage">Bạn có chắc chắn muốn thực hiện thao tác này?</p>
            <div class="confirm-dialog-actions">
                <button type="button" id="confirmDialogCancel" class="secondary-btn">Hủy bỏ</button>
                <button type="button" id="confirmDialogOk" class="danger-btn">Xác nhận</button>
            </div>
        </div>
    </div>

<script src="~/js/booking.js" asp-append-version="true"></script>
