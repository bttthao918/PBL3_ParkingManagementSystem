@page
@model ParkingManagement.FE.Pages.Admin.ParkingSlotManagementModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý chỗ đỗ";
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

@section Styles {
    <link rel="stylesheet" href="/css/shared/parkingslot.css" asp-append-version="true" />
}

<partial name="/Pages/Shared/ParkingSlotManagement/_IndexPartial.cshtml" model="Model" />

@section Scripts {
    <partial name="/Pages/Shared/ParkingSlotManagement/_Scripts.cshtml" model="Model" />
}