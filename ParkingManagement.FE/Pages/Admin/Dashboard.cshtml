@page
@model ParkingManagement.FE.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Tổng quan Admin";
    ViewData["Role"] = "Quản trị viên";
    ViewData["UserName"] = Model.UserName;
}

<div class="dashboard-content">
    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="card kpi-card">
            <div class="kpi-icon blue"><i class="fa-solid fa-dollar-sign"></i></div>
            <div>
                <p>Tổng doanh thu</p>
                <h2>@Model.TodayRevenue.ToString("N0") đ</h2>
                <span class="up">↑ 12.5%</span>
            </div>
        </div>
        <div class="card kpi-card">
            <div class="kpi-icon green"><i class="fa-solid fa-ticket"></i></div>
            <div>
                <p>Tổng vé</p>
                <h2>@Model.TotalTickets</h2>
                <span class="up">↑ 8.2%</span>
            </div>
        </div>
        <div class="card kpi-card">
            <div class="kpi-icon purple"><i class="fa-solid fa-car"></i></div>
            <div>
                <p>Xe trong bãi</p>
                <h2>@Model.ActiveVehicles</h2>
                <span>Đang gửi</span>
            </div>
        </div>
        <div class="card kpi-card">
            <div class="kpi-icon orange"><i class="fa-solid fa-square-parking"></i></div>
            <div>
                <p>Chỗ trống / Tổng</p>
                <h2>@Model.AvailableSlots / @Model.TotalSlots</h2>
                <div class="progress-bar">
                    <div style="width: @Model.UtilizationRate%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="card quick-actions">
        <h3>Thao tác nhanh</h3>
        <div class="action-grid">
            <a href="/Admin/EmployeeManagement"><i class="fa-solid fa-user-plus"></i> Nhân viên</a>
            <a href="/Admin/TicketManagement"><i class="fa-solid fa-ticket"></i> Vé lượt</a>
            <a href="/Admin/RevenueStatistics"><i class="fa-solid fa-chart-line"></i> Báo cáo</a>
            <a href="/Admin/ParkingSlotManagement"><i class="fa-solid fa-square-parking"></i> Chỗ đỗ</a>
            <a href="/Admin/CustomerStatistics"><i class="fa-solid fa-user-group"></i> Khách hàng</a>
        </div>
    </div>

    <!-- CHART -->
    <div class="card chart-card">
        <h3>Doanh thu 7 ngày gần nhất</h3>
        <canvas id="revenueChart" height="200"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById("revenueChart"), {
        type: "line",
        data: {
        labels: @Html.Raw(Json.Serialize(Model.RevenueLabels)),
        datasets: [{
        label: "Doanh thu (VNĐ)",
        data: @Html.Raw(Json.Serialize(Model.RevenueData)),
        borderColor: "#0d8bff",
        backgroundColor: "rgba(13, 139, 255, 0.1)",
        fill: true,
        tension: 0.4
        }]
        },
        options: { responsive: true, maintainAspectRatio: true }
        });
    </script>
}