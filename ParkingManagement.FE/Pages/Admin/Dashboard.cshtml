@page
@model ParkingManagement.FE.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Tổng quan";
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

<div class="dashboard-title-card">
    <div>
        <h2>Tổng quan quản lý</h2>
        <p>Theo dõi doanh thu, vé, nhân sự và tình trạng chỗ đỗ trong hệ thống.</p>
    </div>
</div>

<div class="kpi-grid">
    <div class="card kpi-card">
        <div class="kpi-icon blue"><i class="fa-solid fa-dollar-sign"></i></div>
        <div>
            <p>Doanh thu hôm nay</p>
            <h2>@Model.Summary.TodayRevenue.ToString("N0") đ</h2>
            <span class="up">Tháng: @Model.Summary.ThisMonthRevenue.ToString("N0") đ</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon green"><i class="fa-solid fa-ticket"></i></div>
        <div>
            <p>Tổng vé hôm nay</p>
            <h2>@Model.Summary.TodayTickets.ToString("N0")</h2>
            <span class="up">Tháng: @Model.Summary.ThisMonthTickets.ToString("N0")</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon purple"><i class="fa-solid fa-users"></i></div>
        <div>
            <p>Nhân sự & khách</p>
            <h2>@Model.Summary.EmployeesOnline / @Model.Summary.TotalActiveEmployees NV</h2>
            <span class="up">Khách hàng: @Model.Summary.TotalCustomers.ToString("N0")</span>
        </div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-icon orange"><i class="fa-solid fa-square-parking"></i></div>
        <div>
            <p>Tổng chỗ đỗ</p>
            <h2>@Model.Summary.OccupiedSlots / @Model.Summary.TotalSlots</h2>
            <div style="height:8px;background:#e5ecf5;border-radius:999px;margin:8px 0;width:160px;">
                <div style="height:100%;width:@(Model.Summary.SlotUtilizationRate.ToString(System.Globalization.CultureInfo.InvariantCulture))%;background:#0d8bff;border-radius:999px;"></div>
            </div>
            <span>@Model.Summary.SlotUtilizationRate.ToString("0.0")% đang sử dụng</span>
        </div>
    </div>
</div>

<div class="card quick-actions">
    <h3>Thao tác nhanh</h3>

    <div class="action-grid">
        <a asp-page="/Admin/EmployeeManagement"><i class="fa-solid fa-user-plus"></i> Thêm nhân viên</a>
        <a asp-page="/Admin/TicketManagement"><i class="fa-solid fa-tags"></i> Giá vé</a>
        <a asp-page="/Admin/TicketManagement"><i class="fa-solid fa-ticket"></i> Tìm vé</a>
        <a asp-page="/Admin/ParkingSlotManagement"><i class="fa-solid fa-square-parking"></i> Quản lý chỗ đỗ</a>
    </div>
</div>

<div class="bottom-grid admin-dashboard-bottom-grid">
    <div class="card">
        <h3>Nhân viên trong hệ thống</h3>

        <table>
            <tr>
                <th>Nhân viên</th>
                <th>Ca</th>
                <th>Trạng thái</th>
            </tr>
            @if (Model.Employees.Count == 0)
            {
                <tr>
                    <td colspan="3">Chưa có dữ liệu nhân viên.</td>
                </tr>
            }
            else
            {
                @foreach (var employee in Model.Employees)
                {
                    <tr>
                        <td>@employee.FullName<br><small>@employee.EmployeeCode</small></td>
                        <td>@(employee.Shift ?? "-")</td>
                        <td><span class="status-success">@employee.Status</span></td>
                    </tr>
                }
            }
        </table>
    </div>

    <div class="card">
        <h3>Vé mới nhất</h3>

        <table>
            <tr>
                <th>Mã vé</th>
                <th>Khách hàng</th>
                <th>Trạng thái</th>
            </tr>
            @if (Model.RecentTickets.Count == 0)
            {
                <tr>
                    <td colspan="3">Chưa có dữ liệu vé.</td>
                </tr>
            }
            else
            {
                @foreach (var ticket in Model.RecentTickets)
                {
                    <tr>
                        <td>@ticket.TicketId</td>
                        <td>@(ticket.CustomerName ?? ticket.VehiclePlate)</td>
                        <td><span class="@Model.GetTicketStatusClass(ticket.Status)">@ticket.Status</span></td>
                    </tr>
                }
            }
        </table>
    </div>
</div>
