@page
@model ParkingManagement.FE.Pages.Admin.EmployeeManagementModel
@{
    ViewData["Title"] = "Quản lý nhân viên";
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

@section Styles {
    <link rel="stylesheet" href="/css/admin/admin_employee.css" />
}

<div class="dashboard-content employee-page">
    @if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
    {
        <div class="card" style="margin-bottom:12px; border-left:4px solid #c62828;">
            <p style="margin:0; color:#c62828;">@Model.LoadErrorMessage</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
    {
        <div class="card" style="margin-bottom:12px; border-left:4px solid @(Model.ActionSuccess ? "#2e7d32" : "#c62828");">
            <p style="margin:0; color:@(Model.ActionSuccess ? "#2e7d32" : "#c62828");">@Model.ActionMessage</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.CreateEmployeeMessage))
    {
        var statusColor = Model.CreateEmployeePendingVerification
            ? "#1565c0"
            : Model.CreateEmployeeSuccess
                ? "#2e7d32"
                : "#c62828";

        <div class="card" style="margin-bottom:12px; border-left:4px solid @statusColor;">
            <p style="margin:0; color:@statusColor;">@Model.CreateEmployeeMessage</p>
        </div>
    }

    <div class="employee-header">
        <div>
            <h2>Quản lý nhân viên</h2>
            <p>Quản lý thông tin, ca làm việc và hiệu suất nhân viên</p>
        </div>

        <div class="emp-header-actions">
            @if (Model.IsDeletedFolder)
            {
                <a asp-page="/Admin/EmployeeManagement" class="emp-btn-outline" style="text-decoration:none;">
                    <i class="fa-solid fa-users"></i>
                    Danh sách đang làm
                </a>
            }
            else
            {
                <a asp-page="/Admin/EmployeeManagement"
                   asp-route-status="Đã xóa"
                   asp-route-pageNumber="1"
                   asp-route-pageSize="@Model.PageSize"
                   class="emp-btn-outline"
                   style="text-decoration:none;">
                    <i class="fa-solid fa-folder-open"></i>
                    Thư mục đã xóa
                </a>
            }

            <button class="emp-btn-primary" type="button" onclick="openCreateModal()">
                <i class="fa-solid fa-plus"></i>
                Thêm nhân viên
            </button>
        </div>
    </div>

    <div class="emp-kpi-grid">
        <div class="card emp-kpi-card">
            <div class="emp-kpi-icon blue">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <p>Tổng nhân viên</p>
                <h2>@Model.TotalAllEmployees.ToString("N0")</h2>
                <span>Tất cả nhân viên</span>
            </div>
        </div>

        <div class="card emp-kpi-card">
            <div class="emp-kpi-icon green">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div>
                <p>Đang làm việc</p>
                <h2>@Model.TotalActive.ToString("N0")</h2>
                <span>@Model.ActiveRate.ToString("0.0")%</span>
            </div>
        </div>

        <div class="card emp-kpi-card">
            <div class="emp-kpi-icon orange">
                <i class="fa-solid fa-user-lock"></i>
            </div>
            <div>
                <p>Vô hiệu hóa</p>
                <h2>@Model.TotalInactive.ToString("N0")</h2>
                <span>@Model.InactiveRate.ToString("0.0")%</span>
            </div>
        </div>

        <div class="card emp-kpi-card">
            <div class="emp-kpi-icon red">
                <i class="fa-solid fa-user-slash"></i>
            </div>
            <div>
                <p>Đã xóa</p>
                <h2>@Model.TotalDeleted.ToString("N0")</h2>
                <span>@Model.DeletedRate.ToString("0.0")%</span>
            </div>
        </div>

        <div class="card emp-kpi-card">
            <div class="emp-kpi-icon purple">
                <i class="fa-solid fa-calendar-days"></i>
            </div>
            <div>
                <p>Trang hiện tại</p>
                <h2>@Model.PageNumber/@(Model.TotalPages == 0 ? 1 : Model.TotalPages)</h2>
                <span>Phân trang từ database</span>
            </div>
        </div>
    </div>

    <div class="card emp-filter-card">
        <h3>Tìm kiếm nhân viên</h3>

        <form method="get" class="emp-filter-grid">
            <input type="hidden" name="PageNumber" value="1" />

            <div class="emp-field large">
                <label>Từ khóa</label>
                <input asp-for="Keyword" type="text" placeholder="Nhập tên, SĐT, email, mã nhân viên..." />
            </div>

            <div class="emp-field">
                <label>Ca làm</label>
                <select asp-for="Shift">
                    <option value="">Tất cả</option>
                    <option value="Sáng">Sáng</option>
                    <option value="Chiều">Chiều</option>
                    <option value="Tối">Tối</option>
                </select>
            </div>

            <div class="emp-field">
                <label>Trạng thái</label>
                <select asp-for="Status">
                    <option value="">Tất cả chưa xóa</option>
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Vô hiệu hóa">Vô hiệu hóa</option>
                    <option value="Đã xóa">Đã xóa</option>
                </select>
            </div>

            <div class="emp-field">
                <label>Số dòng</label>
                <select asp-for="PageSize">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>

            <button class="emp-btn-primary" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i>
                Tìm kiếm
            </button>
        </form>

        <div class="emp-filter-actions">
            <a asp-page="/Admin/EmployeeManagement" class="emp-btn-outline" style="text-decoration:none;">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                Xóa bộ lọc
            </a>

            <button class="emp-btn-outline" type="button" onclick="window.print()">
                <i class="fa-solid fa-download"></i>
                Export
            </button>
        </div>
    </div>

    <div class="employee-main-grid">
        <div>
            <div class="card emp-bulk-bar">
                <div>
                    <input id="empSelectAll" type="checkbox" />
                    <span id="selectedEmployeeCount">Chưa chọn nhân viên</span>
                </div>

                <div class="emp-bulk-actions">
                    <button type="button" disabled>Kích hoạt</button>
                    <button type="button" disabled>Vô hiệu hóa</button>
                    <button type="button" disabled>Xóa</button>
                    <button type="button" disabled>Phân ca</button>
                    <button type="button" onclick="window.print()">Xuất dữ liệu</button>
                </div>
            </div>

            <div class="card emp-table-card">
                <div class="emp-table-title">
                    <h3>@(Model.IsDeletedFolder ? "Thư mục nhân viên đã xóa" : "Danh sách nhân viên") (@Model.TotalEmployees.ToString("N0"))</h3>
                </div>

                <div class="emp-table-scroll">
                    <table class="emp-table">
                        <thead>
                            <tr>
                                <th><input id="empSelectAllTable" type="checkbox" /></th>
                                <th>Mã NV</th>
                                <th>Họ tên</th>
                                <th>Vị trí</th>
                                <th>Ca làm</th>
                                <th>SĐT</th>
                                <th>Tổng vé</th>
                                <th>Vé xử lý</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Employees.Count == 0)
                            {
                                <tr>
                                    <td colspan="10" class="emp-empty-state">
                                        @(Model.IsDeletedFolder ? "Chưa có nhân viên nào trong thư mục đã xóa." : "Không có nhân viên phù hợp với bộ lọc hiện tại.")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in Model.Employees)
                                {
                                    var isDeleted = emp.StatusClass == "deleted";
                                    var isDisabled = emp.StatusClass == "disabled";
                                    var statusTargetStatus = isDisabled ? "Hoạt động" : "Vô hiệu hóa";
                                    var statusActionText = isDisabled ? "kích hoạt" : "vô hiệu hóa";

                                    <tr class="@(emp.Id == Model.SelectedEmployeeId ? "selected" : "")">
                                        <td><input class="emp-row-check" type="checkbox" /></td>
                                        <td class="emp-code">@emp.Code</td>
                                        <td>
                                            <div class="emp-name-cell">
                                                <span class="emp-avatar">@emp.Initials</span>
                                                <span>@emp.Name</span>
                                            </div>
                                        </td>
                                        <td>@emp.Position</td>
                                        <td>@emp.Department</td>
                                        <td>@emp.Phone</td>
                                        <td>@emp.TotalTickets</td>
                                        <td>@emp.ProcessedTickets</td>
                                        <td>
                                            <span class="emp-status @emp.StatusClass">
                                                @emp.Status
                                            </span>
                                        </td>
                                        <td>
                                            <div class="emp-actions">
                                                <a class="emp-action-btn"
                                                   title="Xem"
                                                   asp-page="/Admin/EmployeeManagement"
                                                   asp-route-keyword="@Model.Keyword"
                                                   asp-route-status="@Model.Status"
                                                   asp-route-shift="@Model.Shift"
                                                   asp-route-pageNumber="@Model.PageNumber"
                                                   asp-route-pageSize="@Model.PageSize"
                                                   asp-route-selectedEmployeeId="@emp.Id">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                                @if (isDeleted)
                                                {
                                                    <form method="post" asp-page-handler="RestoreEmployee" class="emp-inline-form">
                                                        <input type="hidden" name="employeeId" value="@emp.Id" />
                                                        <input type="hidden" name="Keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="Status" value="@Model.Status" />
                                                        <input type="hidden" name="Shift" value="@Model.Shift" />
                                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                                        <input type="hidden" name="SelectedEmployeeId" value="@emp.Id" />
                                                        <button class="emp-action-restore" type="submit" title="Khôi phục">
                                                            <i class="fa-solid fa-rotate-left"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="js-emp-edit"
                                                            type="button"
                                                            title="Sửa"
                                                            data-employee-id="@emp.Id"
                                                            data-employee-code="@emp.Code"
                                                            data-employee-name="@emp.Name"
                                                            data-employee-phone="@emp.Phone"
                                                            data-employee-shift="@emp.Department"
                                                            data-employee-status="@emp.Status">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>
                                                    <button class="js-emp-status"
                                                            type="button"
                                                            title="@statusActionText"
                                                            data-employee-id="@emp.Id"
                                                            data-employee-code="@emp.Code"
                                                            data-employee-name="@emp.Name"
                                                            data-target-status="@statusTargetStatus"
                                                            data-action-text="@statusActionText">
                                                        <i class="fa-solid @(isDisabled ? "fa-user-check" : "fa-user-lock")"></i>
                                                    </button>
                                                    <button class="js-emp-status emp-action-delete"
                                                            type="button"
                                                            title="Xóa"
                                                            data-employee-id="@emp.Id"
                                                            data-employee-code="@emp.Code"
                                                            data-employee-name="@emp.Name"
                                                            data-target-status="Đã xóa"
                                                            data-action-text="xóa">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="emp-pagination">
                    <span>Hiển thị @Model.ShowingFrom đến @Model.ShowingTo trong tổng số @Model.TotalEmployees.ToString("N0") nhân viên</span>

                    <div>
                        @if (Model.HasPreviousPage)
                        {
                            <a asp-page="/Admin/EmployeeManagement"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-status="@Model.Status"
                               asp-route-shift="@Model.Shift"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-selectedEmployeeId="@Model.SelectedEmployeeId">‹</a>
                        }
                        else
                        {
                            <span class="disabled">‹</span>
                        }

                        @for (var pageIndex = Model.StartPage; pageIndex <= Model.EndPage; pageIndex++)
                        {
                            <a class="@(pageIndex == Model.PageNumber ? "active" : "")"
                               asp-page="/Admin/EmployeeManagement"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-status="@Model.Status"
                               asp-route-shift="@Model.Shift"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-pageNumber="@pageIndex"
                               asp-route-selectedEmployeeId="@Model.SelectedEmployeeId">@pageIndex</a>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-page="/Admin/EmployeeManagement"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-status="@Model.Status"
                               asp-route-shift="@Model.Shift"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-selectedEmployeeId="@Model.SelectedEmployeeId">›</a>
                        }
                        else
                        {
                            <span class="disabled">›</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <aside class="card emp-detail-panel">
            @if (Model.SelectedEmployee == null)
            {
                <div class="emp-empty-detail">
                    <i class="fa-solid fa-user"></i>
                    <strong>Chưa chọn nhân viên</strong>
                    <span>Bấm biểu tượng mắt trong bảng để xem chi tiết.</span>
                </div>
            }
            else
            {
                var detail = Model.SelectedEmployee;
                var detailStatusClass = EmployeeManagementModel.GetStatusClass(detail.Status);
                var detailIsDeleted = detailStatusClass == "deleted";
                var detailIsDisabled = detailStatusClass == "disabled";
                var detailTargetStatus = detailIsDisabled ? "Hoạt động" : "Vô hiệu hóa";
                var detailActionText = detailIsDisabled ? "kích hoạt" : "vô hiệu hóa";
                var detailInitial = string.IsNullOrWhiteSpace(detail.FullName) ? "NV" : detail.FullName.Trim()[0].ToString().ToUpperInvariant();

                <div class="emp-profile">
                    <span class="emp-profile-avatar">@detailInitial</span>
                    <h3>@detail.FullName</h3>
                    <span class="emp-status @detailStatusClass">@detail.Status</span>
                    <p>@(detail.Shift ?? "Chưa phân ca") · Mã @detail.EmployeeCode</p>
                </div>

                <div class="emp-detail-tabs">
                    <button class="active" type="button" onclick="showEmpTab('info')">Thông tin</button>
                    <button type="button" onclick="showEmpTab('shift')">Lịch ca</button>
                </div>

                <div id="empInfoTab" class="emp-tab-content active">
                    <div class="emp-detail-stats">
                        <div>
                            <i class="fa-solid fa-ticket"></i>
                            <strong>@detail.TotalTicketsProcessed.ToString("N0")</strong>
                            <span>Tổng vé</span>
                        </div>
                        <div>
                            <i class="fa-solid fa-circle-check"></i>
                            <strong>@detail.TicketsProcessedToday.ToString("N0")</strong>
                            <span>Hôm nay</span>
                        </div>
                        <div>
                            <i class="fa-solid fa-calendar"></i>
                            <strong>@detail.TicketsProcessedThisMonth.ToString("N0")</strong>
                            <span>Tháng này</span>
                        </div>
                        <div>
                            <i class="fa-solid fa-clock"></i>
                            <strong>@detail.WorkDaysCount.ToString("N0")</strong>
                            <span>Ngày làm</span>
                        </div>
                    </div>

                    <div class="emp-info-list">
                        <div><span>Mã nhân viên</span><strong>@detail.EmployeeCode</strong></div>
                        <div><span>ID hệ thống</span><strong>@detail.EmployeeId</strong></div>
                        <div><span>SĐT</span><strong>@detail.PhoneNumber</strong></div>
                        <div><span>Email</span><strong>@detail.Email</strong></div>
                        <div><span>Ca làm</span><strong>@(detail.Shift ?? "Chưa phân ca")</strong></div>
                        <div><span>Ngày tạo</span><strong>@detail.CreatedAt.ToString("dd/MM/yyyy")</strong></div>
                    </div>
                </div>

                <div id="empShiftTab" class="emp-tab-content">
                    <div class="emp-shift-section">
                        <h4 style="margin:0 0 12px; font-size:14px; color:#475569;">
                            <i class="fa-solid fa-calendar-days"></i> Phân ca tuần này
                        </h4>

                        @if (detailIsDeleted)
                        {
                            <div class="emp-deleted-notice">
                                Nhân viên này đang nằm trong thư mục đã xóa. Khôi phục trước khi phân ca.
                            </div>
                        }
                        else
                        {
                            <!-- Form thêm ca nhanh -->
                            <form method="post" asp-page-handler="CreateShift" class="emp-shift-form">
                                <input type="hidden" name="employeeId" value="@detail.EmployeeId" />
                                <input type="hidden" asp-for="Keyword" />
                                <input type="hidden" asp-for="Status" />
                                <input type="hidden" asp-for="Shift" />
                                <input type="hidden" asp-for="PageNumber" />
                                <input type="hidden" asp-for="PageSize" />
                                <input type="hidden" asp-for="SelectedEmployeeId" />
                                <div style="display:flex; gap:8px; margin-bottom:12px;">
                                    <input type="date" name="workDate" required style="flex:1; height:36px; border:1px solid #e3ebf6; border-radius:8px; padding:0 10px; font-size:13px;" />
                                    <select name="shiftType" required style="flex:1; height:36px; border:1px solid #e3ebf6; border-radius:8px; padding:0 10px; font-size:13px;">
                                        <option value="Sáng">Sáng (6-14h)</option>
                                        <option value="Chiều">Chiều (14-22h)</option>
                                        <option value="Tối">Tối (22-6h)</option>
                                    </select>
                                </div>
                                <button type="submit" class="emp-btn-primary" style="width:100%; height:36px; font-size:13px;">
                                    <i class="fa-solid fa-plus"></i> Thêm ca
                                </button>
                            </form>
                        }

                        <!-- Thông tin ca mặc định -->
                        <div class="emp-shift-list" style="margin-top:14px;">
                            <div style="padding:10px 0; border-bottom:1px solid #f1f5f9;">
                                <span style="font-size:12px; color:#94a3b8;">Ca mặc định</span>
                                <strong style="display:block; font-size:14px; color:#10233f;">@(detail.Shift ?? "Chưa phân ca")</strong>
                            </div>
                            <div style="padding:10px 0; border-bottom:1px solid #f1f5f9;">
                                <span style="font-size:12px; color:#94a3b8;">Tổng ngày làm</span>
                                <strong style="display:block; font-size:14px; color:#10233f;">@detail.WorkDaysCount ngày</strong>
                            </div>
                            <div style="padding:10px 0;">
                                <span style="font-size:12px; color:#94a3b8;">Vé xử lý tháng này</span>
                                <strong style="display:block; font-size:14px; color:#10233f;">@detail.TicketsProcessedThisMonth vé</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="emp-detail-actions">
                    @if (detailIsDeleted)
                    {
                        <form method="post" asp-page-handler="RestoreEmployee">
                            <input type="hidden" name="employeeId" value="@detail.EmployeeId" />
                            <input type="hidden" name="Keyword" value="@Model.Keyword" />
                            <input type="hidden" name="Status" value="@Model.Status" />
                            <input type="hidden" name="Shift" value="@Model.Shift" />
                            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                            <input type="hidden" name="PageSize" value="@Model.PageSize" />
                            <input type="hidden" name="SelectedEmployeeId" value="@detail.EmployeeId" />
                            <button class="emp-btn-primary" type="submit">
                                <i class="fa-solid fa-rotate-left"></i>
                                Khôi phục nhân viên
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="emp-btn-primary js-emp-edit"
                                type="button"
                                data-employee-id="@detail.EmployeeId"
                                data-employee-code="@detail.EmployeeCode"
                                data-employee-name="@detail.FullName"
                                data-employee-phone="@detail.PhoneNumber"
                                data-employee-shift="@detail.Shift"
                                data-employee-status="@detail.Status">
                            Cập nhật thông tin
                        </button>
                        <button class="@(detailIsDisabled ? "emp-btn-primary" : "emp-btn-danger") js-emp-status"
                                type="button"
                                data-employee-id="@detail.EmployeeId"
                                data-employee-code="@detail.EmployeeCode"
                                data-employee-name="@detail.FullName"
                                data-target-status="@detailTargetStatus"
                                data-action-text="@detailActionText">
                            @(detailIsDisabled ? "Kích hoạt tài khoản" : "Vô hiệu hóa tài khoản")
                        </button>
                        <button class="emp-btn-danger js-emp-status"
                                type="button"
                                data-employee-id="@detail.EmployeeId"
                                data-employee-code="@detail.EmployeeCode"
                                data-employee-name="@detail.FullName"
                                data-target-status="Đã xóa"
                                data-action-text="xóa">
                            Xóa nhân viên
                        </button>
                    }
                </div>
            }
        </aside>
    </div>
</div>

<div id="createEmployeeModal" class="emp-modal">
    <div class="emp-modal-box">
        <div class="emp-modal-header">
            <h3>Thêm nhân viên mới</h3>
            <button type="button" onclick="closeCreateModal()">×</button>
        </div>

        <form method="post" asp-page-handler="CreateEmployee" class="emp-modal-form">
            <input asp-for="CreateEmployeeInput.FullName" placeholder="Họ và tên" />
            <input asp-for="CreateEmployeeInput.Email" placeholder="Email" />
            <input asp-for="CreateEmployeeInput.PhoneNumber" placeholder="Số điện thoại" />
            <input asp-for="CreateEmployeeInput.Password" type="password" placeholder="Mật khẩu cấp tài khoản" />
            <input asp-for="CreateEmployeeInput.ConfirmPassword" type="password" placeholder="Xác nhận mật khẩu" />

            <label class="emp-checkbox">
                <input asp-for="CreateEmployeeInput.SendInvitationEmail" />
                Gửi email cấp tài khoản cho nhân viên
            </label>

            <div class="emp-modal-actions">
                <button type="button" class="emp-btn-outline" onclick="closeCreateModal()">Hủy</button>
                <button type="submit" class="emp-btn-primary">Tạo nhân viên</button>
            </div>
        </form>
    </div>
</div>

<div id="editEmployeeModal" class="emp-modal">
    <div class="emp-modal-box">
        <div class="emp-modal-header">
            <h3>Sửa nhân viên <span id="editEmployeeTitle"></span></h3>
            <button type="button" onclick="closeEmployeeModal('editEmployeeModal')">×</button>
        </div>

        <form method="post" asp-page-handler="UpdateEmployee" class="emp-modal-form">
            <input type="hidden" name="employeeId" id="editEmployeeId" />
            <input type="hidden" asp-for="Keyword" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="Shift" />
            <input type="hidden" asp-for="PageNumber" />
            <input type="hidden" asp-for="PageSize" />
            <input type="hidden" asp-for="SelectedEmployeeId" />

            <label>
                <span>Họ tên</span>
                <input name="fullName" id="editFullName" required maxlength="100" />
            </label>

            <label>
                <span>Số điện thoại</span>
                <input name="phoneNumber" id="editPhone" required maxlength="15" />
            </label>

            <label>
                <span>Ca làm</span>
                <select name="employeeShift" id="editShift">
                    <option value="">Chưa phân ca</option>
                    <option value="Sáng">Sáng</option>
                    <option value="Chiều">Chiều</option>
                    <option value="Tối">Tối</option>
                </select>
            </label>

            <label>
                <span>Trạng thái</span>
                <select name="employeeStatus" id="editStatus" required>
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Vô hiệu hóa">Vô hiệu hóa</option>
                    <option value="Đã xóa">Đã xóa</option>
                </select>
            </label>

            <div class="emp-modal-actions">
                <button type="button" class="emp-btn-outline" onclick="closeEmployeeModal('editEmployeeModal')">Hủy</button>
                <button type="submit" class="emp-btn-primary">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<div id="employeeStatusModal" class="emp-modal">
    <div class="emp-modal-box small">
        <div class="emp-modal-header">
            <h3 id="statusModalTitle">Cập nhật trạng thái</h3>
            <button type="button" onclick="closeEmployeeModal('employeeStatusModal')">×</button>
        </div>

        <p class="emp-confirm-message" id="statusModalMessage"></p>

        <form method="post" asp-page-handler="SetEmployeeStatus" class="emp-modal-form">
            <input type="hidden" name="employeeId" id="statusEmployeeId" />
            <input type="hidden" name="targetStatus" id="statusTargetStatus" />
            <input type="hidden" asp-for="Keyword" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="Shift" />
            <input type="hidden" asp-for="PageNumber" />
            <input type="hidden" asp-for="PageSize" />
            <input type="hidden" asp-for="SelectedEmployeeId" />

            <textarea name="reason" id="statusReason" rows="3" placeholder="Lý do xóa (không bắt buộc)"></textarea>

            <div class="emp-modal-actions">
                <button type="button" class="emp-btn-outline" onclick="closeEmployeeModal('employeeStatusModal')">Hủy</button>
                <button type="submit" class="emp-btn-danger" id="statusSubmitButton">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showEmpTab(tab) {
            document.getElementById("empInfoTab")?.classList.remove("active");
            document.getElementById("empShiftTab")?.classList.remove("active");

            document.querySelectorAll(".emp-detail-tabs button").forEach(btn => {
                btn.classList.remove("active");
            });

            if (tab === "info") {
                document.getElementById("empInfoTab")?.classList.add("active");
                document.querySelectorAll(".emp-detail-tabs button")[0]?.classList.add("active");
            } else {
                document.getElementById("empShiftTab")?.classList.add("active");
                document.querySelectorAll(".emp-detail-tabs button")[1]?.classList.add("active");
            }
        }

        function openCreateModal() {
            document.getElementById("createEmployeeModal").classList.add("show");
        }

        function closeCreateModal() {
            document.getElementById("createEmployeeModal").classList.remove("show");
        }

        function closeEmployeeModal(id) {
            document.getElementById(id)?.classList.remove("show");
        }

        document.querySelectorAll(".js-emp-edit").forEach(button => {
            button.addEventListener("click", () => {
                const data = button.dataset;
                document.getElementById("editEmployeeId").value = data.employeeId || "";
                document.getElementById("editEmployeeTitle").textContent = data.employeeCode || "";
                document.getElementById("editFullName").value = data.employeeName || "";
                document.getElementById("editPhone").value = data.employeePhone || "";
                document.getElementById("editShift").value = data.employeeShift || "";
                document.getElementById("editStatus").value = data.employeeStatus || "Hoạt động";
                document.getElementById("editEmployeeModal").classList.add("show");
            });
        });

        document.querySelectorAll(".js-emp-status").forEach(button => {
            button.addEventListener("click", () => {
                const data = button.dataset;
                const actionText = data.actionText || "cập nhật";
                const targetStatus = data.targetStatus || "";
                const isDelete = targetStatus.toLowerCase().includes("xóa");
                const isDisable = targetStatus.toLowerCase().includes("vô");
                const isActivate = targetStatus.toLowerCase().includes("hoạt");
                document.getElementById("statusEmployeeId").value = data.employeeId || "";
                document.getElementById("statusTargetStatus").value = targetStatus;
                document.getElementById("statusModalTitle").textContent = isDelete ? "Xóa nhân viên" : (targetStatus || "Cập nhật trạng thái");
                document.getElementById("statusModalMessage").innerHTML = `Bạn chắc chắn muốn ${actionText} nhân viên <strong>${data.employeeCode || ""} - ${data.employeeName || ""}</strong>?`;
                document.getElementById("statusReason").placeholder = isDelete ? "Lý do xóa (không bắt buộc)" : "Lý do (không bắt buộc)";
                const submitButton = document.getElementById("statusSubmitButton");
                submitButton.textContent = isDelete ? "Xóa nhân viên" : (targetStatus || "Xác nhận");
                submitButton.className = isDelete || isDisable ? "emp-btn-danger" : "emp-btn-primary";
                document.getElementById("employeeStatusModal").classList.add("show");
            });
        });

        const rowChecks = Array.from(document.querySelectorAll(".emp-row-check"));
        const headerChecks = [document.getElementById("empSelectAll"), document.getElementById("empSelectAllTable")].filter(Boolean);
        const selectedCount = document.getElementById("selectedEmployeeCount");

        function updateSelectedCount() {
            const count = rowChecks.filter(check => check.checked).length;
            selectedCount.textContent = count > 0 ? `Đã chọn ${count} nhân viên` : "Chưa chọn nhân viên";
            headerChecks.forEach(check => {
                check.checked = rowChecks.length > 0 && count === rowChecks.length;
                check.indeterminate = count > 0 && count < rowChecks.length;
            });
        }

        headerChecks.forEach(check => {
            check.addEventListener("change", () => {
                rowChecks.forEach(rowCheck => rowCheck.checked = check.checked);
                updateSelectedCount();
            });
        });

        rowChecks.forEach(check => check.addEventListener("change", updateSelectedCount));
        updateSelectedCount();
    </script>
}
