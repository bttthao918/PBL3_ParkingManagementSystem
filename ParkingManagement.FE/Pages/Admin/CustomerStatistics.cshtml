@page
@model ParkingManagement.FE.Pages.Admin.CustomerStatisticsModel
@{
    ViewData["Title"] = "Thống kê khách hàng";
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

@section Styles {
    <link rel="stylesheet" href="/css/shared/statistics.css" asp-append-version="true" />
}

<div class="dashboard-content statistics-page">
    <partial name="/Pages/Shared/Statistics/_StatisticsHeader.cshtml" model="Model.Header" />

    <div class="stat-kpi-grid">
        @foreach (var kpi in Model.Kpis)
        {
            <partial name="/Pages/Shared/Statistics/_StatisticsKpiCard.cshtml" model="kpi" />
        }
    </div>

    <div class="stat-main-grid">
        <div class="card stat-chart-card large">
            <div class="stat-card-title">
                <h3>Khách hàng mới theo ngày</h3>
                <span>@Model.Header.DateRangeText</span>
            </div>
            <canvas id="mainLineChart"></canvas>
        </div>

        <div class="card stat-chart-card">
            <h3>Cơ cấu khách hàng theo nhóm/hạng</h3>

            <div class="stat-donut-layout">
                <canvas id="mainDonutChart"></canvas>

                <div class="stat-donut-legend">
                    @for (var i = 0; i < Model.Report.GroupBreakdown.Count; i++)
                    {
                        var item = Model.Report.GroupBreakdown[i];
                        <div>
                            <span class="dot @Model.GetBreakdownColor(i)"></span>
                            <strong>@item.Label</strong>
                            <p>@item.Count.ToString("N0")</p>
                            <small>@item.Percentage.ToString("N1")%</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="stat-bottom-grid">
        <div class="card stat-chart-card">
            <div class="stat-card-title">
                <h3>Phân bổ khách hàng theo khu vực</h3>
                <span>Số lượt gửi xe</span>
            </div>
            <canvas id="mainBarChart"></canvas>
        </div>

        <div class="card stat-list-card">
            <h3>Top 5 khách hàng theo lượt gửi</h3>
            <div class="stat-rank-list">
                @if (Model.Report.TopCustomers.Count == 0)
                {
                    <p class="stat-empty">Chưa có khách hàng phát sinh lượt gửi trong khoảng này.</p>
                }
                else
                {
                    @for (var i = 0; i < Model.Report.TopCustomers.Take(5).Count(); i++)
                    {
                        var customer = Model.Report.TopCustomers[i];
                        <div>
                            <b>@(i + 1)</b>
                            <span>@customer.FullName</span>
                            <strong>@customer.TicketCount.ToString("N0") lượt</strong>
                            <em class="@Model.GetChangeClass(customer.VisitChangePercentage)">
                                @Model.GetChangeText(customer.VisitChangePercentage)
                            </em>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card stat-side-card">
            <h3>Mức độ quay lại của khách hàng</h3>

            @for (var i = 0; i < Model.Report.ReturnBuckets.Count; i++)
            {
                var bucket = Model.Report.ReturnBuckets[i];
                <div class="stat-progress-row">
                    <div>
                        <span>@bucket.Label</span>
                        <strong>@bucket.Percentage.ToString("N1")%</strong>
                    </div>
                    <div class="stat-progress">
                        <span class="@Model.GetProgressColor(i)" style="width: @Model.GetProgressWidth(bucket.Percentage)"></span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        window.statisticsConfig = @Html.Raw(Model.ChartConfigJson);
    </script>

    <script src="/js/statistics.js" asp-append-version="true"></script>
}
