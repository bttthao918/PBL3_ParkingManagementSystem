@page
@model ParkingManagement.FE.Pages.Admin.TicketManagementModel
@{
    ViewData["Title"] = "Quản lý vé";
    ViewData["UserName"] = "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

@section Styles {
    <link rel="stylesheet" href="/css/admin/admin_ticket.css" />
}

<div class="dashboard-content ticket-page">
    @if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
    {
        <div class="card" style="margin-bottom:12px; border-left:4px solid #c62828;">
            <p style="margin:0; color:#c62828;">@Model.LoadErrorMessage</p>
        </div>
    }

    <div class="ticket-header">
        <div>
            <h2>Quản lý vé</h2>
            <p>Quản lý danh sách vé lượt, tìm kiếm vé và theo dõi số liệu từ database</p>
        </div>

        <a asp-page="/Employee/TicketManagement" class="ticket-btn-primary" style="text-decoration:none;">
            <i class="fa-solid fa-plus"></i>
            Thêm vé mới
        </a>
    </div>

    <div class="ticket-kpi-grid">
        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon blue">
                <i class="fa-solid fa-ticket"></i>
            </div>
            <div>
                <p>Tổng số vé</p>
                <h2>@Model.TotalTickets.ToString("N0")</h2>
                <span>Tất cả vé trong hệ thống</span>
            </div>
        </div>

        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon green">
                <i class="fa-solid fa-car"></i>
            </div>
            <div>
                <p>Đang trong bãi</p>
                <h2>@Model.ActiveTickets.ToString("N0")</h2>
                <span>@Model.ActiveRate.ToString("0.0")%</span>
            </div>
        </div>

        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon orange">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <p>Đã ra</p>
                <h2>@Model.CheckedOutTickets.ToString("N0")</h2>
                <span>@Model.CheckedOutRate.ToString("0.0")%</span>
            </div>
        </div>

        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon red">
                <i class="fa-solid fa-coins"></i>
            </div>
            <div>
                <p>Doanh thu vé lượt</p>
                <h2>@Model.TotalRevenue.ToString("N0") đ</h2>
                <span>Phí đã ghi nhận</span>
            </div>
        </div>
    </div>

    <div class="card ticket-search-card">
        <h3>Tìm kiếm vé</h3>

        <form method="get" class="ticket-filter-grid">
            <div class="ticket-input-group large">
                <label>Từ khóa</label>
                <input type="text" asp-for="Keyword" placeholder="Nhập mã vé hoặc biển số xe..." />
            </div>

            <div class="ticket-input-group">
                <label>Trạng thái</label>
                <select asp-for="Status">
                    <option value="">Tất cả</option>
                    <option value="Đang trong bãi">Đang trong bãi</option>
                    <option value="Đã ra">Đã ra</option>
                </select>
            </div>

            <div class="ticket-input-group">
                <label>Loại xe</label>
                <select asp-for="Type">
                    <option value="">Tất cả</option>
                    <option value="Xe máy">Xe máy</option>
                    <option value="Ô tô nhỏ">Ô tô nhỏ</option>
                    <option value="Ô tô lớn">Ô tô lớn</option>
                </select>
            </div>

            <div class="ticket-input-group">
                <label>Từ ngày</label>
                <input type="date" asp-for="FromDate" />
            </div>

            <div class="ticket-input-group">
                <label>Đến ngày</label>
                <input type="date" asp-for="ToDate" />
            </div>

            <button class="ticket-btn-primary search-btn" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i>
                Tìm
            </button>
        </form>

        <a asp-page="/Admin/TicketManagement" class="ticket-btn-outline" style="text-decoration:none;">
            <i class="fa-solid fa-filter-circle-xmark"></i>
            Xóa bộ lọc
        </a>
    </div>

    <div class="ticket-toolbar">
        <div class="ticket-tabs">
            <button class="active" type="button">
                <i class="fa-solid fa-list"></i>
                Danh sách vé
            </button>
        </div>

        <div class="ticket-toolbar-actions">
            <button class="ticket-btn-outline" type="button" onclick="window.print()">
                <i class="fa-solid fa-print"></i>
                In danh sách
            </button>

            <a asp-page="/Employee/TicketManagement" class="ticket-btn-primary" style="text-decoration:none;">
                <i class="fa-solid fa-plus"></i>
                Thêm vé mới
            </a>
        </div>
    </div>

    <div class="card ticket-table-card">
        <table class="ticket-table">
            <thead>
                <tr>
                    <th><input type="checkbox" /></th>
                    <th>Mã vé</th>
                    <th>Biển số xe</th>
                    <th>Khách hàng</th>
                    <th>Loại xe</th>
                    <th>Phí</th>
                    <th>Ngày vào</th>
                    <th>Ngày ra</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Tickets.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="ticket-empty-state">Không có vé phù hợp với bộ lọc hiện tại.</td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td class="ticket-code">@ticket.Code</td>
                            <td>@ticket.PlateNumber</td>
                            <td>@ticket.CustomerName</td>
                            <td>@ticket.Type</td>
                            <td>@ticket.Price.ToString("N0") đ</td>
                            <td>@ticket.CheckInTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(ticket.CheckOutTime != DateTime.MinValue ? ticket.CheckOutTime.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td>
                                <span class="ticket-status @ticket.StatusClass">
                                    @ticket.Status
                                </span>
                            </td>
                            <td>
                                <div class="ticket-actions">
                                    <button class="view" type="button" title="Xem"><i class="fa-solid fa-eye"></i></button>
                                    <button class="edit" type="button" title="Sửa"><i class="fa-solid fa-pen"></i></button>
                                    <button class="delete" type="button" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="ticket-pagination">
            <span>Hiển thị @Model.ShowingFrom đến @Model.ShowingTo trong tổng số @Model.TotalItems.ToString("N0") vé</span>

            <div>
                @if (Model.HasPreviousPage)
                {
                    <a class="ticket-page-link"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageNumber="@(Model.PageNumber - 1)">‹</a>
                }
                else
                {
                    <span class="ticket-page-link disabled">‹</span>
                }

                @for (var page = Model.StartPage; page <= Model.EndPage; page++)
                {
                    <a class="ticket-page-link @(page == Model.PageNumber ? "active" : "")"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageNumber="@(page)">@(page)</a>
                }

                @if (Model.HasNextPage)
                {
                    <a class="ticket-page-link"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageNumber="@(Model.PageNumber + 1)">›</a>
                }
                else
                {
                    <span class="ticket-page-link disabled">›</span>
                }
            </div>
        </div>
    </div>

</div>
