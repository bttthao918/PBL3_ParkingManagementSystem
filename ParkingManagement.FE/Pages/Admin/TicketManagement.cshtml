@page
@model ParkingManagement.FE.Pages.Admin.TicketManagementModel
@{
    ViewData["Title"] = "Quản lý vé lượt";
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Admin";
    ViewData["Role"] = "Quản trị hệ thống";
}

@section Styles {
    <link rel="stylesheet" href="/css/admin/admin_ticket.css" />
}

<div class="dashboard-content ticket-page">
    @if (!string.IsNullOrWhiteSpace(Model.LoadErrorMessage))
    {
        <div class="card" style="margin-bottom:12px; border-left:4px solid #c62828;">
            <p style="margin:0; color:#c62828;">@Model.LoadErrorMessage</p>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
    {
        <div class="card" style="margin-bottom:12px; border-left:4px solid @(Model.ActionSuccess ? "#2e7d32" : "#c62828");">
            <p style="margin:0; color:@(Model.ActionSuccess ? "#2e7d32" : "#c62828");">@Model.ActionMessage</p>
        </div>
    }

    <div class="ticket-header">
        <div>
            <h2>Quản lý vé</h2>
            <p>Quản lý danh sách vé lượt, tìm kiếm vé và theo dõi số liệu từ database</p>
        </div>

        <div class="ticket-header-actions">
            <button class="ticket-btn-outline js-pricing-toggle" type="button">
                <i class="fa-solid fa-tags"></i>
                Xem bảng giá
            </button>
        </div>
    </div>

    <div id="adminPricingPanel" class="card ticket-pricing-card">
        <div class="ticket-pricing-heading">
            <div>
                <h3>Bảng giá vé</h3>
                <p>Áp dụng cho vé lượt khi check-out xe và giá đăng ký vé tháng.</p>
            </div>

            <button class="ticket-pricing-close js-pricing-toggle" type="button" title="Đóng bảng giá">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="post" asp-page-handler="UpdatePricing" class="ticket-pricing-form" id="pricingUpdateForm">
            <input type="hidden" asp-for="Keyword" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="Type" />
            <input type="hidden" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" asp-for="PageNumber" />
            <input type="hidden" asp-for="PageSize" />

            <div class="price-grid">
                <div class="price-card green">
                    <div class="price-top">
                        <div class="price-icon">
                            <i class="fa-solid fa-motorcycle"></i>
                        </div>
                        <div>
                            <h4>Xe máy</h4>
                            <h2>@Model.PricingInput.MotorcycleHourlyRate.ToString("N0") đ <span>/ giờ</span></h2>
                        </div>
                    </div>
                    <div class="price-lines">
                        <label>
                            <span>Theo giờ</span>
                            <input asp-for="PricingInput.MotorcycleHourlyRate" type="number" min="1000" step="1000" />
                        </label>
                        <label>
                            <span>Tối đa / ngày</span>
                            <input asp-for="PricingInput.MotorcycleMaxDailyFee" type="number" min="1000" step="1000" />
                        </label>
                        <div>
                            <span>Tối thiểu</span>
                            <strong>15 phút</strong>
                        </div>
                    </div>
                </div>

                <div class="price-card blue">
                    <div class="price-top">
                        <div class="price-icon">
                            <i class="fa-solid fa-car"></i>
                        </div>
                        <div>
                            <h4>Ô tô nhỏ</h4>
                            <h2>@Model.PricingInput.SmallCarHourlyRate.ToString("N0") đ <span>/ giờ</span></h2>
                        </div>
                    </div>
                    <div class="price-lines">
                        <label>
                            <span>Theo giờ</span>
                            <input asp-for="PricingInput.SmallCarHourlyRate" type="number" min="1000" step="1000" />
                        </label>
                        <label>
                            <span>Tối đa / ngày</span>
                            <input asp-for="PricingInput.SmallCarMaxDailyFee" type="number" min="1000" step="1000" />
                        </label>
                        <div>
                            <span>Tối thiểu</span>
                            <strong>30 phút</strong>
                        </div>
                    </div>
                </div>

                <div class="price-card purple">
                    <div class="price-top">
                        <div class="price-icon">
                            <i class="fa-solid fa-truck"></i>
                        </div>
                        <div>
                            <h4>Ô tô lớn</h4>
                            <h2>@Model.PricingInput.LargeCarHourlyRate.ToString("N0") đ <span>/ giờ</span></h2>
                        </div>
                    </div>
                    <div class="price-lines">
                        <label>
                            <span>Theo giờ</span>
                            <input asp-for="PricingInput.LargeCarHourlyRate" type="number" min="1000" step="1000" />
                        </label>
                        <label>
                            <span>Tối đa / ngày</span>
                            <input asp-for="PricingInput.LargeCarMaxDailyFee" type="number" min="1000" step="1000" />
                        </label>
                        <div>
                            <span>Tối thiểu</span>
                            <strong>30 phút</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ticket-pricing-actions">
                <span>Cập nhật gần nhất: @Model.Pricing.LastUpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                <button class="ticket-btn-primary" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Lưu bảng giá
                </button>
            </div>
        </form>
    </div>

    <div class="ticket-kpi-grid">
        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon blue">
                <i class="fa-solid fa-ticket"></i>
            </div>
            <div>
                <p>Tổng số vé</p>
                <h2>@Model.TotalTickets.ToString("N0")</h2>
                <span>Tất cả vé trong hệ thống</span>
            </div>
        </div>

        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon green">
                <i class="fa-solid fa-car"></i>
            </div>
            <div>
                <p>Đang trong bãi</p>
                <h2>@Model.ActiveTickets.ToString("N0")</h2>
                <span>@Model.ActiveRate.ToString("0.0")%</span>
            </div>
        </div>

        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon orange">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <p>Đã ra</p>
                <h2>@Model.CheckedOutTickets.ToString("N0")</h2>
                <span>@Model.CheckedOutRate.ToString("0.0")%</span>
            </div>
        </div>

        <div class="card ticket-kpi-card">
            <div class="ticket-kpi-icon red">
                <i class="fa-solid fa-coins"></i>
            </div>
            <div>
                <p>Doanh thu vé lượt</p>
                <h2>@Model.TotalRevenue.ToString("N0") đ</h2>
                <span>Phí đã ghi nhận</span>
            </div>
        </div>
    </div>

    <div class="card ticket-search-card">
        <h3>Tìm kiếm vé</h3>

        <form method="get" class="ticket-filter-grid">
            <input type="hidden" name="PageNumber" value="1" />
            <input type="hidden" asp-for="PageSize" />
            <div class="ticket-input-group large">
                <label>Từ khóa</label>
                <input type="text" asp-for="Keyword" placeholder="Nhập mã vé hoặc biển số xe..." />
            </div>

            <div class="ticket-input-group">
                <label>Trạng thái</label>
                <select asp-for="Status">
                    <option value="">Tất cả</option>
                    <option value="Đang trong bãi">Đang trong bãi</option>
                    <option value="Đã ra">Đã ra</option>
                </select>
            </div>

            <div class="ticket-input-group">
                <label>Loại xe</label>
                <select asp-for="Type">
                    <option value="">Tất cả</option>
                    <option value="Xe máy">Xe máy</option>
                    <option value="Ô tô nhỏ">Ô tô nhỏ</option>
                    <option value="Ô tô lớn">Ô tô lớn</option>
                </select>
            </div>

            <div class="ticket-input-group">
                <label>Từ ngày</label>
                <input type="date" asp-for="FromDate" />
            </div>

            <div class="ticket-input-group">
                <label>Đến ngày</label>
                <input type="date" asp-for="ToDate" />
            </div>

            <button class="ticket-btn-primary search-btn" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i>
                Tìm
            </button>
        </form>

        <a asp-page="/Admin/TicketManagement" class="ticket-btn-outline" style="text-decoration:none;">
            <i class="fa-solid fa-filter-circle-xmark"></i>
            Xóa bộ lọc
        </a>
    </div>

    <div class="ticket-toolbar">
        <div class="ticket-tabs">
            <button class="active" type="button">
                <i class="fa-solid fa-list"></i>
                Danh sách vé
            </button>
        </div>

        <div class="ticket-toolbar-actions">
            <button class="ticket-btn-outline" type="button" onclick="window.print()">
                <i class="fa-solid fa-print"></i>
                In danh sách
            </button>
        </div>
    </div>

    <div class="card ticket-table-card">
        <table class="ticket-table">
            <thead>
                <tr>
                    <th><input type="checkbox" /></th>
                    <th>Mã vé</th>
                    <th>Biển số xe</th>
                    <th>Khách hàng</th>
                    <th>Loại xe</th>
                    <th>Phí</th>
                    <th>Ngày vào</th>
                    <th>Ngày ra</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Tickets.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="ticket-empty-state">Không có vé phù hợp với bộ lọc hiện tại.</td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td class="ticket-code">@ticket.Code</td>
                            <td>@ticket.PlateNumber</td>
                            <td>@ticket.CustomerName</td>
                            <td>@ticket.Type</td>
                            <td>@ticket.Price.ToString("N0") đ</td>
                            <td>@ticket.CheckInTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(ticket.CheckOutTime != DateTime.MinValue ? ticket.CheckOutTime.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td>
                                <span class="ticket-status @ticket.StatusClass">
                                    @ticket.Status
                                </span>
                            </td>
                            <td>
                                <div class="ticket-actions">
                                    <button class="view js-ticket-view"
                                            type="button"
                                            title="Xem"
                                            data-ticket-id="@ticket.Code"
                                            data-ticket-plate="@ticket.PlateNumber"
                                            data-ticket-customer="@ticket.CustomerName"
                                            data-ticket-type="@ticket.Type"
                                            data-ticket-fee="@ticket.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-ticket-fee-text="@($"{ticket.Price:N0} đ")"
                                            data-ticket-checkin="@ticket.CheckInTime.ToString("yyyy-MM-ddTHH:mm")"
                                            data-ticket-checkin-text="@ticket.CheckInTime.ToString("dd/MM/yyyy HH:mm")"
                                            data-ticket-checkout="@(ticket.CheckOutTime != DateTime.MinValue ? ticket.CheckOutTime.ToString("yyyy-MM-ddTHH:mm") : "")"
                                            data-ticket-checkout-text="@(ticket.CheckOutTime != DateTime.MinValue ? ticket.CheckOutTime.ToString("dd/MM/yyyy HH:mm") : "-")"
                                            data-ticket-status="@ticket.Status"
                                            data-ticket-slot="@ticket.SlotId">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="edit" type="button" title="Sửa"><i class="fa-solid fa-pen"></i></button>
                                    <button class="delete" type="button" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="ticket-pagination">
            <span>Hiển thị @Model.ShowingFrom đến @Model.ShowingTo trong tổng số @Model.TotalItems.ToString("N0") vé</span>

            <div>
                <span class="ticket-page-summary">Trang @Model.PageNumber/@Model.TotalPages</span>

                @if (Model.PageNumber > 1)
                {
                    <a class="ticket-page-link"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-pageNumber="1">&laquo;</a>
                }
                else
                {
                    <span class="ticket-page-link disabled">&laquo;</span>
                }

                @if (Model.HasPreviousPage)
                {
                    <a class="ticket-page-link"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageNumber="@(Model.PageNumber - 1)">‹</a>
                }
                else
                {
                    <span class="ticket-page-link disabled">‹</span>
                }

                @for (var page = Model.StartPage; page <= Model.EndPage; page++)
                {
                    <a class="ticket-page-link @(page == Model.PageNumber ? "active" : "")"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageNumber="@(page)">@(page)</a>
                }

                @if (Model.EndPage < Model.TotalPages)
                {
                    <span class="ticket-page-link disabled">...</span>
                    <a class="ticket-page-link"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-pageNumber="@Model.TotalPages">@Model.TotalPages</a>
                }

                @if (Model.HasNextPage)
                {
                    <a class="ticket-page-link"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageNumber="@(Model.PageNumber + 1)">›</a>
                }
                else
                {
                    <span class="ticket-page-link disabled">›</span>
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a class="ticket-page-link"
                       asp-page="/Admin/TicketManagement"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-status="@Model.Status"
                       asp-route-type="@Model.Type"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-pageNumber="@Model.TotalPages">&raquo;</a>
                }
                else
                {
                    <span class="ticket-page-link disabled">&raquo;</span>
                }
            </div>
        </div>
    </div>

    <div id="ticketViewModal" class="ticket-modal" hidden>
        <div class="ticket-modal-backdrop" data-close-modal></div>
        <div class="ticket-modal-dialog">
            <div class="ticket-modal-header">
                <h3>Chi tiết vé <span id="viewTicketId"></span></h3>
                <button type="button" class="ticket-modal-close" data-close-modal>
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="ticket-detail-grid">
                <div><span>Mã vé</span><strong id="viewCode"></strong></div>
                <div><span>Biển số xe</span><strong id="viewPlate"></strong></div>
                <div><span>Khách hàng</span><strong id="viewCustomer"></strong></div>
                <div><span>Loại xe</span><strong id="viewType"></strong></div>
                <div><span>Vị trí</span><strong id="viewSlot"></strong></div>
                <div><span>Phí</span><strong id="viewFee"></strong></div>
                <div><span>Ngày vào</span><strong id="viewCheckIn"></strong></div>
                <div><span>Ngày ra</span><strong id="viewCheckOut"></strong></div>
                <div><span>Trạng thái</span><strong id="viewStatus"></strong></div>
            </div>
        </div>
    </div>

    <div id="ticketEditModal" class="ticket-modal" hidden>
        <div class="ticket-modal-backdrop" data-close-modal></div>
        <div class="ticket-modal-dialog">
            <div class="ticket-modal-header">
                <h3>Sửa vé <span id="editTicketTitle"></span></h3>
                <button type="button" class="ticket-modal-close" data-close-modal>
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form method="post" asp-page-handler="UpdateTicket" class="ticket-modal-form">
                <input type="hidden" name="ticketId" id="editTicketId" />
                <input type="hidden" asp-for="Keyword" />
                <input type="hidden" asp-for="Status" />
                <input type="hidden" asp-for="Type" />
                <input type="hidden" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" asp-for="PageNumber" />
                <input type="hidden" asp-for="PageSize" />

                <label>
                    <span>Biển số xe</span>
                    <input name="vehiclePlate" id="editPlate" required maxlength="20" />
                </label>

                <label>
                    <span>Loại xe</span>
                    <select name="vehicleType" id="editType" required>
                        <option value="Xe máy">Xe máy</option>
                        <option value="Ô tô nhỏ">Ô tô nhỏ</option>
                        <option value="Ô tô lớn">Ô tô lớn</option>
                    </select>
                </label>

                <label>
                    <span>Ngày vào</span>
                    <input type="datetime-local" name="checkInTime" id="editCheckIn" required />
                </label>

                <label>
                    <span>Ngày ra</span>
                    <input type="datetime-local" name="checkOutTime" id="editCheckOut" />
                </label>

                <label>
                    <span>Trạng thái</span>
                    <select name="ticketStatus" id="editStatus" required>
                        <option value="Đang trong bãi">Đang trong bãi</option>
                        <option value="Đã ra">Đã ra</option>
                    </select>
                </label>

                <label>
                    <span>Phí</span>
                    <input type="number" name="fee" id="editFee" min="0" step="1000" required />
                </label>

                <label>
                    <span>Vị trí</span>
                    <input name="slotId" id="editSlot" maxlength="20" />
                </label>

                <div class="ticket-modal-actions">
                    <button type="button" class="ticket-btn-outline" data-close-modal>Hủy</button>
                    <button type="submit" class="ticket-btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>

    <div id="ticketDeleteModal" class="ticket-modal" hidden>
        <div class="ticket-modal-backdrop" data-close-modal></div>
        <div class="ticket-modal-dialog small">
            <div class="ticket-modal-header">
                <h3>Xóa vé</h3>
                <button type="button" class="ticket-modal-close" data-close-modal>
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <p class="ticket-delete-message">Bạn chắc chắn muốn xóa vé <strong id="deleteTicketTitle"></strong>?</p>

            <form method="post" asp-page-handler="DeleteTicket" class="ticket-modal-form">
                <input type="hidden" name="deleteTicketId" id="deleteTicketId" />
                <input type="hidden" asp-for="Keyword" />
                <input type="hidden" asp-for="Status" />
                <input type="hidden" asp-for="Type" />
                <input type="hidden" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" asp-for="PageNumber" />
                <input type="hidden" asp-for="PageSize" />

                <div class="ticket-modal-actions">
                    <button type="button" class="ticket-btn-outline" data-close-modal>Hủy</button>
                    <button type="submit" class="ticket-btn-danger">Xóa vé</button>
                </div>
            </form>
        </div>
    </div>

    <div id="pricingConfirmModal" class="pricing-confirm-modal" hidden>
        <div class="pricing-confirm-backdrop" data-close-pricing-confirm></div>
        <div class="pricing-confirm-dialog">
            <div class="pricing-confirm-icon">
                <span>?</span>
            </div>

            <h3>Cập nhật bảng giá</h3>
            <p>Bạn có chắc muốn lưu thay đổi bảng giá vé không?</p>

            <div class="pricing-confirm-actions">
                <button type="button" class="pricing-confirm-cancel" data-close-pricing-confirm>Hủy</button>
                <button type="button" class="pricing-confirm-approve" id="pricingConfirmApprove">Đồng ý</button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (() => {
            const viewModal = document.getElementById("ticketViewModal");
            const editModal = document.getElementById("ticketEditModal");
            const deleteModal = document.getElementById("ticketDeleteModal");
            const pricingPanel = document.getElementById("adminPricingPanel");
            const pricingForm = document.getElementById("pricingUpdateForm");
            const pricingConfirmModal = document.getElementById("pricingConfirmModal");
            const pricingConfirmApprove = document.getElementById("pricingConfirmApprove");

            const openModal = (modal) => {
                if (modal) modal.hidden = false;
            };

            const closeModals = () => {
                [viewModal, editModal, deleteModal].forEach((modal) => {
                    if (modal) modal.hidden = true;
                });
            };

            const openPricingConfirm = () => {
                if (pricingConfirmModal) pricingConfirmModal.hidden = false;
            };

            const closePricingConfirm = () => {
                if (pricingConfirmModal) pricingConfirmModal.hidden = true;
            };

            const text = (id, value) => {
                const element = document.getElementById(id);
                if (element) element.textContent = value || "-";
            };

            const getTicketData = (button) => {
                const actions = button.closest(".ticket-actions");
                const source = button.classList.contains("js-ticket-view")
                    ? button
                    : actions?.querySelector(".js-ticket-view");

                return source?.dataset || {};
            };

            document.querySelectorAll("[data-close-modal]").forEach((element) => {
                element.addEventListener("click", closeModals);
            });

            document.querySelectorAll("[data-close-pricing-confirm]").forEach((element) => {
                element.addEventListener("click", closePricingConfirm);
            });

            document.querySelectorAll(".js-pricing-toggle").forEach((button) => {
                button.addEventListener("click", () => {
                    if (pricingPanel) pricingPanel.hidden = !pricingPanel.hidden;
                });
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    closeModals();
                    closePricingConfirm();
                }
            });

            pricingForm?.addEventListener("submit", (event) => {
                if (pricingForm.dataset.confirmed === "true") {
                    delete pricingForm.dataset.confirmed;
                    return;
                }

                event.preventDefault();
                openPricingConfirm();
            });

            pricingConfirmApprove?.addEventListener("click", () => {
                closePricingConfirm();
                if (pricingForm instanceof HTMLFormElement) {
                    pricingForm.dataset.confirmed = "true";
                    pricingForm.requestSubmit();
                }
            });

            document.querySelectorAll(".js-ticket-view").forEach((button) => {
                button.addEventListener("click", () => {
                    const data = getTicketData(button);
                    text("viewTicketId", data.ticketId);
                    text("viewCode", data.ticketId);
                    text("viewPlate", data.ticketPlate);
                    text("viewCustomer", data.ticketCustomer);
                    text("viewType", data.ticketType);
                    text("viewSlot", data.ticketSlot);
                    text("viewFee", data.ticketFeeText);
                    text("viewCheckIn", data.ticketCheckinText);
                    text("viewCheckOut", data.ticketCheckoutText);
                    text("viewStatus", data.ticketStatus);
                    openModal(viewModal);
                });
            });

            document.querySelectorAll(".ticket-actions .edit").forEach((button) => {
                button.addEventListener("click", () => {
                    const data = getTicketData(button);
                    document.getElementById("editTicketId").value = data.ticketId || "";
                    document.getElementById("editTicketTitle").textContent = data.ticketId || "";
                    document.getElementById("editPlate").value = data.ticketPlate || "";
                    document.getElementById("editType").value = data.ticketType || "Xe máy";
                    document.getElementById("editCheckIn").value = data.ticketCheckin || "";
                    document.getElementById("editCheckOut").value = data.ticketCheckout || "";
                    document.getElementById("editStatus").value = data.ticketStatus || "Đang trong bãi";
                    document.getElementById("editFee").value = data.ticketFee || "0";
                    document.getElementById("editSlot").value = data.ticketSlot || "";
                    openModal(editModal);
                });
            });

            document.querySelectorAll(".ticket-actions .delete").forEach((button) => {
                button.addEventListener("click", () => {
                    const data = getTicketData(button);
                    document.getElementById("deleteTicketId").value = data.ticketId || "";
                    document.getElementById("deleteTicketTitle").textContent = data.ticketId || "";
                    openModal(deleteModal);
                });
            });
        })();
    </script>
}
