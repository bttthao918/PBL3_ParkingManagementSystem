@{
    Layout = "/Pages/Shared/_DashboardLayout.cshtml";
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
}

@section Styles {
    @RenderSection("Styles", required: false)
}

@section Sidebar {
    <a asp-page="/Customer/Dashboard"
           class="@(currentPath.Equals("/Customer/Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-house"></i> Tổng quan
    </a>

    <p>QUẢN LÝ</p>

    <a asp-page="/Customer/Booking"
           class="@(currentPath.Contains("/Customer/Booking", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-calendar-check"></i> Quản lý đặt chỗ
    </a>

    <a asp-page="/Customer/Ticket"
           class="@(currentPath.Contains("/Customer/Ticket", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-ticket"></i> Quản lý vé lượt
    </a>

    <a asp-page="/Customer/MonthlyTicket"
           class="@(currentPath.Contains("/Customer/MonthlyTicket", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-credit-card"></i> Quản lý vé tháng
    </a>

    <p>TÀI KHOẢN</p>

    <a asp-page="/Account/Profile"
           class="@(currentPath.Contains("/Account/Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-user-gear"></i> Thông tin tài khoản
    </a>

    <a asp-page="/Account/ChangePassword"
           class="@(currentPath.Contains("/Account/ChangePassword", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-lock"></i> Đổi mật khẩu
    </a>
}

@RenderBody()

@section Scripts {
    @RenderSection("Scripts", required: false)
}