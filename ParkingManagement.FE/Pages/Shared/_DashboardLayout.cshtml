@inject INotificationService NotificationService
@{
    var role = ViewData["Role"]?.ToString() ?? "";
    var userName = ViewData["UserName"]?.ToString() ?? "User";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var notificationCenter = User.Identity?.IsAuthenticated == true
        ? await NotificationService.GetNotificationsAsync(User)
        : new NotificationCenterViewModel();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@pageTitle - Parking Management</title>

    <link rel="stylesheet" href="~/css/shared/dashboard_layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/confirm-modal.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        /* User dropdown */
        .user-profile {
            position: relative;
            cursor: pointer;
            user-select: none;
        }
        .user-dropdown {            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.15);
            min-width: 180px;
            z-index: 1000;
            overflow: hidden;
            animation: fadeIn .15s ease;
        }
        .user-dropdown.open { display: block; }
        .user-dropdown a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 18px;
            color: #374151;
            text-decoration: none;
            font-size: 0.9rem;
            transition: background .15s;
        }
        .user-dropdown a:hover { background: #f3f4f6; }
        .user-dropdown .divider { height: 1px; background: #e5e7eb; margin: 4px 0; }
        .user-dropdown .logout-link { color: #ef4444 !important; }
        .user-dropdown .logout-link:hover { background: #fef2f2 !important; }
        @@keyframes fadeIn { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }
    </style>
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/shared/dashboard_readability.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <div class="logo">P</div>
                <div>
                    <h3>PARKING</h3>
                    <span>MANAGEMENT SYSTEM</span>
                </div>
            </div>

            <nav class="menu">
                @RenderSection("Sidebar", required: true)
            </nav>

            <div class="sidebar-support">
                <i class="fa-solid fa-headset"></i>
                <div>
                    <strong>Hỗ trợ</strong>
                    <span>1900 1234</span>
                </div>
            </div>

        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- TOPBAR -->
            <header class="topbar">

                <div class="topbar-left">
                    <i class="fa-solid fa-bars" id="sidebarToggle" style="cursor:pointer"></i>
                    <h1>@pageTitle</h1>
                </div>

                <div class="topbar-right">

                    <div class="notification-menu" id="notificationMenu">
                        <button class="notification"
                                id="notificationBtn"
                                type="button"
                                aria-label="Thông báo"
                                aria-expanded="false"
                                aria-controls="notificationBox">
                            <i class="fa-regular fa-bell"></i>
                            @if (notificationCenter.HasItems)
                            {
                                <span class="notification-badge">@notificationCenter.Count</span>
                            }
                        </button>

                        <div class="notification-box" id="notificationBox" role="menu" aria-label="Thông báo">
                            <div class="notification-head">
                                <h4>Thông báo</h4>
                                <span>@(notificationCenter.HasItems ? $"{notificationCenter.Count} mới" : "Đã cập nhật")</span>
                            </div>

                            @if (notificationCenter.HasItems)
                            {
                                @foreach (var item in notificationCenter.Items)
                                {
                                    <a class="notification-item @item.Type" href="@item.Url" role="menuitem">
                                        <span class="notification-icon @item.Type">
                                            <i class="@item.Icon"></i>
                                        </span>
                                        <span>
                                            <strong>@item.Title</strong>
                                            <p>@item.Message</p>
                                            <small>@item.TimeText</small>
                                        </span>
                                    </a>
                                }
                            }
                            else
                            {
                                <div class="notification-empty">
                                    <i class="fa-regular fa-circle-check"></i>
                                    <strong>Không có thông báo mới</strong>
                                    <p>Hệ thống hoạt động bình thường.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- USER PROFILE + DROPDOWN -->
                    <div class="user-profile" id="userProfileBtn" onclick="toggleUserDropdown()">
                        <div class="avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <strong>@userName</strong>
                            <span>@role</span>
                        </div>
                        <i class="fa-solid fa-chevron-down"></i>

                        <div class="user-dropdown" id="userDropdown">
                            <a href="/Account/Profile">
                                <i class="fa-solid fa-user-gear"></i> Thông tin tài khoản
                            </a>
                            <a href="/Account/ChangePassword">
                                <i class="fa-solid fa-lock"></i> Đổi mật khẩu
                            </a>
                            <div class="divider"></div>
                            <a href="/Account/Logout"
                               class="logout-link"
                               data-confirm-title="Đăng xuất"
                               data-confirm-message="Bạn có chắc muốn đăng xuất khỏi tài khoản hiện tại?"
                               data-confirm-type="warning">
                                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                            </a>
                        </div>
                    </div>

                </div>

            </header>

            <!-- CONTENT RIÊNG CỦA TỪNG ROLE -->
            <section class="dashboard-content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script>
        const notificationMenu = document.getElementById("notificationMenu");
        const notificationBtn = document.getElementById("notificationBtn");
        const notificationBox = document.getElementById("notificationBox");
        const userProfileBtn = document.getElementById("userProfileBtn");
        const userDropdown = document.getElementById("userDropdown");

        function closeNotification() {
            notificationBox?.classList.remove("show");
            notificationBtn?.setAttribute("aria-expanded", "false");
        }

        function toggleNotification() {
            const shouldOpen = !notificationBox?.classList.contains("show");
            userDropdown?.classList.remove("open");
            notificationBox?.classList.toggle("show", shouldOpen);
            notificationBtn?.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
        }

        function toggleUserDropdown() {
            userDropdown?.classList.toggle("open");
            closeNotification();
        }

        notificationBtn?.addEventListener("click", function (e) {
            e.stopPropagation();
            toggleNotification();
        });

        notificationBox?.addEventListener("click", function (e) {
            e.stopPropagation();
        });

        // Đóng dropdown khi click ra ngoài
        document.addEventListener("click", function (e) {
            if (!userProfileBtn?.contains(e.target)) {
                userDropdown?.classList.remove("open");
            }
            if (!notificationMenu?.contains(e.target)) {
                closeNotification();
            }
            document.querySelectorAll(".month-picker[open]").forEach(function (picker) {
                if (!picker.contains(e.target)) {
                    picker.removeAttribute("open");
                }
            });
        });

        function padMonth(month) {
            return String(month).padStart(2, "0");
        }

        function updateMonthPicker(picker) {
            const currentYear = Number(picker.dataset.currentYear || new Date().getFullYear());
            const currentMonth = Number(picker.dataset.currentMonth || (new Date().getMonth() + 1));
            let selectedYear = Number(picker.dataset.selectedYear || currentYear);
            let selectedMonth = Number(picker.dataset.selectedMonth || currentMonth);

            if (selectedYear > currentYear) {
                selectedYear = currentYear;
            }

            if (selectedYear === currentYear && selectedMonth > currentMonth) {
                selectedMonth = currentMonth;
            }

            picker.dataset.selectedYear = selectedYear;
            picker.dataset.selectedMonth = selectedMonth;

            picker.querySelectorAll("[data-month-option]").forEach(function (button) {
                const month = Number(button.dataset.monthValue);
                const isFuture = selectedYear > currentYear || (selectedYear === currentYear && month > currentMonth);
                const isActive = month === selectedMonth;
                button.disabled = isFuture;
                button.classList.toggle("active", isActive);
                button.setAttribute("aria-pressed", isActive ? "true" : "false");
            });

            picker.querySelectorAll("[data-year-option]").forEach(function (button) {
                const isActive = Number(button.dataset.yearValue) === selectedYear;
                button.classList.toggle("active", isActive);
                button.setAttribute("aria-pressed", isActive ? "true" : "false");
            });

            const value = `${selectedYear}-${padMonth(selectedMonth)}`;
            const hiddenValue = picker.querySelector("[data-month-picker-value]");
            if (hiddenValue) hiddenValue.value = value;
            picker.querySelector("[data-month-picker-label]")?.replaceChildren(`Tháng ${padMonth(selectedMonth)}/${selectedYear}`);
        }

        function resetMonthPicker(picker) {
            picker.dataset.selectedYear = picker.dataset.committedYear || picker.dataset.currentYear || new Date().getFullYear();
            picker.dataset.selectedMonth = picker.dataset.committedMonth || picker.dataset.currentMonth || (new Date().getMonth() + 1);
            updateMonthPicker(picker);
        }

        function setupMonthPicker(picker) {
            if (picker.dataset.bound === "true") return;
            picker.dataset.bound = "true";

            updateMonthPicker(picker);

            picker.querySelectorAll("[data-month-option]").forEach(function (button) {
                button.addEventListener("click", function () {
                    picker.dataset.selectedMonth = button.dataset.monthValue;
                    updateMonthPicker(picker);
                });
            });

            picker.querySelectorAll("[data-year-option]").forEach(function (button) {
                button.addEventListener("click", function () {
                    picker.dataset.selectedYear = button.dataset.yearValue;
                    updateMonthPicker(picker);
                });
            });

            picker.querySelector("[data-month-picker-cancel]")?.addEventListener("click", function () {
                resetMonthPicker(picker);
                picker.removeAttribute("open");
            });

            picker.addEventListener("toggle", function () {
                if (!picker.open) return;
                resetMonthPicker(picker);
                document.querySelectorAll(".month-picker[open]").forEach(function (otherPicker) {
                    if (otherPicker !== picker) {
                        otherPicker.removeAttribute("open");
                    }
                });
            });
        }

        document.querySelectorAll("[data-month-picker]").forEach(setupMonthPicker);

        // Sidebar toggle (mobile)
        document.getElementById("sidebarToggle")?.addEventListener("click", function () {
            document.querySelector(".sidebar").classList.toggle("collapsed");
        });
    </script>

    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/auto-filter.js" asp-append-version="true"></script>
    <script src="~/js/realtime-updates.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
