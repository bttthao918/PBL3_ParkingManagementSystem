@{
    var role = Context.Session.GetString("user_role") ?? "";
    var userName = Context.Session.GetString("user_name") ?? "User";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@pageTitle - Parking Management</title>
    <link rel="stylesheet" href="~/css/shared/dashboard_layout.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="dashboard-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="brand">
                <div class="logo">P</div>
                <div>
                    <h3>PARKING</h3>
                    <span>MANAGEMENT SYSTEM</span>
                </div>
            </div>

            <nav class="menu">
                @if (role == "Manager")
                {
                    <p>MAIN MENU</p>
                    <a href="/Admin/Dashboard" class="@(IsActive("Admin/Dashboard") ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i> Tổng quan
                    </a>
                    <a href="/Admin/TicketManagement" class="@(IsActive("Admin/TicketManagement") ? "active" : "")">
                        <i class="fa-solid fa-ticket"></i> Quản lý vé
                    </a>
                    <a href="/Admin/ParkingSlotManagement" class="@(IsActive("Admin/ParkingSlotManagement") ? "active" : "")">
                        <i class="fa-solid fa-square-parking"></i> Chỗ đỗ xe
                    </a>
                    <a href="/Admin/EmployeeManagement" class="@(IsActive("Admin/EmployeeManagement") ? "active" : "")">
                        <i class="fa-solid fa-users"></i> Nhân viên
                    </a>
                    <a href="/Admin/CustomerStatistics" class="@(IsActive("Admin/CustomerStatistics") ? "active" : "")">
                        <i class="fa-solid fa-user-group"></i> Khách hàng
                    </a>
                    <a href="/Admin/RevenueStatistics" class="@(IsActive("Admin/RevenueStatistics") ? "active" : "")">
                        <i class="fa-solid fa-chart-line"></i> Báo cáo
                    </a>
                }
                else if (role == "Employee")
                {
                    <p>VẬN HÀNH</p>
                    <a href="/Employee/Dashboard" class="@(IsActive("Employee/Dashboard") ? "active" : "")">
                        <i class="fa-solid fa-house"></i> Tổng quan
                    </a>
                    <a href="/Employee/CustomerManagement" class="@(IsActive("Employee/CustomerManagement") ? "active" : "")">
                        <i class="fa-solid fa-users"></i> Khách hàng
                    </a>
                    <a href="/Employee/TicketManagement" class="@(IsActive("Employee/TicketManagement") ? "active" : "")">
                        <i class="fa-solid fa-ticket"></i> Quản lý vé
                    </a>
                    <a href="/Employee/ParkingSlotManagement" class="@(IsActive("Employee/ParkingSlotManagement") ? "active" : "")">
                        <i class="fa-solid fa-square-parking"></i> Chỗ đỗ xe
                    </a>
                    <p>THỐNG KÊ</p>
                    <a href="/Employee/PersonalReport" class="@(IsActive("Employee/PersonalReport") ? "active" : "")">
                        <i class="fa-solid fa-chart-user"></i> Báo cáo cá nhân
                    </a>
                    <a href="/Employee/RevenueStatistics" class="@(IsActive("Employee/RevenueStatistics") ? "active" : "")">
                        <i class="fa-solid fa-chart-line"></i> Doanh thu
                    </a>
                }
                else if (role == "Customer")
                {
                    <p>QUẢN LÝ</p>
                    <a href="/Customer/Dashboard" class="@(IsActive("Customer/Dashboard") ? "active" : "")">
                        <i class="fa-solid fa-house"></i> Tổng quan
                    </a>
                    <a href="/Customer/Booking/Index" class="@(IsActive("Customer/Booking") ? "active" : "")">
                        <i class="fa-solid fa-calendar-check"></i> Đơn đặt chỗ
                    </a>
                    <a href="/Customer/MyTickets" class="@(IsActive("Customer/MyTickets") ? "active" : "")">
                        <i class="fa-solid fa-ticket"></i> Vé xe
                    </a>
                    <a href="/Customer/MonthlyPass" class="@(IsActive("Customer/MonthlyPass") ? "active" : "")">
                        <i class="fa-solid fa-credit-card"></i> Vé tháng
                    </a>
                }

                <p>TÀI KHOẢN</p>
                <a href="/Account/Profile" class="@(IsActive("Account/Profile") ? "active" : "")">
                    <i class="fa-solid fa-user-gear"></i> Thông tin tài khoản
                </a>
                <a href="/Account/ChangePassword" class="@(IsActive("Account/ChangePassword") ? "active" : "")">
                    <i class="fa-solid fa-lock"></i> Đổi mật khẩu
                </a>
                <a href="/Account/Logout">
                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                </a>
            </nav>

            <div class="sidebar-support">
                <i class="fa-solid fa-headset"></i>
                <div>
                    <strong>Hỗ trợ</strong>
                    <span>1900 1234</span>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main">
            <header class="topbar">
                <div class="topbar-left">
                    <i class="fa-solid fa-bars" id="sidebarToggle"></i>
                    <h1>@pageTitle</h1>
                </div>
                <div class="topbar-right">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Tìm kiếm..." id="globalSearch" />
                    </div>
                    <div class="user-profile" id="userProfileBtn">
                        <div class="avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <strong>@userName</strong>
                            <span>@(role == "Manager" ? "Quản trị viên" : role == "Employee" ? "Nhân viên" : "Khách hàng")</span>
                        </div>
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                </div>
            </header>

            <section class="dashboard-content">
                @RenderBody()
            </section>

            <!-- FOOTER TRONG DASHBOARD -->
            <footer class="dashboard-footer">
                <div class="footer-content">
                    <p>&copy; @DateTime.Now.Year - Parking Management System</p>
                    <div class="footer-links">
                        <a href="#">Điều khoản</a>
                        <a href="#">Bảo mật</a>
                        <a href="#">Liên hệ</a>
                    </div>
                </div>
            </footer>
        </main>
    </div>

    <script>
            // Toggle sidebar
            document.getElementById("sidebarToggle")?.addEventListener("click", function() {
                document.querySelector(".sidebar").classList.toggle("collapsed");
            });

            // User dropdown
            document.getElementById("userProfileBtn")?.addEventListener("click", function() {
                // Xử lý dropdown nếu cần
                window.location.href = "/Account/Profile";
            });

            // Search
            document.getElementById("globalSearch")?.addEventListener("keypress", function(e) {
                if (e.key === "Enter") {
                    alert("Tìm kiếm: " + this.value);
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private bool IsActive(string pageName)
    {
        var path = Context.Request.Path.Value ?? "";
        return path.Contains(pageName, StringComparison.OrdinalIgnoreCase);
    }
}