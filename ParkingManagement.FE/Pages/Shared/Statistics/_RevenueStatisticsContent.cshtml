@model ParkingManagement.FE.Models.ViewModels.IRevenueStatisticsViewModel

<div class="dashboard-content statistics-page">
    <partial name="/Pages/Shared/Statistics/_StatisticsHeader.cshtml" model="Model.Header" />

    <div class="stat-kpi-grid">
        @foreach (var kpi in Model.Kpis)
        {
            <partial name="/Pages/Shared/Statistics/_StatisticsKpiCard.cshtml" model="kpi" />
        }
    </div>

    <div class="stat-main-grid">
        <div class="card stat-chart-card large">
            <div class="stat-card-title">
                <h3>@Model.LineChartTitle</h3>
                <span>@Model.Header.DateRangeText</span>
            </div>
            <canvas id="mainLineChart"></canvas>
        </div>

        <div class="card stat-chart-card">
            <h3>@Model.DonutTitle</h3>

            <div class="stat-donut-layout">
                <canvas id="mainDonutChart"></canvas>

                <div class="stat-donut-legend">
                    @foreach (var item in Model.DonutItems)
                    {
                        <div>
                            <span class="dot @item.ColorClass"></span>
                            <strong>@item.Label</strong>
                            <p>@item.Value</p>
                            <small>@item.Percentage.ToString("N1")%</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="stat-bottom-grid">
        <div class="card stat-chart-card">
            <div class="stat-card-title">
                <h3>@Model.BarTitle</h3>
                <span>Dữ liệu thực tế</span>
            </div>
            <canvas id="mainBarChart"></canvas>
        </div>

        <div class="card stat-list-card">
            <h3>@Model.RankTitle</h3>
            <div class="stat-rank-list">
                @if (Model.RankItems.Count == 0)
                {
                    <p class="stat-empty">Chưa có dữ liệu trong khoảng thời gian này.</p>
                }
                else
                {
                    @foreach (var item in Model.RankItems)
                    {
                        <div>
                            <b>@item.Rank</b>
                            <span>@item.Label</span>
                            <strong>@item.Value</strong>
                            <em class="@item.ChangeClass">@item.ChangeText</em>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card stat-side-card">
            <h3>@Model.ProgressTitle</h3>

            @foreach (var item in Model.ProgressItems)
            {
                var width = Math.Clamp(item.Percentage, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                <div class="stat-progress-row">
                    <div>
                        <span>@item.Label</span>
                        <strong>@item.Value</strong>
                    </div>
                    <div class="stat-progress">
                        <span class="@item.ColorClass" style="width: @width%"></span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card stat-table-card">
        <div class="stat-card-title">
            <h3>Chi tiết doanh thu theo ngày</h3>
            <span>@Model.Header.DateRangeText</span>
        </div>

        <partial name="/Pages/Shared/Statistics/_StatisticsTable.cshtml" model="Model.Table" />
    </div>
</div>
