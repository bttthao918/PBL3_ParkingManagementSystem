@model ParkingManagement.FE.Models.ViewModels.StatisticsTableViewModel

<table class="stat-table">
    <thead>
        <tr>
            @foreach (var header in Model.Headers)
            {
                <th>@header</th>
            }
        </tr>
    </thead>

    <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="@Model.Headers.Count" class="stat-table-empty">Chưa có dữ liệu trong khoảng thời gian này.</td>
            </tr>
        }
        else
        {
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @foreach (var col in row)
                    {
                        <td>@col</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
