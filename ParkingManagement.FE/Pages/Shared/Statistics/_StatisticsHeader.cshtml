@model ParkingManagement.FE.Models.ViewModels.StatisticsHeaderViewModel

<div class="stat-header">
    <div>
        <h2>@Model.Title</h2>
        <p>@Model.Description</p>
    </div>

    <div class="stat-date-filter">
        <span class="stat-date-range">
            <i class="fa-solid fa-calendar-days"></i>
            @Model.DateRangeText
        </span>
        <a href="?period=today" class="@(Model.ActivePeriod == "today" ? "active" : "")">Hôm nay</a>
        <a href="?period=7days" class="@(Model.ActivePeriod == "7days" ? "active" : "")">7 ngày</a>
        <a href="?period=30days" class="@(Model.ActivePeriod == "30days" || string.IsNullOrEmpty(Model.ActivePeriod) ? "active" : "")">30 ngày</a>
    </div>
</div>
