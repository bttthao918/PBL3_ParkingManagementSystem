@{
    Layout = "/Pages/Shared/_DashboardLayout.cshtml";
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
    var dashboardView = ViewContext.HttpContext.Request.Query["view"].ToString();
    var isDashboardPath = currentPath.Equals("/Admin/Dashboard", StringComparison.OrdinalIgnoreCase);
    var isSummaryView = dashboardView.Equals("summary", StringComparison.OrdinalIgnoreCase);
}

@* Cho phép các trang con nhúng CSS riêng *@
@section Styles {
    @RenderSection("Styles", required: false)
}

@* KHUNG SIDEBAR DÙNG CHUNG CHO TOÀN BỘ ADMIN *@
@section Sidebar {
    <a asp-page="/Admin/Dashboard" class="@(isDashboardPath && !isSummaryView ? "active" : "")">
        <i class="fa-solid fa-house"></i> Tổng quan
    </a>

    <p>QUẢN LÝ</p>
    <a asp-page="/Admin/TicketManagement" class="@(currentPath.Contains("/Admin/TicketManagement", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-ticket"></i> Quản lý vé lượt
    </a>
    
    <a asp-page="/Admin/MonthlyTicketManagement" class="@(currentPath.Contains("/Admin/MonthlyTicketManagement", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-id-card"></i> Quản lý vé tháng
    </a>
    
    <a asp-page="/Admin/EmployeeManagement" class="@(currentPath.Contains("/Admin/EmployeeManagement", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-users"></i> Quản lý nhân viên
    </a>
    
    <a asp-page="/Admin/ParkingSlotManagement"
           class="@(currentPath.Contains("/Admin/ParkingSlotManagement", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-square-parking"></i>
        Quản lý chỗ đỗ
    </a>

    <p>TÀI KHOẢN</p>
    <a asp-page="/Account/Profile"
           class="@(currentPath.Contains("/Account/Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-user-gear"></i> Thông tin tài khoản
    </a>
    <a asp-page="/Account/ChangePassword"
           class="@(currentPath.Contains("/Account/ChangePassword", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <i class="fa-solid fa-lock"></i> Đổi mật khẩu
    </a>
}

@* CODE CỦA CÁC TRANG (GIAO DIỆN TỪNG CHỨC NĂNG CHÍNH) SẼ NẰM Ở ĐÂY *@
@RenderBody()

@section Scripts {
    @RenderSection("Scripts", required: false)
}
