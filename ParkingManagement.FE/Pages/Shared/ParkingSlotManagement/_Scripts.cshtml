@* Model can be either Employee or Shared ParkingSlotManagementModel - both have same properties *@

<script>
    const slots = @Html.Raw(Model.SlotsJson);
    const beApiUrl = 'http://localhost:5188';

    let currentZone = "A";
    let currentSlot = null;

    function getStatusClass(status) {
        switch (status) {
            case "Trống": return "available";
            case "Đang sử dụng": return "using";
            case "Đã đặt": return "booked";
            case "Bảo trì": return "maintenance";
            case "Sự cố": return "error";
            default: return "available";
        }
    }

    function renderSlots() {
        const grid = document.getElementById("slotGrid");
        const statusFilter = document.getElementById("statusFilter").value;
        const keyword = normalizeSlotSearch(document.getElementById("slotSearch").value);

        grid.innerHTML = "";
        grid.className = currentZone === "C"
            ? "parking-slot-grid zone-c"
            : "parking-slot-grid zone-a";

        const filteredSlots = slots.filter(slot => {
            const matchZone = slot.slotId.startsWith(currentZone);
            const matchStatus = !statusFilter || slot.status === statusFilter;
            const matchKeyword = !keyword || Object.values(slot)
                .some(value => matchesSlotSearchValue(value, keyword));
            return matchZone && matchStatus && matchKeyword;
        });

        filteredSlots.forEach(slot => {
            const statusClass = getStatusClass(slot.status);

            const item = document.createElement("button");
            item.className = `parking-slot ${statusClass}`;
            item.dataset.slotId = slot.slotId;
            item.onclick = () => openSlotDetail(slot);

            item.innerHTML = `
                <strong>${slot.slotId}</strong>
                <span>${slot.status}</span>
                <small>${slot.lastUpdatedText}</small>
            `;

            grid.appendChild(item);
        });

        if (filteredSlots.length === 0) {
            currentSlot = null;
            highlightSelectedSlot("");
            closeSlotDetail();
            return;
        }

        const visibleSelectedSlot = currentSlot
            ? filteredSlots.find(slot => slot.slotId === currentSlot.slotId)
            : null;

        if (!visibleSelectedSlot) {
            currentSlot = null;
            highlightSelectedSlot("");
            closeSlotDetail();
        }
    }

    function normalizeSlotSearch(value) {
        return String(value ?? "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/g, "d")
            .replace(/Đ/g, "D")
            .trim()
            .toLowerCase();
    }

    function matchesSlotSearchValue(value, keyword) {
        const normalizedValue = normalizeSlotSearch(value);
        const compactValue = normalizedValue.replace(/[^\p{L}\p{N}]/gu, "");
        const compactKeyword = keyword.replace(/[^\p{L}\p{N}]/gu, "");
        return normalizedValue.includes(keyword) ||
            (compactKeyword.length > 0 && compactValue.includes(compactKeyword));
    }

    function changeZone(zone) {
        currentZone = zone;
        currentSlot = null;
        document.getElementById("zoneFilter").value = zone;

        document.querySelectorAll(".parking-zone-tabs button").forEach(btn => {
            btn.classList.remove("active");
        });

        document.querySelector(`.parking-zone-tabs button[data-zone="${zone}"]`).classList.add("active");

        renderSlots();
    }

    function openSlotDetail(slot) {
        showDetail(slot);
        const overlay = document.getElementById("detailOverlay");
        overlay.classList.add("open");
        overlay.setAttribute("aria-hidden", "false");
        document.body.classList.add("parking-modal-open");
    }

    function closeSlotDetail() {
        const overlay = document.getElementById("detailOverlay");
        overlay.classList.remove("open");
        overlay.setAttribute("aria-hidden", "true");
        document.body.classList.remove("parking-modal-open");
        cancelUpdateStatus();
        document.getElementById("slotHistorySection").style.display = "none";
    }

    function showDetail(slot) {
        currentSlot = slot;
        highlightSelectedSlot(slot.slotId);

        const statusClass = getStatusClass(slot.status);
        const zoneName = slot.slotId.startsWith("A") ? "Khu A" : slot.slotId.startsWith("B") ? "Khu B" : "Khu C";

        document.getElementById("detailSlotIcon").textContent = slot.slotId;
        document.getElementById("detailSlotIcon").className = `detail-slot-icon ${statusClass}`;

        document.getElementById("detailTitle").textContent = `Chỗ đỗ ${slot.slotId}`;
        document.getElementById("detailStatus").textContent = slot.status;
        document.getElementById("detailStatus").className = `parking-status ${statusClass}`;

        document.getElementById("detailZone").textContent = zoneName;
        document.getElementById("detailVehicleType").textContent = slot.vehicleType;
        document.getElementById("detailLocation").textContent = slot.location;
        document.getElementById("detailUpdated").textContent = slot.lastUpdatedFull;

        // Show/hide occupant info
        var occupantSection = document.getElementById("occupantSection");
        if (slot.currentOccupant && slot.status === "Đang sử dụng") {
            occupantSection.style.display = "block";
            document.getElementById("detailPlate").textContent = slot.currentOccupant;
            document.getElementById("detailOccupiedSince").textContent = slot.lastUpdatedFull;
        } else {
            occupantSection.style.display = "none";
        }

        // Hide forms
        document.getElementById("updateStatusForm").style.display = "none";
        document.getElementById("slotHistorySection").style.display = "none";

        // Show/hide update button based on status
        var btnUpdate = document.getElementById("btnUpdateStatus");
        if (slot.status === "Đang sử dụng" || slot.status === "Đã đặt") {
            btnUpdate.style.display = "none";
        } else {
            btnUpdate.style.display = "inline-flex";
        }
    }

    function highlightSelectedSlot(slotId) {
        document.querySelectorAll(".parking-slot").forEach(item => {
            item.classList.toggle("selected", item.dataset.slotId === slotId);
        });
    }

    function showEmptyDetail() {
        currentSlot = null;
        document.getElementById("detailSlotIcon").textContent = "-";
        document.getElementById("detailSlotIcon").className = "detail-slot-icon maintenance";
        document.getElementById("detailTitle").textContent = "Không có chỗ đỗ";
        document.getElementById("detailStatus").textContent = "Không có dữ liệu";
        document.getElementById("detailStatus").className = "parking-status maintenance";
        document.getElementById("detailZone").textContent = currentZone === "A" ? "Khu A" : currentZone === "B" ? "Khu B" : "Khu C";
        document.getElementById("detailVehicleType").textContent = "-";
        document.getElementById("detailLocation").textContent = "Không có ô phù hợp bộ lọc";
        document.getElementById("detailUpdated").textContent = "-";
        document.getElementById("occupantSection").style.display = "none";
        document.getElementById("updateStatusForm").style.display = "none";
        document.getElementById("slotHistorySection").style.display = "none";
        document.getElementById("btnUpdateStatus").style.display = "none";
        highlightSelectedSlot("");
    }

    function updateSlotStatus() {
        if (!currentSlot) return;
        document.getElementById("newStatusSelect").value = currentSlot.status === "Bảo trì" ? "Trống" : "Bảo trì";
        document.getElementById("updateStatusForm").style.display = "block";
    }

    function cancelUpdateStatus() {
        document.getElementById("updateStatusForm").style.display = "none";
    }

    function confirmUpdateStatus() {
        if (!currentSlot) return;
        const slotId = currentSlot.slotId;
        const oldStatus = currentSlot.status;
        const newStatus = document.getElementById("newStatusSelect").value;

        if (newStatus === oldStatus) {
            cancelUpdateStatus();
            return;
        }

        confirmAction(
            "C\u1eadp nh\u1eadt tr\u1ea1ng th\u00e1i ch\u1ed7 \u0111\u1ed7",
            `B\u1ea1n c\u00f3 ch\u1eafc mu\u1ed1n \u0111\u1ed5i ch\u1ed7 ${slotId} t\u1eeb "${oldStatus}" sang "${newStatus}"?`,
            () => updateSlotStatusRequest(slotId, newStatus),
            newStatus === "B\u1ea3o tr\u00ec" ? "warning" : "info"
        );
    }

    function updateSlotStatusRequest(slotId, newStatus) {
        const confirmButton = document.getElementById("btnConfirmSlotStatus");
        if (confirmButton) {
            confirmButton.disabled = true;
        }

        fetch(`${beApiUrl}/api/parking-slots/${slotId}/status?employeeId=EMP001`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: newStatus })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success !== false) {
                // Update local data
                var s = slots.find(x => x.slotId === slotId);
                if (s) {
                    s.status = newStatus;
                    s.lastUpdatedFull = new Date().toLocaleString('vi-VN');
                    s.lastUpdatedText = new Date().toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'});
                }
                renderSlots();
                showDetail(s || currentSlot);
                cancelUpdateStatus();
            } else {
                showNotice('Không thể cập nhật', data.message || 'Cập nhật thất bại', 'danger');
            }
        })
        .catch(() => {
            // Fallback: reload page
            location.reload();
        })
        .finally(() => {
            if (confirmButton) {
                confirmButton.disabled = false;
            }
        });
    }

    function showSlotHistory() {
        if (!currentSlot) return;
        var section = document.getElementById("slotHistorySection");
        var list = document.getElementById("slotHistoryList");
        section.style.display = "block";
        list.innerHTML = "Đang tải...";

        fetch(`${beApiUrl}/api/parking-slots/${currentSlot.slotId}/audit-logs`)
        .then(r => r.json())
        .then(data => {
            if (data && data.length > 0) {
                list.innerHTML = data.slice(0, 5).map(item =>
                    `<div style="padding:6px 0; border-bottom:1px solid #f1f5f9;">
                        <strong>${item.oldStatus || '?'}</strong> → <strong>${item.newStatus || '?'}</strong>
                        <br><small style="color:#94a3b8;">${item.changedAt || ''}</small>
                    </div>`
                ).join('');
            } else {
                list.innerHTML = '<span style="color:#94a3b8;">Chưa có lịch sử</span>';
            }
        })
        .catch(() => {
            list.innerHTML = '<span style="color:#94a3b8;">Không thể tải lịch sử</span>';
        });
    }

    function resetParkingFilter() {
        document.getElementById("statusFilter").value = "";
        document.getElementById("slotSearch").value = "";
        currentSlot = null;
        renderSlots();
    }

    document.getElementById("zoneFilter").addEventListener("change", function () {
        changeZone(this.value);
    });

    document.getElementById("statusFilter").addEventListener("change", renderSlots);
    document.getElementById("slotSearch").addEventListener("input", renderSlots);
    document.getElementById("detailOverlay").addEventListener("click", function (event) {
        if (event.target === this) {
            closeSlotDetail();
        }
    });
    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && document.getElementById("detailOverlay").classList.contains("open")) {
            closeSlotDetail();
        }
    });

    renderSlots();
</script>
