@* Model can be either Employee, Admin, or Shared ParkingSlotManagementModel - all have same properties *@

<div class="dashboard-content parking-page">

    <div class="parking-header">
        <div>
            <h2>Quản lý chỗ đỗ</h2>
            <p>Theo dõi trạng thái và xem chi tiết từng vị trí đỗ</p>
        </div>
    </div>

    <div class="parking-kpi-grid">
        <div class="card parking-kpi-card">
            <div class="parking-kpi-icon blue">
                <i class="fa-solid fa-square-parking"></i>
            </div>
            <div>
                <p>Tổng chỗ đỗ</p>
                <h2>120</h2>
                <span>Khu A 50 · Khu B 50 · Khu C 20</span>
            </div>
        </div>

        <div class="card parking-kpi-card">
            <div class="parking-kpi-icon green">
                <i class="fa-solid fa-check"></i>
            </div>
            <div>
                <p>Đang trống</p>
                <h2>@Model.AvailableCount</h2>
                <span>Có thể sử dụng</span>
            </div>
        </div>

        <div class="card parking-kpi-card">
            <div class="parking-kpi-icon orange">
                <i class="fa-solid fa-car"></i>
            </div>
            <div>
                <p>Đang sử dụng</p>
                <h2>@Model.UsingCount</h2>
                <span>Đang có xe</span>
            </div>
        </div>

        <div class="card parking-kpi-card">
            <div class="parking-kpi-icon purple">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
                <p>Đã đặt</p>
                <h2>@Model.BookedCount</h2>
                <span>Chờ nhận chỗ</span>
            </div>
        </div>
    </div>

    <div class="card parking-filter-card">
        <div class="parking-filter-grid">
            <div class="parking-field">
                <label>Khu vực</label>
                <select id="zoneFilter">
                    <option value="A">Khu A - Xe máy</option>
                    <option value="B">Khu B - Ô tô nhỏ</option>
                    <option value="C">Khu C - Ô tô lớn</option>
                </select>
            </div>

            <div class="parking-field">
                <label>Trạng thái</label>
                <select id="statusFilter">
                    <option value="">Tất cả</option>
                    <option value="Trống">Trống</option>
                    <option value="Đang sử dụng">Đang sử dụng</option>
                    <option value="Đã đặt">Đã đặt</option>
                    <option value="Bảo trì">Bảo trì</option>
                    <option value="Sự cố">Sự cố</option>
                </select>
            </div>

            <div class="parking-field">
                <label>Tìm kiếm</label>
                <input id="slotSearch" type="search" autocomplete="off" placeholder="Nhập thông tin chỗ đỗ cần tìm..." />
            </div>

            <button class="parking-btn-outline" onclick="resetParkingFilter()">
                <i class="fa-solid fa-rotate-right"></i>
                Làm mới
            </button>
        </div>
    </div>

    <div class="parking-main-grid">

        <div class="card parking-map-card">

            <div class="parking-zone-tabs">
                <button class="active" data-zone="A" onclick="changeZone('A')">
                    <strong>Khu A</strong>
                    <span>Xe máy · 50 chỗ</span>
                </button>

                <button data-zone="B" onclick="changeZone('B')">
                    <strong>Khu B</strong>
                    <span>Ô tô nhỏ · 50 chỗ</span>
                </button>

                <button data-zone="C" onclick="changeZone('C')">
                    <strong>Khu C</strong>
                    <span>Ô tô lớn · 20 chỗ</span>
                </button>
            </div>

            <div class="parking-legend">
                <span><i class="legend available"></i> Trống</span>
                <span><i class="legend using"></i> Đang sử dụng</span>
                <span><i class="legend booked"></i> Đã đặt</span>
                <span><i class="legend maintenance"></i> Bảo trì</span>
                <span><i class="legend error"></i> Sự cố</span>
            </div>

            <div class="parking-lot">
                <div class="parking-road road-top"></div>
                <div id="slotGrid" class="parking-slot-grid zone-a"></div>
                <div class="parking-road road-bottom"></div>
            </div>

        </div>

        <div class="parking-detail-overlay" id="detailOverlay" aria-hidden="true">
        <aside class="parking-detail-panel" id="detailPanel" role="dialog" aria-modal="true" aria-labelledby="detailTitle">
            <button class="parking-close" type="button" onclick="closeSlotDetail()" aria-label="Đóng chi tiết">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="parking-detail-header">
                <div id="detailSlotIcon" class="detail-slot-icon using">A01</div>
                <div>
                    <h3 id="detailTitle">Chỗ đỗ A01</h3>
                    <span id="detailStatus" class="parking-status using">Đang sử dụng</span>
                </div>
            </div>

            <div class="parking-info-section">
                <h4>Thông tin chung</h4>

                <div class="parking-info-row">
                    <span>Khu vực</span>
                    <strong id="detailZone">Khu A</strong>
                </div>

                <div class="parking-info-row">
                    <span>Loại chỗ đỗ</span>
                    <strong id="detailVehicleType">Xe máy</strong>
                </div>

                <div class="parking-info-row">
                    <span>Vị trí</span>
                    <strong id="detailLocation">Khu A - Ô 01</strong>
                </div>

                <div class="parking-info-row">
                    <span>Cập nhật cuối</span>
                    <strong id="detailUpdated">10/05/2026 08:23</strong>
                </div>
            </div>

            <div class="parking-info-section" id="occupantSection" style="display:none;">
                <h4>Thông tin sử dụng</h4>

                <div class="parking-info-row">
                    <span>Biển số xe</span>
                    <strong id="detailPlate">-</strong>
                </div>

                <div class="parking-info-row">
                    <span>Thời gian vào</span>
                    <strong id="detailOccupiedSince">-</strong>
                </div>
            </div>

            <div class="parking-detail-actions">
                <button class="parking-btn-primary" id="btnUpdateStatus" onclick="updateSlotStatus()">
                    <i class="fa-solid fa-pen"></i>
                    Cập nhật trạng thái
                </button>

                <button class="parking-btn-outline" id="btnHistory" onclick="showSlotHistory()">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Lịch sử sử dụng
                </button>
            </div>

            <!-- Update Status Form (hidden by default) -->
            <div id="updateStatusForm" style="display:none; margin-top:12px;">
                <select id="newStatusSelect" class="parking-status-select">
                    <option value="Trống">Trống</option>
                    <option value="Bảo trì">Bảo trì</option>
                </select>
                <div style="display:flex; gap:8px; margin-top:8px;">
                    <button type="button" class="parking-btn-primary" id="btnConfirmSlotStatus" onclick="confirmUpdateStatus()" style="flex:1;">
                        <i class="fa-solid fa-check"></i> Xác nhận
                    </button>
                    <button type="button" class="parking-btn-outline" onclick="cancelUpdateStatus()" style="flex:1;">
                        Hủy
                    </button>
                </div>
            </div>

            <!-- History (hidden by default) -->
            <div id="slotHistorySection" style="display:none; margin-top:12px;">
                <h4 style="font-size:13px; color:#475569; margin-bottom:8px;">Lịch sử gần đây</h4>
                <div id="slotHistoryList" style="font-size:12px; color:#64748b;">
                    Đang tải...
                </div>
            </div>
        </aside>
        </div>

    </div>

</div>
